# ========== 大文件排除（视频/音频/压缩包） ==========
*.mp4
*.mov
*.avi
*.mkv
*.flv
*.wmv
*.webm
*.mp3
*.wav
*.ogg
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# ========== 图片排除（可选，图片变化频繁且体积大） ==========
# 保留.webp（体积小），排除大图片
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.tiff
*.svg
*.webp
# 例外：保留关键图片（如果需要）
# !assets/logo.png

# ========== 备份/临时文件 ==========
_backup/
backup/
*.bak
*.backup
*.tmp
*.temp
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ========== 冷库/归档（低质量作品，不需要版本控制） ==========
_archive_low_quality/
_archive/
archive/
_archive_bak/

# ========== 日志文件 ==========
*.log
logs/
log/

# ========== 缓存文件 ==========
.cache/
cache/
*.cache

# ========== 系统/配置文件（敏感信息不入库） ==========
.env
.env.*
*.pem
*.key
*.crt
*.p12
id_rsa
id_rsa.pub
authorized_keys

# ========== Node/Python（如果有） ==========
node_modules/
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ========== 其他 ==========
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# ========== 备份文件（不纳入版本控制） ==========
*.opt_backup
*.seo_backup
*.meta_backup
*.nav_fix_backup
*.metalaw
*.interlink
*.bak
*.backup
