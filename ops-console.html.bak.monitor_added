                document.getElementById('taskPending').textContent = stats.pending || 0;
                document.getElementById('taskRunning').textContent = stats.running || 0;
                document.getElementById('taskSuccess').textContent = stats.success || 0;
                document.getElementById('taskFailed').textContent = stats.failed || 0;
                document.getElementById('taskTotal').textContent = stats.total || 0;
                document.getElementById('taskActions').textContent = stats.schedule_actions || 0;
                const tasksRes = await fetch(API_BASE + '/api/scheduler/tasks');
                const tasksData = await tasksRes.json();
                const tasks = tasksData.tasks || [];
                const tbody = document.querySelector('#taskTable tbody');
                if (tasks.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;color:#8b95b0;">暂无任务</td></tr>';
