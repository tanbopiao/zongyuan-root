                    tbody.innerHTML = tasks.map(function(task) {
                        const statusText = {pending:'待处理',assigned:'已分配',running:'执行中',success:'已完成',failed:'失败'}[task.status] || task.status;
                        return '<tr><td style="font-family:monospace;font-size:11px;">' + task.task_id + '</td><td>' + task.task_type + '</td><td>' + (task.task_name || '-') + '</td><td><span class="tag ' + task.priority + '">' + task.priority + '</span></td><td><span class="tag ' + task.status + '">' + statusText + '</span></td><td style="font-size:11px;">' + (task.created_at ? task.created_at.substring(0,19) : '-') + '</td><td>-</td></tr>';
