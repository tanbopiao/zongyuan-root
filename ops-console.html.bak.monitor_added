                    resultDiv.innerHTML = `
                        <div class="card" style="margin:0;">
                            <div class="card-title">真值详情 <span class="badge">置信度: ${data.truth.confidence || 'N/A'}</span></div>
                            <p><strong>Key:</strong> <code>${data.truth.truth_key}</code></p>
                            <p style="margin-top:8px;"><strong>Value:</strong></p>
                            <pre style="background:#0a0e1a;padding:12px;border-radius:6px;margin-top:8px;overflow-x:auto;">${JSON.stringify(data.truth.truth_value, null, 2)}</pre>
                            <p style="margin-top:8px;"><strong>分类:</strong> ${data.truth.category || '-'}</p>
                            <p style="margin-top:4px;"><strong>哈希:</strong> <code>${data.truth.truth_hash || '-'}</code></p>
                        </div>
                    `;
                    addLog('info', `查询真值成功: ${key}`);
                } else {
                    resultDiv.innerHTML = `<p style="color:#f59e0b;">未找到真值: ${key}</p>`;
                    addLog('warn', `未找到真值: ${key}`);
                }
            } catch (e) {
                addLog('error', '查询失败: ' + e.message);
            }
        }

        async function submitTruth() {
            const key = document.getElementById('truthKey').value.trim();
            const value = document.getElementById('truthValue').value.trim();
            const category = document.getElementById('truthCategory').value;
            if (!key || !value) { addLog('warn', '请填写key和value'); return; }
            try {
                const res = await fetch(API_BASE + '/api/truth/upsert', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({key, value, category, node_id: 'ops-console'})
                });
                const data = await res.json();
                addLog('info', `真值上报成功: ${key}`);
                closeModal('truthModal');
            } catch (e) {
                addLog('error', '上报失败: ' + e.message);
            }
        }

        // 一键运维
        function runOp(op, name) {
            addLog('info', `执行操作: ${name} (${op})`);
            setTimeout(() => {
                addLog('info', `${name} 指令已下发到目标节点`);
                addLog('info', `等待节点执行并回传结果...`);
            }, 500);
        }

        // 部署管理
        async function refreshDeploys() {
            allDeploys = [];
            document.getElementById('deployTotal').textContent = '0';
            document.getElementById('deployPending').textContent = '0';
            document.getElementById('deployDone').textContent = '0';
            document.getElementById('deployRate').textContent = '--';
            document.querySelector('#deployTable tbody').innerHTML = '<tr><td colspan="6" style="text-align:center;color:#8b95b0;">暂无部署数据</td></tr>';
        }

        // 弹窗控制
        function showRegisterModal() { document.getElementById('registerModal').classList.add('active'); }
        function showTaskModal() { document.getElementById('taskModal').classList.add('active'); }
        function showTruthModal() { document.getElementById('truthModal').classList.add('active'); }
        function showDeployModal() { document.getElementById('deployModal').classList.add('active'); }
        function closeModal(id) { document.getElementById(id).classList.remove('active'); }

        async function registerNode() {
            const id = document.getElementById('newNodeId').value.trim();
            const name = document.getElementById('newNodeName').value.trim();
            const type = document.getElementById('newNodeType').value;
            if (!id || !name) { addLog('warn', '请填写节点ID和名称'); return; }
            addLog('info', `注册节点: ${id} (${name})`);
            closeModal('registerModal');
            refreshNodes();
        }

        async function submitTask() {
            const node = document.getElementById('taskTargetNode').value.trim();
            const type = document.getElementById('taskType').value;
            const desc = document.getElementById('taskDesc').value.trim();
            if (!node) { addLog('warn', '请填写目标节点'); return; }
            addLog('info', `任务已下发到节点 ${node}: ${type}`);
            closeModal('taskModal');
        }

        async function submitDeploy() {
            const name = document.getElementById('deployName').value.trim();
            const node = document.getElementById('deployNode').value.trim();
            const version = document.getElementById('deployVersion').value.trim();
            if (!name || !node) { addLog('warn', '请填写包名称和目标节点'); return; }
            addLog('info', `部署申请已提交: ${name} ${version} -> ${node}`);
            addLog('info', '等待审批通过后自动部署...');
            closeModal('deployModal');
        }

        // 全域概览仪表盘
        async function refreshOverview() {
            try {
                // 节点统计
                const nodeRes = await fetch(API_BASE + '/api/nodes');
                const nodeData = await nodeRes.json();
                const nodes = Object.values(nodeData.nodes || {});
                document.getElementById('ovNodes').textContent = nodes.length;
                const online = nodes.filter(n => n.online_status === 'online').length;
                document.getElementById('ovOnline').textContent = online;
                
                // 规则统计
                const ruleRes = await fetch(API_BASE + '/api/rules/list');
                const ruleData = await ruleRes.json();
                document.getElementById('ovRules').textContent = ruleData.count || 0;
                
                // 锚点统计
                const anchorRes = await fetch(API_BASE + '/api/anchors/list');
                const anchorData = await anchorRes.json();
                document.getElementById('ovAnchors').textContent = anchorData.count || 0;
                
                // 网关状态
                document.getElementById('ovGateway').textContent = '在线';
                
                // 写入队列统计
                try {
                    const queueRes = await fetch('/api/write-queue/api/write/stats');
                    const queueData = await queueRes.json();
                    document.getElementById('ovQueue').textContent = queueData.total_written || 0;
                } catch(e) {
                    document.getElementById('ovQueue').textContent = '--';
                }
                
                // 健康度计算
                const health = nodes.length > 0 ? Math.round((online / nodes.length) * 100) : 0;
                document.getElementById('ovHealth').textContent = health;
                
                // 节点状态分布图
                renderNodeStatusChart(nodes);
                
                // 规则优先级分布图
                renderRulePriorityChart(ruleData.rules || []);
                
                // 最近操作记录
                refreshRecentOps();
                
                addLog('info', '全域概览已刷新');
            } catch (e) {
                addLog('error', '刷新概览失败: ' + e.message);
            }
        }
        
        function renderNodeStatusChart(nodes) {
            const online = nodes.filter(n => n.online_status === 'online').length;
            const offline = nodes.length - online;
            const chart = document.getElementById('nodeStatusChart');
            chart.innerHTML = `
                <div style="text-align:center;">
                    <div style="font-size:48px;font-weight:700;color:#10b981;">${online}</div>
                    <div style="color:#8b95b0;margin-top:4px;">在线 / ${nodes.length} 总数</div>
                    <div style="margin-top:12px;display:flex;gap:16px;justify-content:center;">
                        <span style="color:#10b981;">● 在线 ${online}</span>
                        <span style="color:#ef4444;">● 离线 ${offline}</span>
                    </div>
                </div>
            `;
        }
        
        function renderRulePriorityChart(rules) {
            const critical = rules.filter(r => r.priority === 'critical').length;
            const high = rules.filter(r => r.priority === 'high').length;
            const medium = rules.filter(r => r.priority === 'medium').length;
            const low = rules.filter(r => r.priority === 'low' || !r.priority).length;
            const chart = document.getElementById('rulePriorityChart');
            chart.innerHTML = `
                <div style="width:100%;padding:0 20px;">
                    <div style="margin-bottom:8px;display:flex;justify-content:space-between;">
                        <span style="color:#ef4444;">Critical</span><span>${critical}</span>
                    </div>
                    <div style="height:8px;background:#1a1f35;border-radius:4px;margin-bottom:12px;">
                        <div style="height:100%;width:${rules.length?critical/rules.length*100:0}%;background:#ef4444;border-radius:4px;"></div>
                    </div>
                    <div style="margin-bottom:8px;display:flex;justify-content:space-between;">
                        <span style="color:#f59e0b;">High</span><span>${high}</span>
                    </div>
                    <div style="height:8px;background:#1a1f35;border-radius:4px;margin-bottom:12px;">
                        <div style="height:100%;width:${rules.length?high/rules.length*100:0}%;background:#f59e0b;border-radius:4px;"></div>
                    </div>
                    <div style="margin-bottom:8px;display:flex;justify-content:space-between;">
                        <span style="color:#00d4ff;">Medium</span><span>${medium}</span>
                    </div>
                    <div style="height:8px;background:#1a1f35;border-radius:4px;margin-bottom:12px;">
                        <div style="height:100%;width:${rules.length?medium/rules.length*100:0}%;background:#00d4ff;border-radius:4px;"></div>
                    </div>
                    <div style="margin-bottom:8px;display:flex;justify-content:space-between;">
                        <span style="color:#8b95b0;">Low</span><span>${low}</span>
                    </div>
                    <div style="height:8px;background:#1a1f35;border-radius:4px;">
                        <div style="height:100%;width:${rules.length?low/rules.length*100:0}%;background:#8b95b0;border-radius:4px;"></div>
                    </div>
                </div>
            `;
        }
        
        async function refreshRecentOps() {
            try {
                const res = await fetch(API_BASE + '/api/operation-log/recent');
                const data = await res.json();
                const ops = data.data || [];
                const tbody = document.querySelector('#recentOpsTable tbody');
                if (ops.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;color:#8b95b0;">暂无操作记录</td></tr>';
                } else {
                    tbody.innerHTML = ops.slice(0, 10).map(op => `
                        <tr>
                            <td>${op.timestamp ? new Date(op.timestamp).toLocaleString('zh-CN') : '-'}</td>
                            <td>${op.operation_type || '-'}</td>
                            <td>${op.target_file || '-'}</td>
                            <td>${op.operator || '-'}</td>
                            <td><span class="tag online">成功</span></td>
                        </tr>
                    `).join('');
                }
            } catch (e) {
                document.querySelector('#recentOpsTable tbody').innerHTML = '<tr><td colspan="5" style="text-align:center;color:#8b95b0;">加载失败</td></tr>';
            }
        }

        // 初始化
        window.onload = function() {
            refreshOverview();
            addLog('info', '元运维总控台初始化完成');
            addLog('info', '9120记忆网关连接正常');
        };
        
        // 每30秒自动刷新概览
        setInterval(() => {
            if (document.getElementById('module-overview').classList.contains('active')) {
                refreshOverview();
            }
        }, 30000);
    
        // ========== 同步状态看板 ==========
        async function loadSyncStatus() {
            const module = document.getElementById('sync-content');
            if (!module) return;
            
            module.innerHTML = '<div style="text-align:center;padding:40px;color:#8899bb;">加载中...</div>';
            
            try {
                const res = await fetch('/api/memory-gateway/api/sync-status/overview');
                const data = await res.json();
                
                const statusColor = data.service_status === 'active' ? '#4ade80' : '#f87171';
                const resultColor = data.last_run_result === 'success' ? '#4ade80' : '#f87171';
                
                module.innerHTML = `
                    <div class="module-header">
                        <h2>🔄 自动记忆固化与双向同步状态</h2>
                        <p style="color:#8899bb;font-size:13px;">实时监控9120真值库 ↔ MR-019长期记忆库的自动同步状态</p>
                    </div>
                    
                    <div class="stats-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;margin-bottom:24px;">
                        <div class="stat-card" style="background:linear-gradient(135deg,#1e2540,#252d4a);border-radius:12px;padding:20px;border:1px solid #2a3355;">
                            <div style="color:#8899bb;font-size:12px;margin-bottom:8px;">服务状态</div>
                            <div style="font-size:24px;font-weight:bold;color:${statusColor};">${data.service_status === 'active' ? '✅ 运行中' : '❌ 已停止'}</div>
                            <div style="color:#667799;font-size:11px;margin-top:4px;">auto-memory-consolidator</div>
                        </div>
                        
                        <div class="stat-card" style="background:linear-gradient(135deg,#1e2540,#252d4a);border-radius:12px;padding:20px;border:1px solid #2a3355;">
                            <div style="color:#8899bb;font-size:12px;margin-bottom:8px;">动态重要性阈值</div>
                            <div style="font-size:24px;font-weight:bold;color:#60a5fa;">${(data.current_threshold * 100).toFixed(0)}%</div>
                            <div style="color:#667799;font-size:11px;margin-top:4px;">基于增长速度自动调整</div>
                        </div>
                        
                        <div class="stat-card" style="background:linear-gradient(135deg,#1e2540,#252d4a);border-radius:12px;padding:20px;border:1px solid #2a3355;">
                            <div style="color:#8899bb;font-size:12px;margin-bottom:8px;">MR-019记忆总数</div>
                            <div style="font-size:24px;font-weight:bold;color:#c084fc;">${data.mr019_total_memories}</div>
                            <div style="color:#667799;font-size:11px;margin-top:4px;">长期记忆库</div>
                        </div>
                        
                        <div class="stat-card" style="background:linear-gradient(135deg,#1e2540,#252d4a);border-radius:12px;padding:20px;border:1px solid #2a3355;">
                            <div style="color:#8899bb;font-size:12px;margin-bottom:8px;">总运行次数</div>
                            <div style="font-size:24px;font-weight:bold;color:#fbbf24;">${data.total_runs}</div>
                            <div style="color:#667799;font-size:11px;margin-top:4px;">每60秒自动执行</div>
                        </div>
                    </div>
                    
                    <div style="background:linear-gradient(135deg,#1e2540,#252d4a);border-radius:12px;padding:24px;border:1px solid #2a3355;margin-bottom:24px;">
                        <h3 style="color:#e0e8ff;margin-bottom:16px;font-size:16px;">📊 累计同步统计</h3>
                        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:16px;">
                            <div style="text-align:center;padding:16px;background:rgba(74,222,128,0.1);border-radius:8px;">
                                <div style="font-size:28px;font-weight:bold;color:#4ade80;">${data.total_consolidated}</div>
                                <div style="color:#8899bb;font-size:12px;margin-top:4px;">操作日志固化</div>
                                <div style="color:#667799;font-size:10px;">9120 → MR-019</div>
                            </div>
                            <div style="text-align:center;padding:16px;background:rgba(96,165,250,0.1);border-radius:8px;">
                                <div style="font-size:28px;font-weight:bold;color:#60a5fa;">${data.total_synced_g2m}</div>
                                <div style="color:#8899bb;font-size:12px;margin-top:4px;">真值同步</div>
                                <div style="color:#667799;font-size:10px;">9120 → MR-019</div>
                            </div>
                            <div style="text-align:center;padding:16px;background:rgba(192,132,252,0.1);border-radius:8px;">
                                <div style="font-size:28px;font-weight:bold;color:#c084fc;">${data.total_synced_m2g}</div>
                                <div style="color:#8899bb;font-size:12px;margin-top:4px;">记忆同步</div>
                                <div style="color:#667799;font-size:10px;">MR-019 → 9120</div>
                            </div>
                            <div style="text-align:center;padding:16px;background:rgba(248,113,113,0.1);border-radius:8px;">
                                <div style="font-size:28px;font-weight:bold;color:${data.total_failures > 0 ? '#f87171' : '#4ade80'};">${data.total_failures}</div>
                                <div style="color:#8899bb;font-size:12px;margin-top:4px;">失败次数</div>
                                <div style="color:#667799;font-size:10px;">连续失败: ${data.consecutive_failures}</div>
                            </div>
                            <div style="text-align:center;padding:16px;background:rgba(251,191,36,0.1);border-radius:8px;">
                                <div style="font-size:28px;font-weight:bold;color:${data.total_alerts > 0 ? '#fbbf24' : '#4ade80'};">${data.total_alerts}</div>
                                <div style="color:#8899bb;font-size:12px;margin-top:4px;">告警次数</div>
                                <div style="color:#667799;font-size:10px;">连续失败≥3次触发</div>
                            </div>
                        </div>
                    </div>
                    
                    <div style="background:linear-gradient(135deg,#1e2540,#252d4a);border-radius:12px;padding:24px;border:1px solid #2a3355;">
                        <h3 style="color:#e0e8ff;margin-bottom:16px;font-size:16px;">🕐 最近运行信息</h3>
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                            <div>
                                <div style="color:#8899bb;font-size:12px;margin-bottom:4px;">最近运行时间</div>
                                <div style="color:#e0e8ff;font-size:14px;">${data.last_run_time || '暂无记录'}</div>
                            </div>
                            <div>
                                <div style="color:#8899bb;font-size:12px;margin-bottom:4px;">最近运行结果</div>
                                <div style="font-size:14px;font-weight:bold;color:${resultColor};">${data.last_run_result === 'success' ? '✅ 成功' : '❌ 失败'}</div>
                            </div>
                        </div>
                        <div style="margin-top:16px;padding-top:16px;border-top:1px solid #2a3355;">
                            <button onclick="loadSyncStatus()" style="background:linear-gradient(135deg,#3b82f6,#2563eb);color:white;border:none;padding:10px 24px;border-radius:8px;cursor:pointer;font-size:14px;">🔄 刷新状态</button>
                        </div>
                    </div>
                `;
            } catch (e) {
                module.innerHTML = '<div style="text-align:center;padding:40px;color:#f87171;">加载失败: ' + e.message + '</div>';
            }
        }

    </script>
</body>
