<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>火斗云智AIOS - 元运维总控台</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
            background: #0a0e1a;
            color: #e0e6f0;
            min-height: 100vh;
        }
        .header {
            background: linear-gradient(135deg, #1a1f35 0%, #0d1225 100%);
            border-bottom: 1px solid #2a3050;
            padding: 16px 32px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .header h1 {
            font-size: 22px;
            font-weight: 600;
            background: linear-gradient(90deg, #00d4ff, #7c3aed);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .header .status {
            display: flex;
            gap: 24px;
            font-size: 13px;
        }
        .status-item { display: flex; align-items: center; gap: 8px; }
        .status-dot {
            width: 8px; height: 8px;
            border-radius: 50%;
            background: #10b981;
            box-shadow: 0 0 8px #10b981;
            animation: pulse 2s infinite;
        }
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }
        .nav {
            background: #11162a;
            border-bottom: 1px solid #2a3050;
            padding: 0 32px;
            display: flex;
            gap: 4px;
        }
        .nav-item {
            padding: 14px 20px;
            cursor: pointer;
            font-size: 14px;
            color: #8b95b0;
            border-bottom: 2px solid transparent;
            transition: all 0.2s;
        }
        .nav-item:hover { color: #c0c8e0; background: #1a1f35; }
        .nav-item.active {
            color: #00d4ff;
            border-bottom-color: #00d4ff;
            background: #1a1f35;
        }
        .main { padding: 24px 32px; }
        .module { display: none; }
        .module.active { display: block; }
        .card {
            background: #11162a;
            border: 1px solid #2a3050;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 20px;
        }
        .card-title {
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 16px;
            color: #e0e6f0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .card-title .badge {
            font-size: 11px;
            padding: 3px 10px;
            border-radius: 10px;
            background: #1e3a5f;
            color: #00d4ff;
        }
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 16px;
            margin-bottom: 20px;
        }
        .stat-card {
            background: linear-gradient(135deg, #1a1f35 0%, #11162a 100%);
            border: 1px solid #2a3050;
            border-radius: 10px;
            padding: 16px;
        }
        .stat-label { font-size: 12px; color: #8b95b0; margin-bottom: 8px; }
        .stat-value { font-size: 28px; font-weight: 700; color: #00d4ff; }
        .stat-value.green { color: #10b981; }
        .stat-value.orange { color: #f59e0b; }
        .stat-value.red { color: #ef4444; }
        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }
        th {
            text-align: left;
            padding: 12px;
            background: #1a1f35;
            color: #8b95b0;
            font-weight: 500;
            border-bottom: 1px solid #2a3050;
        }
        td {
            padding: 12px;
            border-bottom: 1px solid #1e2540;
            color: #c0c8e0;
        }
        tr:hover { background: #1a1f35; }
        .tag {
            display: inline-block;
            padding: 2px 8px;
            border-radius: 4px;
            font-size: 11px;
            font-weight: 500;
        }
        .tag.online { background: #0d3b2e; color: #10b981; }
        .tag.offline { background: #3b1a1a; color: #ef4444; }
        .tag.critical { background: #3b1a1a; color: #ef4444; }
        .tag.high { background: #3b2a0d; color: #f59e0b; }
        .tag.medium { background: #1e3a5f; color: #00d4ff; }
        .tag.low { background: #2a3050; color: #8b95b0; }
        .btn {
            padding: 8px 16px;
            border: none;
            border-radius: 6px;
            font-size: 13px;
            cursor: pointer;
            transition: all 0.2s;
            font-weight: 500;
        }
        .btn-primary {
            background: linear-gradient(135deg, #00d4ff, #0099cc);
            color: #0a0e1a;
        }
        .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(0,212,255,0.3); }
        .btn-secondary {
            background: #2a3050;
            color: #c0c8e0;
        }
        .btn-secondary:hover { background: #3a4070; }
        .btn-danger { background: #3b1a1a; color: #ef4444; }
        .btn-danger:hover { background: #4b2a2a; }
        .btn-sm { padding: 4px 10px; font-size: 12px; }
        .action-bar {
            display: flex;
            gap: 12px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }
        .search-box {
            flex: 1;
            min-width: 200px;
            padding: 8px 14px;
            background: #1a1f35;
            border: 1px solid #2a3050;
            border-radius: 6px;
            color: #e0e6f0;
            font-size: 13px;
        }
        .search-box:focus { outline: none; border-color: #00d4ff; }
        .log-box {
            background: #0a0e1a;
            border: 1px solid #2a3050;
            border-radius: 8px;
            padding: 16px;
            font-family: 'Consolas', 'Monaco', monospace;
            font-size: 12px;
            height: 300px;
            overflow-y: auto;
            color: #10b981;
        }
        .log-line { margin-bottom: 4px; }
        .log-time { color: #8b95b0; }
        .log-info { color: #00d4ff; }
        .log-warn { color: #f59e0b; }
        .log-error { color: #ef4444; }
        .footer {
            text-align: center;
            padding: 20px;
            color: #5a6580;
            font-size: 12px;
            border-top: 1px solid #2a3050;
            margin-top: 40px;
        }
        .modal {
            display: none;
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0,0,0,0.7);
            z-index: 1000;
            justify-content: center;
            align-items: center;
        }
        .modal.active { display: flex; }
        .modal-content {
            background: #11162a;
            border: 1px solid #2a3050;
            border-radius: 12px;
            padding: 24px;
            width: 90%;
            max-width: 500px;
        }
        .modal-title { font-size: 18px; font-weight: 600; margin-bottom: 16px; }
        .form-group { margin-bottom: 16px; }
        .form-group label { display: block; font-size: 13px; color: #8b95b0; margin-bottom: 6px; }
        .form-group input, .form-group select, .form-group textarea {
            width: 100%;
            padding: 8px 12px;
            background: #1a1f35;
            border: 1px solid #2a3050;
            border-radius: 6px;
            color: #e0e6f0;
            font-size: 13px;
        }
        .form-group textarea { min-height: 80px; resize: vertical; }
        .modal-actions { display: flex; gap: 12px; justify-content: flex-end; margin-top: 20px; }
    </style>
</head>
<body>
    <div class="header">
        <h1>⚡ 火斗云智AIOS · 元运维总控台</h1>
        <div class="status">
            <div class="status-item"><div class="status-dot"></div><span>9120网关在线</span></div>
            <div class="status-item"><span id="currentTime">--:--:--</span></div>
        </div>
    </div>

    <div class="nav">
        <div class="nav-item active" onclick="switchModule('overview')">📊 全域概览</div>
        <div class="nav-item" onclick="switchModule('nodes')">🖥️ 节点管理</div>
        <div class="nav-item" onclick="switchModule('tasks')">📋 任务调度</div>
        <div class="nav-item" onclick="switchModule('rules')">📜 规则管理</div>
        <div class="nav-item" onclick="switchModule('truth')">💎 真值管理</div>
        <div class="nav-item" onclick="switchModule('ops')">🔧 一键运维</div>
        <div class="nav-item" onclick="switchModule('deploy')">🚀 部署流水线</div>
        <div class="nav-item" onclick="switchModule('sync')">🔄 同步状态</div>
        <div class="nav-item" onclick="switchModule('intelligence')">🧠 高阶智能态</div>

    </div>

    <div class="main">
        <!-- 全域概览仪表盘 -->
        <div id="module-overview" class="module active">
            <div class="stats-grid">
                <div class="stat-card"><div class="stat-label">同源节点总数</div><div class="stat-value" id="ovNodes">--</div></div>
                <div class="stat-card"><div class="stat-label">在线节点</div><div class="stat-value green" id="ovOnline">--</div></div>
                <div class="stat-card"><div class="stat-label">元规则总数</div><div class="stat-value" id="ovRules">--</div></div>
                <div class="stat-card"><div class="stat-label">记忆锚点</div><div class="stat-value orange" id="ovAnchors">--</div></div>
            </div>
            <div class="stats-grid">
                <div class="stat-card"><div class="stat-label">9120网关状态</div><div class="stat-value green" id="ovGateway">--</div></div>
                <div class="stat-card"><div class="stat-label">写入队列</div><div class="stat-value" id="ovQueue">--</div></div>
                <div class="stat-card"><div class="stat-label">今日操作</div><div class="stat-value orange" id="ovOps">--</div></div>
                <div class="stat-card"><div class="stat-label">系统健康度</div><div class="stat-value green" id="ovHealth">--%</div></div>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                <div class="card">
                    <div class="card-title">节点状态分布 <span class="badge">实时</span></div>
                    <div id="nodeStatusChart" style="height: 200px; display: flex; align-items: center; justify-content: center; color: #8b95b0;">加载中...</div>
                </div>
                <div class="card">
                    <div class="card-title">规则优先级分布 <span class="badge">9120权威源</span></div>
                    <div id="rulePriorityChart" style="height: 200px; display: flex; align-items: center; justify-content: center; color: #8b95b0;">加载中...</div>
                </div>
            </div>
            <div class="card">
                <div class="card-title">最近操作记录 <span class="badge">操作日志</span></div>
                <table id="recentOpsTable">
                    <thead><tr><th>时间</th><th>操作类型</th><th>目标</th><th>操作人</th><th>状态</th></tr></thead>
                    <tbody><tr><td colspan="5" style="text-align:center;color:#8b95b0;">加载中...</td></tr></tbody>
                </table>
            </div>
            <div class="card">
                <div class="card-title">快捷操作 <span class="badge">一键执行</span></div>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px;">
                    <button class="btn btn-primary" onclick="runOp('health_check', '全节点健康检查')">🏥 健康检查</button>
                    <button class="btn btn-primary" onclick="runOp('sync_rules', '同步最新规则')">📜 同步规则</button>
                    <button class="btn btn-primary" onclick="runOp('pull_truth', '拉取云端真值')">💎 拉取真值</button>
                    <button class="btn btn-secondary" onclick="runOp('clean_logs', '清理过期日志')">🧹 清理日志</button>
                    <button class="btn btn-secondary" onclick="refreshOverview()">🔄 刷新概览</button>
                    <button class="btn btn-secondary" onclick="switchModule('nodes')">🖥️ 节点管理</button>
                </div>
            </div>
        </div>

        <!-- 节点管理模块 -->
        <div id="module-nodes" class="module">
            <div class="stats-grid">
                <div class="stat-card"><div class="stat-label">注册节点总数</div><div class="stat-value" id="nodeTotal">--</div></div>
                <div class="stat-card"><div class="stat-label">在线节点</div><div class="stat-value green" id="nodeOnline">--</div></div>
                <div class="stat-card"><div class="stat-label">离线节点</div><div class="stat-value red" id="nodeOffline">--</div></div>
                <div class="stat-card"><div class="stat-label">今日心跳次数</div><div class="stat-value orange" id="nodeHeartbeats">--</div></div>
            </div>
            <div class="card">
                <div class="card-title">同源节点列表 <span class="badge">实时同步</span></div>
                <div class="action-bar">
                    <input type="text" class="search-box" placeholder="搜索节点ID/名称..." oninput="filterNodes(this.value)">
                    <button class="btn btn-primary" onclick="refreshNodes()">🔄 刷新节点</button>
                    <button class="btn btn-secondary" onclick="showRegisterModal()">➕ 注册新节点</button>
                </div>
                <table id="nodesTable">
                    <thead><tr><th>节点ID</th><th>节点名称</th><th>类型</th><th>状态</th><th>最后心跳</th><th>操作</th></tr></thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>

        <!-- 任务调度模块 -->
        <div id="module-tasks" class="module">
            <div class="stats-grid">
                <div class="stat-card"><div class="stat-label">待处理任务</div><div class="stat-value orange" id="taskPending">--</div></div>
                <div class="stat-card"><div class="stat-label">执行中任务</div><div class="stat-value" id="taskRunning">--</div></div>
                <div class="stat-card"><div class="stat-label">已完成任务</div><div class="stat-value green" id="taskDone">--</div></div>
                <div class="stat-card"><div class="stat-label">失败任务</div><div class="stat-value red" id="taskFailed">--</div></div>
            </div>
            <div class="card">
                <div class="card-title">任务队列 <span class="badge">分布式调度</span></div>
                <div class="action-bar">
                    <button class="btn btn-primary" onclick="showTaskModal()">➕ 下发新任务</button>
                    <button class="btn btn-secondary" onclick="refreshTasks()">🔄 刷新任务</button>
                </div>
                <table id="tasksTable">
                    <thead><tr><th>任务ID</th><th>目标节点</th><th>任务类型</th><th>状态</th><th>创建时间</th><th>操作</th></tr></thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>

        <!-- 规则管理模块 -->
        <div id="module-rules" class="module">
            <div class="stats-grid">
                <div class="stat-card"><div class="stat-label">元规则总数</div><div class="stat-value" id="ruleTotal">--</div></div>
                <div class="stat-card"><div class="stat-label">Critical级</div><div class="stat-value red" id="ruleCritical">--</div></div>
                <div class="stat-card"><div class="stat-label">High级</div><div class="stat-value orange" id="ruleHigh">--</div></div>
                <div class="stat-card"><div class="stat-label">记忆锚点</div><div class="stat-value green" id="anchorTotal">--</div></div>
            </div>
            <div class="card">
                <div class="card-title">元规则列表 <span class="badge">9120权威源</span></div>
                <div class="action-bar">
                    <input type="text" class="search-box" placeholder="搜索规则ID/名称..." oninput="filterRules(this.value)">
                    <button class="btn btn-primary" onclick="syncRules()">🔄 同步最新规则</button>
                    <button class="btn btn-secondary" onclick="refreshRules()">📋 刷新列表</button>
                </div>
                <table id="rulesTable">
                    <thead><tr><th>规则ID</th><th>规则名称</th><th>版本</th><th>优先级</th><th>状态</th><th>操作</th></tr></thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>

        <!-- 真值管理模块 -->
        <div id="module-truth" class="module">
            <div class="stats-grid">
                <div class="stat-card"><div class="stat-label">真值总数</div><div class="stat-value" id="truthTotal">--</div></div>
                <div class="stat-card"><div class="stat-label">今日新增</div><div class="stat-value green" id="truthToday">--</div></div>
                <div class="stat-card"><div class="stat-label">高置信度</div><div class="stat-value orange" id="truthHighConf">--</div></div>
                <div class="stat-card"><div class="stat-label">待验证</div><div class="stat-value red" id="truthPending">--</div></div>
            </div>
            <div class="card">
                <div class="card-title">真值库 <span class="badge">真值优先</span></div>
                <div class="action-bar">
                    <input type="text" class="search-box" placeholder="搜索真值key..." id="truthSearchKey">
                    <button class="btn btn-primary" onclick="searchTruth()">🔍 查询真值</button>
                    <button class="btn btn-secondary" onclick="showTruthModal()">➕ 上报真值</button>
                </div>
                <div id="truthResult" style="margin-top: 16px;"></div>
            </div>
        </div>

        <!-- 一键运维模块 -->
        <div id="module-ops" class="module">
            <div class="card">
                <div class="card-title">一键运维操作 <span class="badge">安全可控</span></div>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px;">
                    <button class="btn btn-primary" style="padding: 20px; font-size: 14px;" onclick="runOp('health_check', '全节点健康检查')">🏥 全节点健康检查</button>
                    <button class="btn btn-primary" style="padding: 20px; font-size: 14px;" onclick="runOp('sync_rules', '同步最新规则')">📜 同步最新规则</button>
                    <button class="btn btn-primary" style="padding: 20px; font-size: 14px;" onclick="runOp('pull_truth', '拉取云端真值')">💎 拉取云端真值</button>
                    <button class="btn btn-secondary" style="padding: 20px; font-size: 14px;" onclick="runOp('clean_logs', '清理过期日志')">🧹 清理过期日志</button>
                    <button class="btn btn-secondary" style="padding: 20px; font-size: 14px;" onclick="runOp('restart_gateway', '重启9120网关')">🔄 重启9120网关</button>
                    <button class="btn btn-danger" style="padding: 20px; font-size: 14px;" onclick="runOp('full_backup', '全量备份')">💾 全量备份</button>
                </div>
            </div>
            <div class="card">
                <div class="card-title">操作日志 <span class="badge">实时输出</span></div>
                <div class="log-box" id="opsLog">
                    <div class="log-line"><span class="log-time">[系统]</span> <span class="log-info">元运维总控台已就绪，等待操作指令...</span></div>
                </div>
            </div>
        </div>

        <!-- 部署流水线模块 -->
        <div id="module-deploy" class="module">
            <div class="stats-grid">
                <div class="stat-card"><div class="stat-label">部署任务总数</div><div class="stat-value" id="deployTotal">--</div></div>
                <div class="stat-card"><div class="stat-label">待审批</div><div class="stat-value orange" id="deployPending">--</div></div>
                <div class="stat-card"><div class="stat-label">已部署</div><div class="stat-value green" id="deployDone">--</div></div>
                <div class="stat-card"><div class="stat-label">部署成功率</div><div class="stat-value" id="deployRate">--%</div></div>
            </div>
            <div class="card">
                <div class="card-title">部署流水线 <span class="badge">审批→部署→验证</span></div>
                <div class="action-bar">
                    <button class="btn btn-primary" onclick="showDeployModal()">➕ 提交部署申请</button>
                    <button class="btn btn-secondary" onclick="refreshDeploys()">🔄 刷新部署</button>
                </div>
                <table id="deployTable">
                    <thead><tr><th>部署ID</th><th>包名称</th><th>目标节点</th><th>版本</th><th>状态</th><th>操作</th></tr></thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="footer">
        火斗云智AIOS · 元运维总控台 V1.0 | Ω₀⊂⊙∞⊂Ω | DID-BR-000002 | 锚定元极恒一
    </div>

    <!-- 注册节点弹窗 -->
    <div class="modal" id="registerModal">
        <div class="modal-content">
            <div class="modal-title">注册新节点</div>
            <div class="form-group"><label>节点ID</label><input type="text" id="newNodeId" placeholder="NODE-XXX-001"></div>
            <div class="form-group"><label>节点名称</label><input type="text" id="newNodeName" placeholder="我的开发终端"></div>
            <div class="form-group"><label>节点类型</label>
                <select id="newNodeType">
                    <option value="development">开发节点</option>
                    <option value="production">生产节点</option>
                    <option value="research">研究节点</option>
                    <option value="meta_order_engine">元秩序引擎</option>
                </select>
            </div>
            <div class="modal-actions">
                <button class="btn btn-secondary" onclick="closeModal('registerModal')">取消</button>
                <button class="btn btn-primary" onclick="registerNode()">注册</button>
            </div>
        </div>
    </div>

    <!-- 下发任务弹窗 -->
    <div class="modal" id="taskModal">
        <div class="modal-content">
            <div class="modal-title">下发新任务</div>
            <div class="form-group"><label>目标节点</label><input type="text" id="taskTargetNode" placeholder="节点ID"></div>
            <div class="form-group"><label>任务类型</label>
                <select id="taskType">
                    <option value="deploy">部署任务</option>
                    <option value="backup">备份任务</option>
                    <option value="cleanup">清理任务</option>
                    <option value="sync">同步任务</option>
                    <option value="custom">自定义任务</option>
                </select>
            </div>
            <div class="form-group"><label>任务描述</label><textarea id="taskDesc" placeholder="详细描述任务内容..."></textarea></div>
            <div class="modal-actions">
