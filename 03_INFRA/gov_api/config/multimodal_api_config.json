{
  "version": "1.0",
  "default_provider": "baidu",
  "providers": {
    "baidu": {
      "name": "百度智能云",
      "enabled": true,
      "api_key": "YOUR_BAIDU_API_KEY",
      "secret_key": "YOUR_BAIDU_SECRET_KEY",
      "ocr_endpoint": "https://aip.baidubce.com/rest/2.0/ocr/v1/general_basic",
      "tts_endpoint": "https://tsn.baidu.com/text2audio",
      "token_endpoint": "https://aip.baidubce.com/oauth/2.0/token",
      "free_quota": {
        "ocr": "1000次/天",
        "tts": "200次/天"
      }
    },
    "tencent": {
      "name": "腾讯云",
      "enabled": false,
      "secret_id": "YOUR_TENCENT_SECRET_ID",
      "secret_key": "YOUR_TENCENT_SECRET_KEY",
      "ocr_endpoint": "https://ocr.tencentcloudapi.com",
      "tts_endpoint": "https://tts.tencentcloudapi.com",
      "free_quota": {
        "ocr": "1000次/月",
        "tts": "100万字符/月"
      }
    },
    "aliyun": {
      "name": "阿里云",
      "enabled": false,
      "app_key": "YOUR_ALIYUN_APP_KEY",
      "access_token": "YOUR_ALIYUN_TOKEN",
      "ocr_endpoint": "https://ocrapi-document.taobao.com/ocrservice/document",
      "tts_endpoint": "https://nls-gateway.cn-shanghai.aliyuncs.com/stream/v1/tts",
      "free_quota": {
        "ocr": "500次/天",
        "tts": "100万字符/月"
      }
    }
  },
  "fallback": {
    "ocr": "return_placeholder",
    "tts": "return_text_info",
    "image_understand": "return_metadata"
  },
  "rate_limit": {
    "ocr": "10次/秒",
    "tts": "5次/秒"
  }
}
