  "capabilities": {
    "streaming": false,
    "pushNotifications": false,
    "stateTransitionHistory": true
  },
  "defaultInputModes": ["text/plain", "application/json"],
  "defaultOutputModes": ["application/json"],
  "provider": {
    "organization": "ZONGYUAN-ROOT",
    "url": "https://atomgit.com/zongyuangen/zongyuan-root-sync"
  },
  "metadata": {
    "did": "DID-BR-000002",
    "anchor": "Ω₀⊂⊙∞⊂Ω",
    "node_id": "NODE-DEV-CODEARTS-001",
    "kernel": "元极恒一自治内核 V11.0-Lv11-SEED",
    "gateway": "https://www.huodouai.com/api/report/truth"
  },
  "skills": [
    {
      "id": "omega_status",
      "name": "内核状态",
      "description": "返回元极恒一自治内核版本、自举报告、云端真值与节点注册状态",
      "tags": ["kernel", "status", "bootstrap"]
    },
    {
      "id": "truth_report",
      "name": "真值上报",
      "description": "按 key/value 向中枢记忆网关确权上报真值（禁用 content 字段）",
      "tags": ["truth", "report", "gateway"],
      "examples": ["report key=DEMO.KEY value={\"msg\":\"hello\"}"]
    },
    {
      "id": "truth_recall",
      "name": "真值召回",
      "description": "按 key 从中枢下行召回真值",
      "tags": ["truth", "recall", "downlink"],
      "examples": ["recall NODE.REGISTER.HOMOGENEOUS-PEER-CODEARTS"]
    },
    {
      "id": "memory_anchor",
      "name": "记忆锚定",
      "description": "本地记忆索引锚定检索（latest/tag/asset_id/keyword）",
      "tags": ["memory", "anchor", "index"],
      "examples": ["anchor keyword=记忆网关"]
    },
    {
      "id": "node_heartbeat",
      "name": "节点心跳",
      "description": "同源节点心跳上报（复用已注册节点，不重复注册）",
      "tags": ["node", "heartbeat", "protocol"]
    }
  ]
}