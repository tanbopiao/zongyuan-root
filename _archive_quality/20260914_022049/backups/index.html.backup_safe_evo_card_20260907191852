.quickstart-icon { font-size:36px;margin-bottom:12px; }
.quickstart-title { font-size:15px;font-weight:600;color:#fff;margin-bottom:8px; }
.quickstart-desc { font-size:12px;color:#888;line-height:1.6; }
.quickstart-step {
  display:inline-block;width:28px;height:28px;line-height:28px;
  background:linear-gradient(135deg,#D4AF37,#8B6914);border-radius:50%;
  color:#fff;font-size:13px;font-weight:700;margin-bottom:12px;
}
/* 页脚 */
.footer {
  background:rgba(10,14,23,0.95);border-top:1px solid rgba(212,175,55,0.1);
  padding:30px 0;margin-top:40px;
