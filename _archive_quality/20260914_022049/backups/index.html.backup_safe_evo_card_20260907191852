  padding:40px 0;border-top:1px solid rgba(212,175,55,0.1);
}
.quickstart-grid {
  display:grid;grid-template-columns:repeat(3,1fr);gap:16px;
}
.quickstart-card {
  background:rgba(30,35,50,0.6);border:1px solid rgba(212,175,55,0.1);
  border-radius:10px;padding:24px;text-align:center;
