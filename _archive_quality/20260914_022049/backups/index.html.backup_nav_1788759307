      btn.style.color = '#9ca3af';
      btn.style.borderColor = 'rgba(255,255,255,0.1)';
    }
  });
}

// 公式交互解释
function toggleFormula(formulaId) {
  const detail = document.getElementById('formula-detail-' + formulaId);
  const btn = document.getElementById('formula-btn-' + formulaId);
  if (detail.style.display === 'none') {
    detail.style.display = 'block';
    btn.textContent = '收起解释 ▲';
  } else {
    detail.style.display = 'none';
    btn.textContent = '点击展开解释 ▼';
  }
}
</script>


<script>
// 滚动时高亮子导航当前位置
function updateSubnavHighlight() {
  const sections = ['three-layers', 'closed-loop', 'five-architecture', 'engineering-cases', 'version-history-content', 'knowledge-network'];
  const scrollPos = window.scrollY + 150;
  
  let currentSection = '';
  for (const id of sections) {
    const element = document.getElementById(id);
    if (element && element.offsetTop <= scrollPos) {
      currentSection = id;
    }
  }
  
  const subnav = document.getElementById('zongyuan-subnav');
  if (subnav) {
    const links = subnav.querySelectorAll('a');
    links.forEach(link => {
      const onclick = link.getAttribute('onclick') || '';
      if (currentSection && onclick.includes(currentSection.replace('-content', ''))) {
        link.style.background = 'rgba(212,175,55,0.15)';
        link.style.color = '#F4E4BC';
      } else {
        link.style.background = 'transparent';
        link.style.color = '#9ca3af';
      }
    });
  }
}

window.addEventListener('scroll', updateSubnavHighlight);
</script>


<script>
// 关键术语解释弹窗
const termExplanations = {
  '元秩序': '宇宙先天存在的本源秩序场，是一切智能的逻辑根基，包含因果收敛公理、认知熵减演化公理等不可变法则。',
  '黎曼超流形': '高维弯曲空间的数学抽象，用于描述语义潜空间的几何结构，概念之间的距离由流形度量张量定义。',
  '驻波谐振': '语义潜空间中概念波动的稳定共振状态，当系统达到稳态时，语义波动形成驻波，对应真值的稳定表达。',
  'Merkle-DAG': '有向无环图结构的默克尔树账本，每个节点包含子节点的哈希值，用于全域存证与溯源，任何篡改都会导致根哈希变化。',
  'eFuse': '硬件级一次性可编程熔断，一旦熔断不可恢复，用于永久固化关键配置和真值，防止运行态篡改。',
  'mTLS': '双向传输层安全认证，客户端和服务器都需要验证对方身份，用于高安全级别的内核节点间通信。',
  'JWT': 'JSON Web Token，短期有效的身份认证令牌，通过Scope作用域限定可调用的内核能力集合。',
  'ΔΦ': '语义潜空间相对于基态的动态畸变增量，可正交分解为本体层、数学层、认知层、工程层、社会层五个维度。',
  'SM-BS': '语义空间(Semantic Space)与黎曼流形(Riemannian Manifold)的双向稳态映射系统，保证语义距离在映射前后守恒。',
  '真值锁档': '将经过验证的高置信度真值通过SHA256哈希计算后写入Merkle-DAG账本，并通过eFuse硬件熔断永久固化的过程。'
};

// 为关键术语添加悬停解释
document.addEventListener('DOMContentLoaded', function() {
  const theorySection = document.getElementById('zongyuan-root');
  if (!theorySection) return;
  
  const terms = Object.keys(termExplanations);
  const walker = document.createTreeWalker(theorySection, NodeFilter.SHOW_TEXT, null, false);
  
  let node;
  while (node = walker.nextNode()) {
    let text = node.nodeValue;
    let modified = false;
    
    for (const term of terms) {
      if (text.includes(term) && node.parentElement.tagName !== 'SCRIPT' && node.parentElement.tagName !== 'STYLE') {
        const regex = new RegExp(term, 'g');
        text = text.replace(regex, `<span class="term-highlight" title="${termExplanations[term]}" style="color:#D4AF37;border-bottom:1px dashed #D4AF37;cursor:help">${term}</span>`);
        modified = true;
      }
    }
    
    if (modified) {
      const span = document.createElement('span');
      span.innerHTML = text;
      node.parentNode.replaceChild(span, node);
    }
  }
});
</script>

