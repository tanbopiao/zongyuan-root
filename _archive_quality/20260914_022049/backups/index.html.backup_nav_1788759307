let updateInterval = null;

async function fetchKernelStatus() {
  try {
    // AI Proxy状态
    fetch('/api/kernel/aiproxy/health')
      .then(r => r.json())
      .then(data => {
        if (data.models) {
          document.getElementById('modelCount').textContent = data.models.length;
        }
      })
      .catch(e => console.log('AI Proxy fetch error:', e));
    
    // Agent Hub状态
    fetch('/api/kernel/agenthub/health')
      .then(r => r.json())
      .then(data => {
        if (data.online_agents !== undefined) {
          document.getElementById('agentCount').textContent = data.online_agents;
        }
      })
      .catch(e => console.log('Agent Hub fetch error:', e));
    
    // 协议注册中心状态
    fetch('/api/kernel/protocol/health')
      .then(r => r.json())
      .then(data => {
        if (data.total_protocols) {
          document.getElementById('protocolCount').textContent = data.total_protocols;
        }
      })
      .catch(e => console.log('Protocol fetch error:', e));
    
    // 更新时间
    const now = new Date();
    document.getElementById('lastUpdate').textContent = '更新于 ' + now.toLocaleTimeString('zh-CN');
  } catch (e) {
    console.log('Kernel status update error:', e);
  }
}

// 启动实时更新（每30秒）
function startRealtimeUpdate() {
  fetchKernelStatus();
  updateInterval = setInterval(fetchKernelStatus, 30000);
}

// === 五层架构交互展开 ===
function toggleLayer(layerId) {
  const detail = document.getElementById('detail-' + layerId);
  const arrow = document.getElementById('arrow-' + layerId);
  if (detail.style.display === 'none') {
    detail.style.display = 'block';
    arrow.style.transform = 'rotate(180deg)';
  } else {
    detail.style.display = 'none';
    arrow.style.transform = 'rotate(0deg)';
  }
}

// 页面加载完成后启动
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', startRealtimeUpdate);
} else {
  startRealtimeUpdate();
}
</script>


