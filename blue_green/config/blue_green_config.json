  "database": {
    "migration_strategy": "expand_only",
    "dual_write_enabled": true,
    "gray_migration_batch_size": 1000,
    "backward_compatibility_required": true,
    "forward_compatibility_required": true
  },
  
  "nginx": {
    "config_path": "/www/server/panel/vhost/nginx/huodouai.com.conf",
    "upstream_name": "app_backend",
    "reload_command": "nginx -s reload",
    "test_command": "nginx -t"
