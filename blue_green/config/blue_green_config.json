  "health_check": {
    "enabled": true,
    "check_interval_seconds": 30,
    "error_rate_threshold": 5.0,
    "response_time_threshold_ms": 2000,
    "consecutive_failures_threshold": 3,
    "endpoints": ["/health", "/api/v1/health"]
