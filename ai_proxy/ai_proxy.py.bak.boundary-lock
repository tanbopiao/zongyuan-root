import urllib.request as _drift_req
def _drift_check(text, task_type="keyframe"):
    """调用本地漂移检测服务，返回(drift_level, result_dict)"""
    try:
        payload = json.dumps({"text": text, "task_type": task_type}).encode()
        req = _drift_req.Request("http://127.0.0.1:8022/check", data=payload,
                                  headers={"Content-Type": "application/json"})
        with _drift_req.urlopen(req, timeout=5) as resp:
            result = json.loads(resp.read())
            return result.get("drift_level", 0), result
    except Exception as e:
        return -1, {"error": str(e)}

def _drift_correction_prompt(result):
    """根据漂移检测结果生成修正提示词追加"""
    suggestions = result.get("suggestions", [])
    violations = result.get("violations", [])
    correction = ""
    if violations:
        correction += "【L0铁律修正】严禁：" + "、".join(violations[:3]) + "。"
    if suggestions:
        correction += "【本体特征强化】" + "；".join(suggestions[:2]) + "。"
    return correction


