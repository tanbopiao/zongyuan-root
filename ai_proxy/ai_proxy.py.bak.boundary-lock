from collections import OrderedDict

class OperatorLRUCache:
    """算子结果LRU缓存，相同参数的算子调用直接返回缓存结果"""
    def __init__(self, max_size=100, ttl=300):
        self.cache = OrderedDict()
        self.max_size = max_size
        self.ttl = ttl  # 缓存有效期5分钟
    
    def _make_key(self, group, operator, params):
        import hashlib
        raw = "%s:%s:%s" % (group, operator, json.dumps(params, sort_keys=True, default=str))
        return hashlib.md5(raw.encode()).hexdigest()
    
    def get(self, group, operator, params):
        key = self._make_key(group, operator, params)
        if key in self.cache:
            entry = self.cache[key]
            if time.time() - entry["time"] < self.ttl:
                self.cache.move_to_end(key)
                return entry["result"]
            else:
                del self.cache[key]
        return None
    
    def set(self, group, operator, params, result):
        key = self._make_key(group, operator, params)
        self.cache[key] = {"result": result, "time": time.time()}
        self.cache.move_to_end(key)
        while len(self.cache) > self.max_size:
            self.cache.popitem(last=False)
    
    def clear(self):
        self.cache.clear()
    
    def stats(self):
        return {"size": len(self.cache), "max_size": self.max_size, "ttl": self.ttl}

operator_cache = OperatorLRUCache(max_size=100, ttl=300)


