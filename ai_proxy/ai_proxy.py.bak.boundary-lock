def smart_route(messages, mode="public"):
    """十模型智能路由：场景化路由规则R1-R10 + 上下文长度 + 健康状态
    mode=public: 对外免费优先
    mode=internal: 内部高质优先
    自动识别任务类型：chat/doc/long/reasoning/code/english/batch
    """
    # 估算token数
    total_chars = sum(len(m.get("content", "")) for m in messages if isinstance(m, dict))
    estimated_tokens = total_chars // 3
    
    # 自动识别任务类型（R1-R10场景化路由）
    all_text = " ".join(m.get("content", "") for m in messages if isinstance(m, dict))
    if estimated_tokens > 8000:
        task_type = "long"  # R3: 超长文本
    elif any(kw in all_text for kw in ["代码", "编程", "函数", "bug", "python", "javascript", "code", "程序"]):
        task_type = "code"  # R5: 代码任务
    elif any(kw in all_text for kw in ["推理", "逻辑", "数学", "计算", "分析", "为什么", "原理"]):
        task_type = "reasoning"  # R4: 推理任务
    elif any(kw in all_text for kw in ["翻译", "english", "英文", "translate", "英语"]):
        task_type = "english"  # R6: 英文任务
    elif any(kw in all_text for kw in ["公文", "通知", "报告", "请示", "润色", "起草"]):
        task_type = "doc"  # 公文任务
    else:
        task_type = "chat"  # R1: 常规问答
    
    # 场景化路由规则表
    routing_rules = {
        "chat": ["zhipu", "agnes", "siliconflow", "aliyun", "kimi", "doubao", "hunyuan"],
        "doc": ["zhipu", "agnes", "doubao", "siliconflow", "aliyun", "kimi", "hunyuan"],
        "long": ["agnes", "kimi", "aliyun", "zhipu", "siliconflow", "doubao", "hunyuan"],
        "reasoning": ["doubao-reasoning", "doubao", "agnes", "zhipu", "siliconflow", "kimi", "hunyuan"],
        "code": ["doubao-reasoning2", "siliconflow", "doubao", "agnes", "zhipu", "aliyun", "kimi"],
        "english": ["agnes", "siliconflow", "zhipu", "kimi", "aliyun", "doubao", "hunyuan"],
        "batch": ["siliconflow", "zhipu", "agnes", "aliyun", "kimi", "doubao", "hunyuan"],
    }
    
    # 基础优先级排序
    if mode == "internal":
        base_order = ["doubao", "doubao-reasoning", "doubao-reasoning2", "zhipu", "agnes", "siliconflow", "aliyun", "kimi", "hunyuan"]
        if estimated_tokens > 8000:
            base_order = ["kimi", "doubao-reasoning", "doubao", "agnes", "zhipu", "siliconflow", "aliyun", "hunyuan"]
    else:
        # 对外模式：使用场景化路由
        base_order = routing_rules.get(task_type, routing_rules["chat"])
    
    # 过滤熔断模型（最近5分钟失败的）
    now = time.time()
    healthy = []
    for m in base_order:
        last_fail = MODEL_HEALTH.get(m, {}).get("last_fail", 0)
        fail_count = MODEL_HEALTH.get(m, {}).get("fail_count", 0)
        if now - last_fail < CIRCUIT_BREAKER_SECONDS and fail_count >= 3:
            continue  # 熔断中，跳过
        if m in MODELS and MODELS[m].get("type") == "cloud":
            healthy.append(m)
    
    # 动态路由调整：有统计数据的模型，按平均响应时间排序（快的优先）
    # 但保持免费模型优先的大原则，只在同类型内调整
    if len(healthy) > 1:
        # 分离免费和付费模型
        free_models = [m for m in healthy if m in ("zhipu", "agnes", "siliconflow")]
        paid_models = [m for m in healthy if m not in ("zhipu", "agnes", "siliconflow")]
        # 免费模型内按响应时间排序
        free_with_time = [(m, MODEL_USAGE.get(m, {}).get("avg_time_ms", 99999)) for m in free_models]
        free_with_time.sort(key=lambda x: x[1])
        # 付费模型内按响应时间排序
        paid_with_time = [(m, MODEL_USAGE.get(m, {}).get("avg_time_ms", 99999)) for m in paid_models]
        paid_with_time.sort(key=lambda x: x[1])
        # 合并：免费优先，付费在后
        healthy = [m for m, _ in free_with_time] + [m for m, _ in paid_with_time]
    
    # 如果所有模型都熔断了，重置熔断状态
    if not healthy:
        for m in base_order:
            if m in MODEL_HEALTH:
                MODEL_HEALTH[m]["fail_count"] = 0
        healthy = [m for m in base_order if m in MODELS and MODELS[m].get("type") == "cloud"]
    
    # 最后添加本地兜底
    if "ollama-local" in MODELS:
        healthy.append("ollama-local")
    
    return healthy, estimated_tokens


