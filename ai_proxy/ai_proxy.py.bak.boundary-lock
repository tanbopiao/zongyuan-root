def call_llm(model_key, messages, max_tokens=2048, mode="public"):
    """十模型智能路由调用：按上下文长度+健康状态动态选择，失败自动切换
    mode=public: 对外免费优先, mode=internal: 内部高质优先
    """
    # 智能路由：返回排序后的模型列表和估算token数
    attempt_models, estimated_tokens = smart_route(messages, mode=mode)
    # 如果指定了model_key且存在，将其移到最优先位置
    if model_key and model_key in MODELS and model_key in attempt_models:
        attempt_models.remove(model_key)
        attempt_models.insert(0, model_key)
    
    last_error = None
    for attempt_key in attempt_models:
        cfg = MODELS.get(attempt_key)
        if not cfg:
            continue
        url = f"{cfg['base']}/chat/completions"
        # 火山方舟需要用endpoint ID作为model，其他平台用model名
        if 'ark.cn-beijing' in cfg.get('base','') and cfg.get('endpoint'):
            model_name = cfg['endpoint']
        else:
            model_name = cfg['model']
        body = json.dumps({"model": model_name, "messages": messages, "max_tokens": max_tokens, "stream": False}).encode()
        req = urllib.request.Request(url, data=body, headers={
            "Content-Type": "application/json",
            "Authorization": f"Bearer {_resolve_env_var(cfg['key'])}"
        })
        try:
            timeout = 30 if cfg.get("type") == "local_fallback" else 60
            call_start = time.time()
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                data = json.loads(resp.read())
                result = data["choices"][0]["message"]["content"]
                call_elapsed = (time.time() - call_start) * 1000
                if attempt_key == "ollama-local":
                    FAILOVER_CONFIG["failover_count"] += 1
                    FAILOVER_CONFIG["last_failover_time"] = time.time()
                # 成功时重置该模型的失败计数
                if attempt_key in MODEL_HEALTH:
                    MODEL_HEALTH[attempt_key]["fail_count"] = 0
                # 记录调用统计+响应时间
                if attempt_key not in MODEL_USAGE:
                    MODEL_USAGE[attempt_key] = {"total_calls": 0, "success": 0, "fail": 0, "total_time_ms": 0, "avg_time_ms": 0, "last_call": 0}
                MODEL_USAGE[attempt_key]["total_calls"] += 1
                MODEL_USAGE[attempt_key]["success"] += 1
                MODEL_USAGE[attempt_key]["total_time_ms"] += call_elapsed
                MODEL_USAGE[attempt_key]["avg_time_ms"] = round(MODEL_USAGE[attempt_key]["total_time_ms"] / MODEL_USAGE[attempt_key]["success"], 1)
                MODEL_USAGE[attempt_key]["last_call"] = time.time()
                # P3-2: 国家主权根合规校验（一次接入覆盖所有业务线）
                try:
                    sov_result = aiproxy_sov.check_ai_output_compliance(attempt_key, result, messages)
                    if sov_result.get("blocked"):
                        return f"[合规拦截] 内容未通过国家主权根合规校验（{sov_result.get('level','warning')}），审计哈希: {sov_result.get('audit_hash')}", attempt_key
                except Exception as sov_e:
                    pass  # 合规校验失败不影响AI调用
                return result, attempt_key
        except Exception as e:
            last_error = e
            # 记录模型失败状态（熔断）
            if attempt_key not in MODEL_HEALTH:
                MODEL_HEALTH[attempt_key] = {"fail_count": 0, "last_fail": 0}
            MODEL_HEALTH[attempt_key]["fail_count"] += 1
            MODEL_HEALTH[attempt_key]["last_fail"] = time.time()
            # 记录失败统计
            if attempt_key not in MODEL_USAGE:
                MODEL_USAGE[attempt_key] = {"total_calls": 0, "success": 0, "fail": 0, "total_time_ms": 0, "avg_time_ms": 0, "last_call": 0}
            MODEL_USAGE[attempt_key]["total_calls"] += 1
            MODEL_USAGE[attempt_key]["fail"] += 1
            MODEL_USAGE[attempt_key]["last_call"] = time.time()
            continue
    
    return f"[API错误] 所有模型均失败: {str(last_error)}", "unknown"

def load_paid_requests():
    """加载付费申请队列"""
    try:
        if os.path.exists(PAID_REQUESTS_FILE):
            with open(PAID_REQUESTS_FILE, 'r') as f:
                return json.load(f)
    except:
        pass
    return {"requests": [], "stats": {"total": 0, "pending": 0, "approved": 0, "rejected": 0}}

def save_paid_requests(requests_data):
    """保存付费申请队列"""
    os.makedirs(os.path.dirname(PAID_REQUESTS_FILE), exist_ok=True)
    with open(PAID_REQUESTS_FILE, 'w') as f:
        json.dump(requests_data, f, ensure_ascii=False, indent=2)

def create_paid_request(model_key, prompt_preview="", requester="anonymous"):
    """创建付费调用申请"""
    import uuid
    requests_data = load_paid_requests()
    request_id = f"PAID-{uuid.uuid4().hex[:12].upper()}"
    cost = PAID_COST_MAP.get(model_key, 0.001)
    now = time.time()
    request = {
        "request_id": request_id,
        "model": model_key,
        "prompt_preview": prompt_preview[:200],
        "cost_estimate": cost,
        "requester": requester,
        "status": "pending",
        "created_at": now,
        "created_at_iso": time.strftime("%Y-%m-%dT%H:%M:%S", time.localtime(now)),
        "approved_at": None,
        "approved_by": None,
        "expires_at": now + PAID_REQUEST_EXPIRE_HOURS * 3600,
        "executed": False,
        "executed_at": None
    }
    requests_data["requests"].append(request)
    requests_data["stats"]["total"] = requests_data["stats"].get("total", 0) + 1
    requests_data["stats"]["pending"] = requests_data["stats"].get("pending", 0) + 1
    save_paid_requests(requests_data)
    PAID_REVIEW_STATS["total_requests"] += 1
    PAID_REVIEW_STATS["pending"] += 1
    return request

def approve_paid_request(request_id, approved_by="admin"):
    """审核通过付费申请"""
    requests_data = load_paid_requests()
    for req in requests_data["requests"]:
        if req["request_id"] == request_id and req["status"] == "pending":
            req["status"] = "approved"
            req["approved_at"] = time.time()
            req["approved_by"] = approved_by
            requests_data["stats"]["pending"] -= 1
            requests_data["stats"]["approved"] = requests_data["stats"].get("approved", 0) + 1
            save_paid_requests(requests_data)
            PAID_REVIEW_STATS["pending"] -= 1
            PAID_REVIEW_STATS["approved"] += 1
            return req
    return None

def reject_paid_request(request_id, reason="", rejected_by="admin"):
    """审核拒绝付费申请"""
    requests_data = load_paid_requests()
    for req in requests_data["requests"]:
        if req["request_id"] == request_id and req["status"] == "pending":
            req["status"] = "rejected"
            req["reject_reason"] = reason
            req["rejected_by"] = rejected_by
            requests_data["stats"]["pending"] -= 1
            requests_data["stats"]["rejected"] = requests_data["stats"].get("rejected", 0) + 1
            save_paid_requests(requests_data)
            PAID_REVIEW_STATS["pending"] -= 1
            PAID_REVIEW_STATS["rejected"] += 1
            return req
    return None

def check_paid_request_valid(request_id):
    """检查付费申请是否有效（已审核通过且未过期）"""
    if not request_id:
        return False, "缺少付费申请ID"
    requests_data = load_paid_requests()
    for req in requests_data["requests"]:
        if req["request_id"] == request_id:
            if req["status"] != "approved":
                return False, f"申请状态为{req['status']}，需要人工审核通过"
            if req["executed"]:
                return False, "该申请已执行过，一次性使用"
            if time.time() > req["expires_at"]:
                req["status"] = "expired"
                save_paid_requests(requests_data)
                return False, "申请已过期（24小时），请重新申请"
            return True, req
    return False, "申请ID不存在"

def mark_paid_request_executed(request_id):
    """标记付费申请已执行"""
    requests_data = load_paid_requests()
    for req in requests_data["requests"]:
        if req["request_id"] == request_id:
            req["executed"] = True
            req["executed_at"] = time.time()
            save_paid_requests(requests_data)
            PAID_REVIEW_STATS["executed"] += 1
            return True
    return False

