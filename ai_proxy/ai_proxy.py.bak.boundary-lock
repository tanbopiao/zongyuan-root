def batch_worker():
    """批量队列Worker：串行处理任务（免费优先：zhipu文本+Agnes视频）"""
    global BATCH_LOCK
    if BATCH_LOCK: return
    BATCH_LOCK = True
    try:
        while BATCH_QUEUE:
            task = BATCH_QUEUE.pop(0)
            batch_id = task["batch_id"]
            idx = task["index"]
            BATCH_RESULTS[batch_id]["items"][idx]["status"] = "running"
            try:
                # 免费优先：zhipu生成剧本
                chat_resp = _call_chat_internal(task["prompt"], "script")
                script_text = chat_resp.get("result", task["prompt"]) if isinstance(chat_resp, dict) else str(chat_resp)
                # 免费优先：Agnes视频生成
                vid_resp = call_video_generation({
                    "provider": "agnes",
                    "api_key": "",
                    "endpoint": "https://apihub.agnes-ai.cn/v1",
                    "model": "agnes-video-v2.0"
                }, script_text[:200], 10, "9:16", None)
                task_id = vid_resp if isinstance(vid_resp, str) else vid_resp.get("id", "")
                BATCH_RESULTS[batch_id]["items"][idx]["status"] = "completed"
                BATCH_RESULTS[batch_id]["items"][idx]["video_task"] = task_id
                BATCH_RESULTS[batch_id]["items"][idx]["script_preview"] = script_text[:80]
            except Exception as e:
                BATCH_RESULTS[batch_id]["items"][idx]["status"] = "failed"
                BATCH_RESULTS[batch_id]["items"][idx]["error"] = str(e)[:100]
            BATCH_RESULTS[batch_id]["completed"] += 1
    finally:
        BATCH_LOCK = False

def call_video_generation(api_config, prompt, duration=10, ratio="9:16", image_url=None):
