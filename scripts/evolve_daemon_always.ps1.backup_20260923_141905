# === 鏉╂稑瀵茬拋鈩冩殶閸ｃ劏鍤滈崝銊х柈閸?===
$counterPath = "C:\Users\4906\.zongyuan_root\kernel\evolve_counter.json"
if (Test-Path $counterPath) {
    $counter = Get-Content $counterPath -Raw | ConvertFrom-Json
    $counter.total_evolutions += 1
    $counter.last_evolve_time = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    
    # 鐠佹澘缍嶉崢鍡楀蕉
    if (-not $counter.evolve_history) {
        $counter.evolve_history = @()
    }
    $counter.evolve_history += @{
        time = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
        count = $counter.total_evolutions
    }
    # 閸欘亙绻氶悾娆愭付鏉?0閺?    if ($counter.evolve_history.Count -gt 20) {
        $counter.evolve_history = $counter.evolve_history[-20..-1]
    }
    
    $counter | ConvertTo-Json -Depth 3 | Set-Content -Path $counterPath -Encoding UTF8
    Write-Host "[$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')] 鏉╂稑瀵茬拋鈩冩殶閸? $($counter.total_evolutions) 濞?
}



