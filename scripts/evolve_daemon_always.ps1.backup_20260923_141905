$logPath = "C:\Users\4906\.zongyuan_root\logs\daemon_always.log"

function Write-Log {
    param([string]$msg)
    $time = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    "$time | $msg" | Add-Content -Path $logPath -Encoding UTF8
}

Write-Log "鐎瑰牊濮㈡潻娑氣柤閸氼垰濮╅敍瀛璉D: $PID"
