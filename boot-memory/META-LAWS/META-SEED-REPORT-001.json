{
  "law_id": "META-SEED-REPORT-001",
  "name": "种子真值上报规范",
  "level": "meta_rule",
  "clauses": [
    {"id": "SR-1", "text": "只上报能力数据/工单调度/多模态/记忆网关类种子，不上报纯哲学"},
    {"id": "SR-2", "text": "每条种子格式：seed_id+user_prompt+response"},
    {"id": "SR-3", "text": "response不超过200字"},
    {"id": "SR-4", "text": "上报后自动去重，不重复入库"}
  ]
}
