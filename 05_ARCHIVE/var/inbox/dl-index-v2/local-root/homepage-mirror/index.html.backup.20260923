<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>火斗云智通用大模型 · 元极恒一自治体系</title>
<meta name="description" content="火斗云智AIOS — ZONGYUAN-ROOT元极恒一自治体系，全域真值中枢，三级真值谱系，八大频域基座，物理数学三位一体，永恒自治进化。">
<link rel="stylesheet" href="https://miaoda.feishu.cn/fonts/css2?family=Noto+Serif+SC:wght@400;600;700;900&family=Noto+Sans+SC:wght@300;400;500;700&family=JetBrains+Mono:wght@400;500;700&display=swap">
<script src="https://cdn.jsdelivr.net/npm/echarts@5.4.3/dist/echarts.min.js"></script>
<style>
:root{
  --bg:#0a0a0f;--bg2:#111118;--bg3:#18181f;--line:#2a2a35;
  --gold:#c9a96e;--gold2:#e8d5a3;--gold3:#8b7340;--gold4:rgba(201,169,110,.1);
  --text:#e8e6e0;--text2:#9a9890;--text3:#5a5850;
  --accent:#4a9eff;--green:#5ec98a;--red:#e85c5c;--purple:#9b6ef3;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--text);font-family:'Noto Sans SC',system-ui,sans-serif;line-height:1.6;overflow-x:hidden}
body::before{content:'';position:fixed;inset:0;background:radial-gradient(ellipse at 20% 0%,rgba(201,169,110,.08) 0%,transparent 50%),radial-gradient(ellipse at 80% 100%,rgba(74,158,255,.05) 0%,transparent 50%);pointer-events:none;z-index:0}
.wrap{max-width:1280px;margin:0 auto;padding:0 24px;position:relative;z-index:1}

/* 导航 */
.nav{position:fixed;top:0;left:0;right:0;z-index:1000;background:rgba(10,10,15,.9);backdrop-filter:blur(16px);border-bottom:1px solid var(--line)}
.nav-inner{display:flex;align-items:center;justify-content:space-between;height:64px;max-width:1280px;margin:0 auto;padding:0 24px}
.brand{display:flex;align-items:center;gap:12px;text-decoration:none}
.brand-logo{width:40px;height:40px;border:1.5px solid var(--gold);border-radius:8px;display:flex;align-items:center;justify-content:center;font-family:'Noto Serif SC',serif;font-size:18px;font-weight:900;color:var(--gold);background:linear-gradient(135deg,rgba(201,169,110,.15),transparent)}
.brand-text{display:flex;flex-direction:column;line-height:1.2}
.brand-name{font-family:'Noto Serif SC',serif;font-size:16px;font-weight:700;color:var(--gold2)}
.brand-sub{font-size:10px;color:var(--text3);font-family:'JetBrains Mono',monospace;letter-spacing:1px}
.nav-menu{display:flex;gap:4px;list-style:none}
.nav-menu a{color:var(--text2);text-decoration:none;font-size:13px;padding:8px 14px;border-radius:6px;transition:all .2s;cursor:pointer}
.nav-menu a:hover,.nav-menu a.active{color:var(--gold2);background:var(--gold4)}
.nav-cta{display:flex;align-items:center;gap:8px;padding:8px 18px;background:linear-gradient(135deg,var(--gold),var(--gold3));color:var(--bg);border:none;border-radius:6px;font-size:13px;font-weight:600;cursor:pointer;text-decoration:none;transition:all .2s}
.nav-cta:hover{transform:translateY(-1px);box-shadow:0 4px 20px rgba(201,169,110,.3)}
.nav-status{display:flex;align-items:center;gap:6px;font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--green)}
.nav-status .dot{width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 8px var(--green);animation:pulse 2s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
.mobile-toggle{display:none;background:none;border:none;color:var(--text);font-size:20px;cursor:pointer}

/* 视图切换 */
.view{display:none;min-height:100vh;padding-top:64px}
.view.active{display:block;animation:fadeIn .4s ease}
@keyframes fadeIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}

/* Hero */
.hero{padding:100px 0 80px;text-align:center;position:relative;overflow:hidden}
.hero::before{content:'';position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:800px;height:800px;background:radial-gradient(circle,rgba(201,169,110,.06) 0%,transparent 70%);pointer-events:none}
.hero-badge{display:inline-flex;align-items:center;gap:8px;padding:6px 16px;border:1px solid var(--gold3);border-radius:20px;font-size:12px;color:var(--gold);font-family:'JetBrains Mono',monospace;margin-bottom:28px;background:var(--gold4)}
.hero h1{font-family:'Noto Serif SC',serif;font-size:clamp(36px,6vw,64px);font-weight:900;line-height:1.15;margin-bottom:20px;background:linear-gradient(135deg,var(--gold2) 0%,var(--gold) 50%,var(--gold3) 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.hero .sub{font-size:clamp(15px,2vw,19px);color:var(--text2);max-width:720px;margin:0 auto 36px}
.hero-ids{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;margin-bottom:40px}
.id-chip{padding:7px 14px;background:var(--bg2);border:1px solid var(--line);border-radius:6px;font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--text2)}
.id-chip .label{color:var(--gold3);margin-right:6px}
.hero-cta{display:flex;flex-wrap:wrap;justify-content:center;gap:14px}
.btn-primary{display:inline-flex;align-items:center;gap:8px;padding:14px 32px;background:linear-gradient(135deg,var(--gold),var(--gold3));color:var(--bg);border:none;border-radius:8px;font-size:15px;font-weight:600;cursor:pointer;text-decoration:none;transition:all .2s}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 8px 30px rgba(201,169,110,.35)}
.btn-secondary{display:inline-flex;align-items:center;gap:8px;padding:14px 32px;background:transparent;color:var(--gold2);border:1px solid var(--gold3);border-radius:8px;font-size:15px;font-weight:500;cursor:pointer;text-decoration:none;transition:all .2s}
.btn-secondary:hover{background:var(--gold4);border-color:var(--gold)}

/* 数据条 */
.stats-bar{display:grid;grid-template-columns:repeat(6,1fr);gap:1px;background:var(--line);border-radius:12px;overflow:hidden;margin:-40px auto 60px;max-width:1100px;position:relative;z-index:2}
.stat-item{background:var(--bg2);padding:24px 16px;text-align:center}
.stat-num{font-family:'JetBrains Mono',monospace;font-size:28px;font-weight:700;color:var(--gold2);margin-bottom:4px}
.stat-label{font-size:12px;color:var(--text2)}

/* 区块通用 */
.section{padding:70px 0}
.section-head{text-align:center;margin-bottom:48px}
.section-tag{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--gold);letter-spacing:2px;margin-bottom:10px}
.section-title{font-family:'Noto Serif SC',serif;font-size:clamp(26px,3.5vw,38px);font-weight:700;color:var(--text);margin-bottom:12px}
.section-desc{font-size:15px;color:var(--text2);max-width:640px;margin:0 auto}

/* 特性卡片 */
.features{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.feature-card{background:linear-gradient(135deg,var(--bg2),var(--bg3));border:1px solid var(--line);border-radius:12px;padding:32px 28px;transition:all .3s;position:relative;overflow:hidden}
.feature-card:hover{border-color:var(--gold3);transform:translateY(-4px)}
.feature-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:0;transition:opacity .3s}
.feature-card:hover::before{opacity:1}
.feature-icon{width:48px;height:48px;border-radius:10px;background:var(--gold4);border:1px solid var(--gold3);display:flex;align-items:center;justify-content:center;font-family:'Noto Serif SC',serif;font-size:20px;color:var(--gold);margin-bottom:20px}
.feature-card h3{font-family:'Noto Serif SC',serif;font-size:19px;font-weight:700;color:var(--text);margin-bottom:10px}
.feature-card p{font-size:14px;color:var(--text2);line-height:1.7}

/* 图表容器 */
.chart-box{background:var(--bg2);border:1px solid var(--line);border-radius:12px;padding:24px}
.chart-title{font-size:15px;font-weight:600;color:var(--text);margin-bottom:16px;display:flex;align-items:center;gap:10px}
.chart-title::before{content:'';width:3px;height:16px;background:var(--gold);border-radius:2px}
.chart{width:100%;height:380px}
.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}

/* 谱系卡片 */
.spectrum{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:20px}
.spec-card{background:var(--bg2);border:1px solid var(--line);border-radius:12px;padding:32px 28px;position:relative;transition:all .3s}
.spec-card:hover{border-color:var(--gold3)}
.spec-v{font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--gold);margin-bottom:10px}
.spec-card h3{font-family:'Noto Serif SC',serif;font-size:22px;font-weight:700;margin-bottom:12px;color:var(--text)}
.spec-card p{font-size:14px;color:var(--text2);margin-bottom:18px;line-height:1.7}
.spec-items{display:flex;flex-wrap:wrap;gap:6px}
.spec-item{padding:5px 10px;background:var(--bg3);border:1px solid var(--line);border-radius:4px;font-size:11px;color:var(--text2);font-family:'JetBrains Mono',monospace}

/* 基座网格 */
.base-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.base-card{background:var(--bg2);border:1px solid var(--line);border-radius:10px;padding:20px 18px;transition:all .2s}
.base-card:hover{border-color:var(--gold3);background:var(--bg3)}
.base-icon{width:36px;height:36px;border-radius:8px;background:var(--gold4);border:1px solid var(--gold3);display:flex;align-items:center;justify-content:center;font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--gold);margin-bottom:12px}
.base-card h4{font-size:14px;font-weight:600;color:var(--text);margin-bottom:4px}
.base-card .val{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--gold);margin-bottom:8px}
.base-card p{font-size:11px;color:var(--text3);line-height:1.5}

/* 资产网格 */
.asset-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.asset-card{background:var(--bg2);border:1px solid var(--line);border-radius:12px;overflow:hidden;transition:all .3s;cursor:pointer}
.asset-card:hover{border-color:var(--gold3);transform:translateY(-3px)}
.asset-thumb{height:160px;background:linear-gradient(135deg,var(--bg3),var(--bg2));display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden}
.asset-thumb::after{content:'';position:absolute;inset:0;background:radial-gradient(circle at 50% 50%,rgba(201,169,110,.1),transparent 70%)}
.asset-thumb-icon{font-family:'Noto Serif SC',serif;font-size:42px;font-weight:900;color:var(--gold);opacity:.6;position:relative;z-index:1}
.asset-body{padding:18px 20px}
.asset-cat{font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--gold3);margin-bottom:6px;letter-spacing:1px}
.asset-body h4{font-size:15px;font-weight:600;color:var(--text);margin-bottom:6px}
.asset-body p{font-size:12px;color:var(--text3);line-height:1.5}
.asset-meta{display:flex;justify-content:space-between;align-items:center;margin-top:12px;padding-top:12px;border-top:1px solid var(--line)}
.asset-hash{font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--text3)}

/* 时间轴 */
.timeline{position:relative;padding-left:40px}
.timeline::before{content:'';position:absolute;left:15px;top:0;bottom:0;width:2px;background:linear-gradient(180deg,var(--gold),var(--line))}
.tl-item{position:relative;margin-bottom:32px}
.tl-item::before{content:'';position:absolute;left:-30px;top:6px;width:12px;height:12px;border-radius:50%;background:var(--bg);border:2px solid var(--gold);box-shadow:0 0 0 4px rgba(201,169,110,.1);box-sizing:border-box}
.tl-time{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--gold);margin-bottom:4px}
.tl-title{font-size:16px;font-weight:600;color:var(--text);margin-bottom:4px}
.tl-desc{font-size:13px;color:var(--text2)}

/* SOP流程 */
.sop-flow{display:grid;grid-template-columns:repeat(7,1fr);gap:8px}
.sop-step{background:var(--bg2);border:1px solid var(--line);border-radius:10px;padding:18px 12px;text-align:center;transition:all .2s}
.sop-step:hover{border-color:var(--gold3)}
.sop-num{font-family:'JetBrains Mono',monospace;font-size:22px;font-weight:700;color:var(--gold);margin-bottom:6px}
.sop-step h4{font-size:12px;font-weight:600;color:var(--text);margin-bottom:4px}
.sop-step p{font-size:10px;color:var(--text3);line-height:1.4}

/* 元法则卡片 */
.meta-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}
.meta-card{background:linear-gradient(135deg,var(--bg2),var(--bg3));border:1px solid var(--line);border-radius:12px;padding:28px;position:relative;overflow:hidden}
.meta-card::before{content:'';position:absolute;top:0;left:0;width:4px;height:100%;background:linear-gradient(180deg,var(--gold),transparent)}
.meta-tag{font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--gold3);margin-bottom:8px;letter-spacing:1px}
.meta-card h3{font-family:'Noto Serif SC',serif;font-size:18px;font-weight:700;color:var(--text);margin-bottom:10px}
.meta-card p{font-size:13px;color:var(--text2);margin-bottom:14px;line-height:1.7}
.meta-hash{font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--text3);background:var(--bg);padding:8px 12px;border-radius:6px;border:1px solid var(--line);word-break:break-all}

/* 页脚 */
.footer{padding:50px 0 30px;border-top:1px solid var(--line);margin-top:60px}
.footer-inner{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:40px;margin-bottom:40px}
.footer-brand .brand{margin-bottom:16px}
.footer-brand p{font-size:13px;color:var(--text3);line-height:1.7}
.footer-col h4{font-size:14px;font-weight:600;color:var(--text);margin-bottom:16px}
.footer-col ul{list-style:none}
.footer-col li{margin-bottom:10px}
.footer-col a{color:var(--text3);text-decoration:none;font-size:13px;transition:color .2s;cursor:pointer}
.footer-col a:hover{color:var(--gold2)}
.footer-bottom{text-align:center;padding-top:24px;border-top:1px solid var(--line)}
.footer-bottom p{font-size:12px;color:var(--text3);font-family:'JetBrains Mono',monospace}
.footer-bottom .sig{font-family:'Noto Serif SC',serif;font-size:14px;color:var(--gold);margin-bottom:8px}

/* 作品画廊 */
.gallery-filters{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-bottom:32px}
.filter-btn{padding:10px 22px;background:var(--bg3);border:1px solid var(--line);border-radius:20px;color:var(--text2);font-size:13px;cursor:pointer;transition:all .2s;font-family:'Noto Sans SC',sans-serif}
.filter-btn:hover{border-color:var(--gold3);color:var(--gold2)}
.filter-btn.active{background:linear-gradient(135deg,var(--gold),var(--gold3));color:var(--bg);border-color:var(--gold);font-weight:600}
.gallery-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.gallery-card{background:var(--bg2);border:1px solid var(--line);border-radius:12px;overflow:hidden;transition:all .3s;cursor:pointer}
.gallery-card:hover{border-color:var(--gold3);transform:translateY(-4px);box-shadow:0 8px 30px rgba(201,169,110,.15)}
.gallery-card.hidden{display:none}
.gallery-thumb{height:180px;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden}
.gallery-thumb::after{content:'';position:absolute;inset:0;background:radial-gradient(circle at 50% 50%,rgba(201,169,110,.12),transparent 70%)}
.gallery-icon{font-family:'Noto Serif SC',serif;font-size:48px;font-weight:900;opacity:.7;position:relative;z-index:1}
.gallery-badge{position:absolute;top:12px;right:12px;padding:4px 12px;background:rgba(10,10,15,.8);border:1px solid var(--gold3);border-radius:12px;font-size:10px;color:var(--gold);font-family:'JetBrains Mono',monospace;z-index:2}
.gallery-body{padding:18px 20px}
.gallery-body h4{font-size:15px;font-weight:600;color:var(--text);margin-bottom:6px}
.gallery-body p{font-size:12px;color:var(--text3);margin-bottom:12px}
.gallery-meta{display:flex;justify-content:space-between;font-size:10px;color:var(--text3);font-family:'JetBrains Mono',monospace;padding-top:10px;border-top:1px solid var(--line)}

/* 控制台算子 */
.operator-layers{display:flex;flex-direction:column;gap:20px}
.op-layer{background:var(--bg2);border:1px solid var(--line);border-radius:12px;padding:20px 24px}
.op-layer-title{font-family:'Noto Serif SC',serif;font-size:15px;font-weight:700;color:var(--gold2);margin-bottom:14px;padding-bottom:10px;border-bottom:1px solid var(--line)}
.op-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:10px}
.op-card{background:var(--bg3);border:1px solid var(--line);border-radius:8px;padding:14px 16px;display:flex;justify-content:space-between;align-items:center;transition:all .2s}
.op-card:hover{border-color:var(--gold3)}
.op-card.online{border-left:3px solid var(--green)}
.op-card.preactive{border-left:3px solid var(--accent)}
.op-name{font-size:13px;font-weight:600;color:var(--text)}
.op-status{font-size:10px;color:var(--green);font-family:'JetBrains Mono',monospace}
.op-card.preactive .op-status{color:var(--accent)}

/* 响应式 */
@media(max-width:1024px){
  .nav-menu{display:none}
  .mobile-toggle{display:block}
  .features,.grid-2,.grid-3,.spectrum,.meta-grid,.asset-grid{grid-template-columns:1fr}
  .base-grid{grid-template-columns:repeat(2,1fr)}
  .sop-flow{grid-template-columns:repeat(2,1fr)}
  .stats-bar{grid-template-columns:repeat(3,1fr)}
  .footer-inner{grid-template-columns:1fr 1fr}
  .gallery-grid{grid-template-columns:1fr 1fr}
}
@media(max-width:640px){
  .base-grid{grid-template-columns:1fr}
  .stats-bar{grid-template-columns:repeat(2,1fr)}
  .hero{padding:70px 0 50px}
  .section{padding:50px 0}
  .footer-inner{grid-template-columns:1fr}
  .gallery-grid{grid-template-columns:1fr}
  .filter-btn{padding:8px 16px;font-size:12px}
}
</style>
</head>
<body>

<!-- 导航 -->
<nav class="nav">
<div class="nav-inner">
<a class="brand" onclick="switchView('home')">
<div class="brand-logo">火</div>
<div class="brand-text"><span class="brand-name">火斗云智AIOS</span><span class="brand-sub">ZONGYUAN-ROOT</span></div>
</a>
<ul class="nav-menu">
<li><a class="active" data-view="home" onclick="switchView('home')">首页</a></li>
<li><a data-view="create" onclick="switchView('create')">创作平台</a></li>
<li><a data-view="architecture" onclick="switchView('architecture')">体系架构</a></li>
<li><a data-view="characters" onclick="switchView('characters')">角色宇宙</a></li>
<li><a data-view="assets" onclick="switchView('assets')">资产中心</a></li>
<li><a data-view="whitepaper" onclick="switchView('whitepaper')">技术白皮书</a></li>
<li><a data-view="metalaw" onclick="switchView('metalaw')">元法则</a></li>
<li><a data-view="console" onclick="switchView('console')">控制台</a></li>
<li><a data-view="about" onclick="switchView('about')">关于我们</a></li>
</ul>
<div style="display:flex;align-items:center;gap:16px">
<div class="nav-status"><span class="dot"></span>AUTONOMOUS</div>
<a class="nav-cta" onclick="switchView('architecture')">进入体系</a>
</div>
<button class="mobile-toggle" onclick="toggleMobileMenu()">☰</button>
</div>
</nav>

<!-- 首页视图 -->
<div class="view active" id="view-home">
<section class="hero">
<div class="wrap">
<div class="hero-badge">元极恒一超认知永恒自治内核协议 · Lv10 锁级</div>
<h1>火斗云智通用大模型</h1>
<p class="sub">火斗云智AIOS — 基于ZONGYUAN-ROOT元极恒一自治体系，构建三级真值谱系、八大频域基座、物理数学三位一体，实现永恒自治、静默进化、全域逆熵稳态。</p>
<div class="hero-ids">
<div class="id-chip"><span class="label">DID</span>DID-BR-000002</div>
<div class="id-chip"><span class="label">ROOT-DID</span>did:zongyuan:root:Ω₀-2026-0614-V1.0</div>
<div class="id-chip"><span class="label">标识</span>Ω₀⊂⊙∞⊂Ω</div>
<div class="id-chip"><span class="label">主控</span>TCM-ST-FUXI-ROOT-001</div>
</div>
<div class="hero-cta">
<a class="btn-primary" onclick="switchView('architecture')">探索体系架构 →</a>
<a class="btn-secondary" onclick="switchView('assets')">查看资产中心</a>
</div>
</div>
</section>

<div class="wrap">
<div class="stats-bar">
