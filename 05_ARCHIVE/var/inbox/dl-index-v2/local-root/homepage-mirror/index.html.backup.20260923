<!-- 资产详情弹窗 -->
<div id="asset-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.8);z-index:2000;align-items:center;justify-content:center;backdrop-filter:blur(8px)" onclick="closeAssetModal()">
<div style="background:var(--bg2);border:1px solid var(--gold3);border-radius:16px;padding:40px;max-width:500px;width:90%;position:relative" onclick="event.stopPropagation()">
<div id="modal-cat" style="font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--gold);margin-bottom:8px"></div>
<h3 id="modal-title" style="font-family:'Noto Serif SC',serif;font-size:22px;color:var(--text);margin-bottom:12px"></h3>
<p id="modal-desc" style="font-size:14px;color:var(--text2);line-height:1.8;margin-bottom:20px"></p>
<div style="display:flex;gap:10px">
<button onclick="closeAssetModal()" style="flex:1;padding:12px;background:linear-gradient(135deg,var(--gold),var(--gold3));color:var(--bg);border:none;border-radius:8px;font-size:14px;font-weight:600;cursor:pointer">关闭</button>
</div>
</div>
