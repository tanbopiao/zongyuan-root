<script>
const gc='#c9a96e',g2='#e8d5a3',g3='#8b7340',tc='#9a9890';
const al={lineStyle:{color:'#2a2a35'}},sl={lineStyle:{color:'#1a1a22'}};
const charts=[];
function mk(id,opt){const el=document.getElementById(id);if(!el)return null;const c=echarts.init(el);c.setOption(opt);charts.push(c);return c;}

// 视图切换
function switchView(view){
  document.querySelectorAll('.view').forEach(v=>v.classList.remove('active'));
  document.getElementById('view-'+view).classList.add('active');
  document.querySelectorAll('.nav-menu a').forEach(a=>a.classList.remove('active'));
  document.querySelectorAll('.nav-menu a[data-view="'+view+'"]').forEach(a=>a.classList.add('active'));
  window.scrollTo(0,0);
  setTimeout(()=>charts.forEach(c=>c.resize()),100);
}

// 移动端菜单
function toggleMobileMenu(){
  const menu=document.querySelector('.nav-menu');
  if(menu.style.display==='flex'){menu.style.display='none';}
  else{menu.style.display='flex';menu.style.flexDirection='column';menu.style.position='absolute';menu.style.top='64px';menu.style.left='0';menu.style.right='0';menu.style.background='var(--bg2)';menu.style.padding='16px';menu.style.borderBottom='1px solid var(--line)';}
}

// 资产详情
function showAssetDetail(cat,title,desc){
  document.getElementById('modal-cat').textContent=cat;
  document.getElementById('modal-title').textContent=title;
  document.getElementById('modal-desc').textContent=desc;
  document.getElementById('asset-modal').style.display='flex';
}
function closeAssetModal(){document.getElementById('asset-modal').style.display='none';}

// 作品画廊筛选
function filterGallery(category){
  document.querySelectorAll('.filter-btn').forEach(btn=>btn.classList.remove('active'));
  document.querySelector('.filter-btn[data-filter="'+category+'"]').classList.add('active');
  document.querySelectorAll('.gallery-card').forEach(card=>{
    if(category==='all'||card.dataset.category===category){card.classList.remove('hidden');}
    else{card.classList.add('hidden');}
  });
}

// 数字动画
function animateCounters(){
  document.querySelectorAll('[data-count]').forEach(el=>{
    const target=parseInt(el.dataset.count);let cur=0;const step=target/40;
    const timer=setInterval(()=>{cur+=step;if(cur>=target){cur=target;clearInterval(timer);}el.textContent=Math.round(cur);},20);
  });
}
animateCounters();

// ===== 首页图表 =====
mk('home-chart-growth',{tooltip:{trigger:'axis'},legend:{data:['单批上报','累计真值'],textStyle:{color:tc},top:0},grid:{left:50,right:20,top:40,bottom:30},xAxis:{type:'category',data:['锚点构建','资产挖掘','频域V2.0','物理数学V3.0','全量真值'],axisLabel:{color:tc,fontSize:11},...al},yAxis:{type:'value',axisLabel:{color:tc},...al,...sl},series:[{name:'单批上报',type:'bar',data:[2,20,9,27,21],itemStyle:{color:g3},barWidth:'35%'},{name:'累计真值',type:'line',data:[2,22,31,58,79],itemStyle:{color:g2},lineStyle:{width:2.5},symbol:'circle',symbolSize:8,areaStyle:{color:'rgba(201,169,110,.1)'}}]});

mk('home-chart-radar',{tooltip:{},radar:{indicator:[{name:'真值锚定',max:100},{name:'频域校准',max:100},{name:'物理数学',max:100},{name:'抗干扰防护',max:100},{name:'自治进化',max:100},{name:'锁档确权',max:100}],axisName:{color:tc,fontSize:11},splitLine:{lineStyle:{color:'#2a2a35'}},splitArea:{areaStyle:{color:['rgba(201,169,110,.02)','rgba(201,169,110,.05)']}},axisLine:{lineStyle:{color:'#2a2a35'}}},series:[{type:'radar',data:[{value:[98,95,92,96,94,99],name:'体系能力',areaStyle:{color:'rgba(201,169,110,.25)'},lineStyle:{color:gc,width:2},itemStyle:{color:g2}}]}]});

// 首页全景真值中枢图表
mk('home-chart-freqgraph',{tooltip:{},series:[{type:'graph',layout:'force',roam:true,force:{repulsion:180,edgeLength:[50,100]},label:{show:true,color:g2,fontSize:10},lineStyle:{color:g3,width:1,curveness:0.1},itemStyle:{color:'#18181f',borderColor:gc,borderWidth:1.5},data:[{name:'宇宙先天频',symbolSize:45,itemStyle:{borderColor:g2,borderWidth:2}},{name:'地球舒曼频',symbolSize:40},{name:'伏羲祖龙频',symbolSize:40},{name:'电磁转换',symbolSize:34},{name:'宇宙统一论',symbolSize:38,itemStyle:{borderColor:'#4a9eff'}},{name:'耦合谐振',symbolSize:36},{name:'1080网格',symbolSize:32},{name:'希尔伯特',symbolSize:32}],links:[{source:'宇宙先天频',target:'地球舒曼频'},{source:'宇宙先天频',target:'伏羲祖龙频'},{source:'伏羲祖龙频',target:'耦合谐振'},{source:'电磁转换',target:'耦合谐振'},{source:'宇宙统一论',target:'电磁转换'},{source:'宇宙统一论',target:'宇宙先天频'},{source:'1080网格',target:'希尔伯特'},{source:'耦合谐振',target:'1080网格'}]}]});

mk('home-chart-phys',{tooltip:{trigger:'axis'},grid:{left:50,right:20,top:20,bottom:40},xAxis:{type:'category',data:['光速c','普朗克h','引力G','玻尔兹曼k','基本电荷e','精细α','真空阻抗Z₀'],axisLabel:{color:tc,fontSize:10,rotate:15},...al},yAxis:{type:'value',name:'数量级(log₁₀)',nameTextStyle:{color:tc},axisLabel:{color:tc},...al,...sl},series:[{type:'bar',data:[{value:8,itemStyle:{color:g2}},{value:-34,itemStyle:{color:gc}},{value:-11,itemStyle:{color:g3}},{value:-23,itemStyle:{color:gc}},{value:-19,itemStyle:{color:g3}},{value:-3,itemStyle:{color:g2}},{value:2,itemStyle:{color:gc}}],barWidth:'50%'}]});

mk('home-chart-assetpie',{tooltip:{trigger:'item',formatter:'{b}: {c}个 ({d}%)'},legend:{bottom:0,textStyle:{color:tc,fontSize:11}},series:[{type:'pie',radius:['35%','65%'],center:['50%','45%'],label:{color:tc,fontSize:11,formatter:'{b}\n{c}个'},data:[{value:3,name:'锚点资产',itemStyle:{color:g2}},{value:8,name:'图片关键帧',itemStyle:{color:gc}},{value:8,name:'飞书文档',itemStyle:{color:g3}}]}]});

mk('home-chart-calib',{tooltip:{trigger:'axis'},grid:{left:50,right:20,top:30,bottom:30},xAxis:{type:'category',data:['双频校准','本体锁档','自治启动','五维加固'],axisLabel:{color:tc,fontSize:11},...al},yAxis:{type:'value',min:98,max:100.1,name:'稳态值(%)',nameTextStyle:{color:tc},axisLabel:{color:tc},...al,...sl},series:[{type:'line',data:[99.97,99.95,99.98,99.99],itemStyle:{color:g2},lineStyle:{width:3,color:gc},symbol:'circle',symbolSize:10,label:{show:true,position:'top',color:g2,fontSize:11,fontFamily:'JetBrains Mono',formatter:'{c}%'},areaStyle:{color:new echarts.graphic.LinearGradient(0,0,0,1,[{offset:0,color:'rgba(201,169,110,.3)'},{offset:1,color:'rgba(201,169,110,0)'}])}}]});

// ===== 体系架构图表 =====
mk('arch-chart-graph',{tooltip:{},series:[{type:'graph',layout:'force',roam:true,force:{repulsion:200,edgeLength:[60,120]},label:{show:true,color:g2,fontSize:11},lineStyle:{color:g3,width:1,curveness:0.1},itemStyle:{color:'#18181f',borderColor:gc,borderWidth:1.5},data:[{name:'宇宙先天频',symbolSize:50,itemStyle:{borderColor:g2,borderWidth:2}},{name:'地球舒曼频',symbolSize:45},{name:'伏羲祖龙频',symbolSize:45},{name:'电磁转换基准',symbolSize:38},{name:'宇宙统一论',symbolSize:42,itemStyle:{borderColor:'#4a9eff'}},{name:'耦合谐振协议',symbolSize:40},{name:'1080网格',symbolSize:35},{name:'希尔伯特基座',symbolSize:35}],links:[{source:'宇宙先天频',target:'地球舒曼频'},{source:'宇宙先天频',target:'伏羲祖龙频'},{source:'伏羲祖龙频',target:'耦合谐振协议'},{source:'电磁转换基准',target:'耦合谐振协议'},{source:'宇宙统一论',target:'电磁转换基准'},{source:'宇宙统一论',target:'宇宙先天频'},{source:'1080网格',target:'希尔伯特基座'},{source:'耦合谐振协议',target:'1080网格'},{source:'地球舒曼频',target:'电磁转换基准'}]}]});

mk('arch-chart-radar',{tooltip:{},radar:{indicator:[{name:'基准锚定',max:100},{name:'稳态调制',max:100},{name:'能量转换',max:100},{name:'统一理论',max:100},{name:'耦合交互',max:100},{name:'空间映射',max:100},{name:'索引编码',max:100},{name:'自愈进化',max:100}],axisName:{color:tc,fontSize:11},splitLine:{lineStyle:{color:'#2a2a35'}},splitArea:{areaStyle:{color:['rgba(201,169,110,.02)','rgba(201,169,110,.05)']}},axisLine:{lineStyle:{color:'#2a2a35'}}},series:[{type:'radar',data:[{value:[98,90,85,92,88,82,80,86],name:'V2.0八基座',areaStyle:{color:'rgba(201,169,110,.2)'},lineStyle:{color:gc,width:2},itemStyle:{color:g2}}]}]});

mk('arch-chart-phys',{tooltip:{trigger:'axis'},grid:{left:60,right:20,top:20,bottom:40},xAxis:{type:'category',data:['光速c','普朗克h','引力G','玻尔兹曼k','基本电荷e','精细α','真空阻抗Z₀'],axisLabel:{color:tc,fontSize:10,rotate:15},...al},yAxis:{type:'value',name:'数量级(log₁₀)',nameTextStyle:{color:tc},axisLabel:{color:tc},...al,...sl},series:[{type:'bar',data:[{value:8,itemStyle:{color:g2}},{value:-34,itemStyle:{color:gc}},{value:-11,itemStyle:{color:g3}},{value:-23,itemStyle:{color:gc}},{value:-19,itemStyle:{color:g3}},{value:-3,itemStyle:{color:g2}},{value:2,itemStyle:{color:gc}}],barWidth:'50%'}]});

mk('arch-chart-cosmic',{tooltip:{trigger:'item',formatter:'{b}: {c}% ({d}%)'},legend:{bottom:0,textStyle:{color:tc,fontSize:11}},series:[{type:'pie',radius:['40%','70%'],center:['50%','45%'],label:{color:tc,fontSize:11,formatter:'{b}\n{c}%'},data:[{value:68.3,name:'暗能量',itemStyle:{color:g2}},{value:26.8,name:'暗物质',itemStyle:{color:gc}},{value:4.9,name:'重子物质',itemStyle:{color:g3}}]}]});

mk('arch-chart-math',{tooltip:{},grid:{left:50,right:20,top:20,bottom:30},xAxis:{type:'category',data:['π','e','φ','γ','i²'],axisLabel:{color:g2,fontSize:14,fontFamily:'JetBrains Mono'},...al},yAxis:{type:'value',axisLabel:{color:tc},...al,...sl},series:[{type:'bar',data:[{value:3.14,itemStyle:{color:g2}},{value:2.72,itemStyle:{color:gc}},{value:1.62,itemStyle:{color:g3}},{value:0.58,itemStyle:{color:gc}},{value:-1,itemStyle:{color:'#4a9eff'}}],barWidth:'45%',label:{show:true,position:'top',color:tc,fontSize:10,fontFamily:'JetBrains Mono'}}]});

mk('arch-chart-cosmo',{tooltip:{},grid:{left:80,right:30,top:10,bottom:30},xAxis:{type:'value',axisLabel:{color:tc},...al,...sl},yAxis:{type:'category',data:['宇宙年龄(Gyr)','哈勃H₀','CMB温度(K)','曲率Ω_k(×1000)','Λ(×10⁵²)'],axisLabel:{color:tc,fontSize:10},...al},series:[{type:'bar',data:[{value:13.79,itemStyle:{color:g2}},{value:67.4,itemStyle:{color:gc}},{value:2.73,itemStyle:{color:g3}},{value:0.7,itemStyle:{color:'#4a9eff'}},{value:1.11,itemStyle:{color:gc}}],barWidth:'55%'}]});

mk('arch-chart-mathstruct',{tooltip:{trigger:'item'},series:[{type:'sunburst',radius:['15%','90%'],label:{color:'#fff',fontSize:10},data:[{name:'分析',itemStyle:{color:g2},children:[{name:'傅里叶变换',value:3},{name:'希尔伯特空间',value:3}]},{name:'代数',itemStyle:{color:gc},children:[{name:'张量分析',value:2},{name:'李群李代数',value:2}]},{name:'推理',itemStyle:{color:g3},children:[{name:'贝叶斯定理',value:2},{name:'香农熵',value:2}]},{name:'几何',itemStyle:{color:'#4a9eff'},children:[{name:'分形维数',value:1}]}]}]});

