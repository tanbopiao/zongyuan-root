  "tasks": [
    {
      "name": "gateway_steady_probe",
      "interval_sec": 1800,
      "enabled": true,
      "cmd": [
        "python3",
        "{scripts}/steady_evolve.py",
        "run",
        "gateway_steady_probe"
      ],
      "desc": "心跳新鲜度+基础状态探针: heartbeat滞后>6h 或 status不可达 → 告警(带去重, 每告警窗最多一次)",
      "risk": "low"
    },
    {
      "name": "endpoint_contract_check",
      "interval_sec": 21600,
      "enabled": true,
      "cmd": [
        "python3",
        "{scripts}/steady_evolve.py",
        "run",
        "endpoint_contract_check"
      ],
      "desc": "端点契约探测: 已文档化端点200/404实测, 漂移写入报告+告警, 消除文档指空路",
      "risk": "low"
    },
    {
      "name": "atomcode_auto_renew",
      "interval_sec": 21600,
      "enabled": true,
      "cmd": [
        "/usr/local/bin/atomcode_auto_renew.sh"
      ],
      "desc": "AtomCode CodingPlan Lite 自动续领(幂等非交互, 以输出含Plan:为成功); 二进制缺失时自检标记skip并上报",
      "requires_bin": "atomcode",
      "risk": "low"
    },
    {
      "name": "runstate_selfcheck",
      "interval_sec": 86400,
      "enabled": true,
      "cmd": [
        "python3",
        "{scripts}/steady_evolve.py",
        "run",
        "runstate_selfcheck"
      ],
      "desc": "运行态自检: 调度器存活/crontab缺失漂移/日志文件缺失/git工作区漂移汇总, 产出日检JSON",
      "risk": "low"
    },
    {
      "name": "lite_registry_check",
      "interval_sec": 43200,
      "enabled": true,
      "cmd": [
        "python3",
        "{root}/00_KERNEL/lite_replicate/lite_replicate.py",
        "verify",
        "--all"
      ],
      "desc": "12h 跑 LITE-REPLICATE-V1 在册工程测试(unittest零依赖), 失败记录last_check_fail并入台账 (S4持久运行)",
      "risk": "low"
    },
    {
      "name": "tri_distill_round",
      "interval_sec": 86400,
      "enabled": false,
      "enabled_on": [
        "cloud-hub"
      ],
      "cmd": [
        "python3",
        "{root}/00_KERNEL/tri_distill/tri_distill.py",
        "round"
      ],
      "desc": "24h 三维算力蒸馏轮(TRI-DISTILL-V1): Q×C×L 测量全部enabled基座→蒸馏路由→写记忆内核(DISTILL.ROUND/ROUTING键)。执行位=云端daemon(基座127.0.0.1:18081在云端; 本机禁用防127.0.0.1不通污染ROUTING)",
      "risk": "low"
    },
    {
