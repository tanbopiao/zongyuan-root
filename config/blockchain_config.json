{
  "blockchain": {
    "enabled": false,
    "note": "设置enabled=true并配置private_key后自动切换真实上链模式",
    "default_chain": "polygon_mumbai",
    "chains": {
      "polygon_mumbai": {
        "rpc": "https://rpc-mumbai.maticvigil.com",
        "chain_id": 80001,
        "currency": "MATIC",
        "explorer": "https://mumbai.polygonscan.com/tx/",
        "faucet": "https://faucet.polygon.technology/",
        "note": "测试网，免费获取测试MATIC"
      },
      "polygon_mainnet": {
        "rpc": "https://polygon-rpc.com",
        "chain_id": 137,
        "currency": "MATIC",
        "explorer": "https://polygonscan.com/tx/",
        "note": "主网，约$0.01/笔，推荐生产环境",
        "estimated_cost_per_anchor_usd": 0.01,
        "estimated_daily_cost_usd": 0.01
      },
      "ethereum_mainnet": {
        "rpc": "https://eth.llamarpc.com",
        "chain_id": 1,
        "currency": "ETH",
        "explorer": "https://etherscan.io/tx/",
        "note": "最高安全性，约$1~5/笔，建议每周锚定一次",
        "estimated_cost_per_anchor_usd": 2.0,
        "recommended_frequency": "weekly"
      }
    },
    "anchor_contract": {
      "address": "",
      "note": "部署TruthAnchor.sol后填入合约地址",
      "deploy_command": "python3 contracts/deploy_anchor.py deploy --chain polygon_mumbai --key <PRIVATE_KEY>"
    },
    "private_key": {
      "source": "environment_variable",
      "env_var": "ANCHOR_PRIVATE_KEY",
      "note": "私钥通过环境变量传入，不要硬编码到配置文件中",
      "security_note": "使用专用钱包，仅存入锚定所需的少量Gas费"
    },
    "anchor_strategy": {
      "daily_chain": "polygon_mainnet",
      "weekly_chain": "ethereum_mainnet",
      "daily_merkle_root": true,
      "weekly_aggregate": true,
      "note": "每日Polygon锚定 + 每周以太坊聚合锚定，兼顾成本和安全"
    }
  },
  "setup_checklist": [
    "1. 创建专用加密钱包 (MetaMask等)",
    "2. 获取测试网MATIC (faucet.polygon.technology)",
    "3. 部署TruthAnchor合约到测试网",
    "4. 测试锚定功能",
    "5. 切换到Polygon主网",
    "6. 配置每日自动锚定 (cron/timer)",
    "7. (可选) 配置每周以太坊聚合锚定"
  ]
}
