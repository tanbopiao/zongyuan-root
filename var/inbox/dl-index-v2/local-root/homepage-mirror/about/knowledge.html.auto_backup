<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>全域知识图谱 | 火斗云智AIOS</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{background:#0a0e17;color:#e5e7eb;font-family:'PingFang SC','Microsoft YaHei',sans-serif;line-height:1.6}
.container{max-width:1200px;margin:0 auto;padding:24px}
.hero{text-align:center;padding:40px 20px 30px;margin-bottom:30px;background:linear-gradient(180deg,rgba(212,175,55,0.08),transparent);border-radius:16px;border:1px solid rgba(212,175,55,0.15)}
.hero h1{font-size:32px;font-weight:800;margin-bottom:10px;background:linear-gradient(90deg,#D4AF37,#F4E4BC,#D4AF37);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.hero p{font-size:14px;color:#9ca3af;max-width:700px;margin:0 auto}
.hero-anchor{font-size:11px;color:#D4AF37;letter-spacing:2px;margin-top:12px}
.section{margin-bottom:30px}
.section-title{font-size:18px;font-weight:600;margin-bottom:16px;display:flex;align-items:center;gap:10px;color:#D4AF37}
.section-title::before{content:"";width:4px;height:22px;background:linear-gradient(180deg,#D4AF37,#8B6914);border-radius:2px}
.grid-3{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:16px}
.grid-4{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px}
.card{background:rgba(255,255,255,0.03);border:1px solid rgba(212,175,55,0.15);border-radius:12px;padding:20px;transition:all .3s}
.card:hover{border-color:rgba(212,175,55,0.4);transform:translateY(-2px);box-shadow:0 8px 24px rgba(212,175,55,0.1)}
.card-icon{font-size:32px;margin-bottom:10px}
.card-title{font-size:15px;font-weight:600;color:#D4AF37;margin-bottom:8px}
.card-desc{font-size:12px;color:#9ca3af;line-height:1.7}
.card-tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:12px}
.tag{font-size:10px;padding:3px 10px;background:rgba(212,175,55,0.1);border:1px solid rgba(212,175,55,0.2);border-radius:12px;color:#D4AF37}
.timeline{position:relative;padding-left:30px}
.timeline::before{content:"";position:absolute;left:8px;top:0;bottom:0;width:2px;background:linear-gradient(180deg,#D4AF37,#8B6914)}
.timeline-item{position:relative;margin-bottom:20px}
.timeline-item::before{content:"";position:absolute;left:-26px;top:6px;width:12px;height:12px;border-radius:50%;background:#D4AF37;border:2px solid #0a0e17}
.timeline-title{font-size:14px;font-weight:600;color:#D4AF37;margin-bottom:4px}
.timeline-desc{font-size:12px;color:#9ca3af;line-height:1.6}
.formula-box{background:rgba(212,175,55,0.05);border:1px solid rgba(212,175,55,0.2);border-radius:10px;padding:16px;margin:12px 0;font-family:'Courier New',monospace;font-size:13px;color:#F4E4BC;overflow-x:auto}
.stats-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px;margin-bottom:24px}
.stat-card{background:rgba(255,255,255,0.03);border:1px solid rgba(212,175,55,0.15);border-radius:10px;padding:16px;text-align:center}
.stat-value{font-size:28px;font-weight:700;color:#D4AF37;margin-bottom:4px}
.stat-label{font-size:11px;color:#6b7280}
.footer{text-align:center;padding:30px 20px;border-top:1px solid rgba(212,175,55,0.15);margin-top:40px}
.footer-text{font-size:11px;color:#6b7280}
.footer-anchor{font-size:10px;color:#D4AF37;margin-top:8px;letter-spacing:1px}

.graph-container{width:100%;height:500px;background:rgba(255,255,255,0.02);border:1px solid rgba(212,175,55,0.15);border-radius:12px;position:relative;overflow:hidden}
.node{position:absolute;width:80px;height:80px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:600;color:#fff;text-align:center;cursor:pointer;transition:all .3s;border:2px solid rgba(212,175,55,0.3)}
.node:hover{transform:scale(1.1);border-color:#D4AF37;box-shadow:0 0 20px rgba(212,175,55,0.5)}
.edge{position:absolute;height:2px;background:linear-gradient(90deg,rgba(212,175,55,0.3),rgba(212,175,55,0.1));transform-origin:left center;z-index:0}

/* 移动端响应式适配 */
@media (max-width: 768px) {
  .container { padding: 12px !important; }
  .hero { padding: 24px 16px 20px !important; }
  .hero h1 { font-size: 22px !important; }
  .hero p { font-size: 12px !important; }
  .section-title { font-size: 16px !important; }
  .grid-3, .grid-4 { grid-template-columns: 1fr !important; gap: 10px !important; }
  .card { padding: 14px !important; }
  .card-title { font-size: 13px !important; }
  .card-desc { font-size: 11px !important; }
  .stats-row { grid-template-columns: repeat(2, 1fr) !important; gap: 8px !important; }
  .stat-value { font-size: 20px !important; }
  .stat-label { font-size: 10px !important; }
  .timeline { padding-left: 20px !important; }
  .timeline-item::before { left: -18px !important; width: 10px !important; height: 10px !important; }
  .timeline-title { font-size: 13px !important; }
  .timeline-desc { font-size: 11px !important; }
  .formula-box { font-size: 11px !important; padding: 10px !important; overflow-x: auto; }
  .footer { padding: 20px 12px !important; }
  .footer-text { font-size: 10px !important; }
  /* 导航栏移动端适配 */
  nav, .nav-container, [class*="nav"] { flex-wrap: wrap !important; gap: 4px !important; }
  nav a, .nav-container a, [class*="nav"] a { font-size: 11px !important; padding: 4px 8px !important; }
}
@media (max-width: 480px) {
  .hero h1 { font-size: 18px !important; }
  .stats-row { grid-template-columns: 1fr !important; }
  .card-icon { font-size: 24px !important; }
}
</style>
