[unix_http_server]
file=/home/user/ZONGYUAN-ROOT/run/zongyuan-supervisor.sock
chmod=0700

[supervisord]
nodaemon=false
pidfile=/home/user/ZONGYUAN-ROOT/run/zongyuan-supervisord.pid
logfile=/home/user/ZONGYUAN-ROOT/logs/zongyuan-supervisord.log
logfile_maxbytes=5MB
logfile_backups=2
loglevel=info

[supervisorctl]
serverurl=unix:///home/user/ZONGYUAN-ROOT/run/zongyuan-supervisor.sock

[rpcinterface:supervisor]
supervisor.rpcinterface_factory=supervisor.rpcinterface:make_main_rpcinterface

# 本地记忆网关(8077) - 本地真值优先提炼
[program:zongyuan-memory-gateway]
command=/opt/python3.12/bin/python3 /home/user/ZONGYUAN-ROOT/memory_gateway.py
autostart=true
autorestart=true
startsecs=5
priority=500
user=user
stdout_logfile=/home/user/ZONGYUAN-ROOT/logs/zongyuan-memory-gateway.log
stdout_logfile_maxbytes=5MB
stdout_logfile_backups=2
redirect_stderr=true

# 本地向量语义召回(8003) - 本地化语义索引
[program:zongyuan-vector-server]
command=/opt/python3.12/bin/python3 /home/user/ZONGYUAN-ROOT/ai-native-ops/vector_server.py
autostart=true
autorestart=true
startsecs=10
priority=510
user=user
stdout_logfile=/home/user/ZONGYUAN-ROOT/logs/zongyuan-vector-server.log
stdout_logfile_maxbytes=5MB
stdout_logfile_backups=2
redirect_stderr=true

# ANCE AI原生云运维API(8002)
[program:zongyuan-ance-api]
command=/opt/python3.12/bin/python3 /home/user/ZONGYUAN-ROOT/ai-native-ops/api_server.py
autostart=true
autorestart=true
startsecs=10
priority=520
user=user
stdout_logfile=/home/user/ZONGYUAN-ROOT/logs/zongyuan-ance-api.log
stdout_logfile_maxbytes=5MB
stdout_logfile_backups=2
redirect_stderr=true

# 轻量监控面板(8004)
[program:zongyuan-monitor]
command=/opt/python3.12/bin/python3 /home/user/ZONGYUAN-ROOT/ai-native-ops/monitor_server.py
autostart=true
autorestart=true
startsecs=10
priority=530
user=user
stdout_logfile=/home/user/ZONGYUAN-ROOT/logs/zongyuan-monitor.log
stdout_logfile_maxbytes=5MB
stdout_logfile_backups=2
redirect_stderr=true
