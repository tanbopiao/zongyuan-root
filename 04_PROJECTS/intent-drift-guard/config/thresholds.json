    "warn_ratio": 0.8,
    "critical_ratio": 0.95,
    "quota_file": "config/platform_quota.json"
  },
  "circuit": {"l1_to_l2_count": 2, "l2_to_l3_count": 3, "l1_clear_clean_steps": 3},
  "runtime": {
    "workdir": "",
    "log_dir": "logs",
    "report_dir": "reports",
    "workorder_dir": "workorders",
    "anchor_dir": "anchor_store"
  }
