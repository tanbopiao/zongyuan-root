page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}
.container {
  padding: 20rpx;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
}
.btn-primary {
  background: linear-gradient(135deg, #1a1a2e, #16213e);
  color: #ffd700;
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
  font-weight: 600;
}
