.container { padding: 20rpx; }
.search-box { display: flex; align-items: center; background: #fff; border-radius: 12rpx; padding: 10rpx 20rpx; margin-bottom: 20rpx; }
.search-input { flex: 1; font-size: 28rpx; padding: 16rpx 0; }
.search-btn { color: #ffd700; font-size: 28rpx; padding: 0 20rpx; }
.category-scroll { white-space: nowrap; margin-bottom: 20rpx; }
.category-list { display: inline-flex; }
.category-item { display: inline-block; padding: 12rpx 28rpx; margin-right: 16rpx; background: #fff; border-radius: 30rpx; font-size: 26rpx; color: #666; }
.category-item.active { background: linear-gradient(135deg, #1a1a2e, #16213e); color: #ffd700; }
.policy-card { background: #fff; border-radius: 16rpx; padding: 30rpx; margin-bottom: 20rpx; }
.policy-title { font-size: 30rpx; font-weight: 600; color: #1a1a2e; margin-bottom: 12rpx; }
.policy-desc { font-size: 26rpx; color: #666; line-height: 1.6; margin-bottom: 16rpx; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.policy-footer { display: flex; justify-content: space-between; }
.policy-cat { font-size: 22rpx; color: #ffd700; background: #fffbe6; padding: 4rpx 16rpx; border-radius: 8rpx; }
.policy-date { font-size: 22rpx; color: #999; }
.empty { text-align: center; padding: 100rpx; color: #999; font-size: 28rpx; }
