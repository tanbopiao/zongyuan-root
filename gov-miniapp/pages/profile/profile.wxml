<view class="container">
  <view class="user-card">
    <view class="avatar">👤</view>
    <view class="user-info">
      <view class="username">政务用户</view>
      <view class="user-desc">点击登录获取更多服务</view>
    </view>
    <text class="login-btn" bindtap="login">登录</text>
  </view>
  <view class="menu-section">
    <view class="menu-title">我的服务</view>
    <view class="menu-grid">
      <view class="menu-item" bindtap="goFavorites">
        <text class="menu-icon">⭐</text>
        <text class="menu-text">我的收藏</text>
      </view>
      <view class="menu-item" bindtap="goAppointments">
        <text class="menu-icon">📅</text>
        <text class="menu-text">我的预约</text>
      </view>
      <view class="menu-item" bindtap="goHistory">
        <text class="menu-icon">📝</text>
        <text class="menu-text">浏览历史</text>
      </view>
      <view class="menu-item" bindtap="goFeedback">
        <text class="menu-icon">💬</text>
        <text class="menu-text">意见反馈</text>
      </view>
    </view>
  </view>
  <view class="menu-section">
    <view class="menu-title">设置</view>
    <view class="setting-list">
      <view class="setting-item" bindtap="goSetting">
        <text class="setting-text">通用设置</text>
        <text class="arrow">></text>
      </view>
      <view class="setting-item" bindtap="goAbout">
        <text class="setting-text">关于我们</text>
        <text class="arrow">></text>
      </view>
      <view class="setting-item" bindtap="clearCache">
        <text class="setting-text">清除缓存</text>
        <text class="arrow">></text>
      </view>
    </view>
  </view>
  <view class="version">政务AI助手 v1.0.0</view>
</view>
