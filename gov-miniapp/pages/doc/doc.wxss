.container { padding: 20rpx; }
.header { text-align: center; padding: 40rpx 0; }
.title { font-size: 40rpx; font-weight: 700; color: #1a1a2e; margin-bottom: 10rpx; }
.subtitle { font-size: 26rpx; color: #999; }
.form-card { background: #fff; border-radius: 16rpx; padding: 30rpx; margin-bottom: 20rpx; }
.form-item { margin-bottom: 30rpx; }
.label { display: block; font-size: 28rpx; color: #333; margin-bottom: 12rpx; font-weight: 600; }
.picker { padding: 20rpx; background: #f8f9fa; border-radius: 10rpx; font-size: 28rpx; color: #333; }
.input { padding: 20rpx; background: #f8f9fa; border-radius: 10rpx; font-size: 28rpx; }
.textarea { width: 100%; height: 200rpx; padding: 20rpx; background: #f8f9fa; border-radius: 10rpx; font-size: 28rpx; box-sizing: border-box; }
.generate-btn { background: linear-gradient(135deg, #1a1a2e, #16213e); color: #ffd700; font-size: 30rpx; padding: 24rpx 0; border-radius: 12rpx; border: none; }
.result-card { background: #fff; border-radius: 16rpx; padding: 30rpx; margin-bottom: 20rpx; }
.result-title { font-size: 30rpx; font-weight: 600; color: #1a1a2e; margin-bottom: 20rpx; }
.result-content { font-size: 28rpx; color: #333; line-height: 1.8; white-space: pre-wrap; margin-bottom: 20rpx; }
.result-actions { display: flex; gap: 20rpx; }
.copy-btn, .save-btn { flex: 1; font-size: 26rpx; padding: 16rpx 0; border-radius: 10rpx; border: none; }
.copy-btn { background: #f0f0f0; color: #333; }
.save-btn { background: #4caf50; color: #fff; }
.history-section { background: #fff; border-radius: 16rpx; padding: 30rpx; }
.section-title { font-size: 30rpx; font-weight: 600; color: #1a1a2e; margin-bottom: 20rpx; }
.history-item { padding: 20rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.history-item:last-child { border-bottom: none; }
.history-title { font-size: 28rpx; color: #333; margin-bottom: 8rpx; }
.history-type { font-size: 24rpx; color: #ffd700; display: inline-block; margin-right: 16rpx; }
.history-time { font-size: 22rpx; color: #999; }
