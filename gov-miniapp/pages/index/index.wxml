<view class="container">
  <view class="banner">
    <view class="banner-title">政务AI助手</view>
    <view class="banner-sub">智能问答 · 政策查询 · 办事指南 · 公文写作</view>
  </view>
  
  <view class="search-bar" bindtap="goPolicy">
    <text class="search-icon">🔍</text>
    <text class="search-placeholder">搜索政策、办事指南...</text>
  </view>
  
  <view class="quick-entry">
    <view class="entry-item" bindtap="goChat">
      <view class="entry-icon">🤖</view>
      <text class="entry-text">智能问答</text>
    </view>
    <view class="entry-item" bindtap="goPolicy">
      <view class="entry-icon">📋</view>
      <text class="entry-text">政策查询</text>
    </view>
    <view class="entry-item" bindtap="goGuide">
      <view class="entry-icon">📝</view>
      <text class="entry-text">办事指南</text>
    </view>
    <view class="entry-item" bindtap="goDoc">
      <view class="entry-icon">✍️</view>
      <text class="entry-text">公文写作</text>
    </view>
  </view>
  
  <view class="section">
    <view class="section-title">
      <text>🔥 热门政策</text>
      <text class="more" bindtap="goPolicy">更多 ></text>
    </view>
    <view class="policy-list">
      <view class="policy-item" wx:for="{{hotPolicies}}" wx:key="id" bindtap="viewPolicy" data-id="{{item.id}}">
        <view class="policy-title">{{item.title}}</view>
        <view class="policy-meta">
          <text class="policy-category">{{item.category}}</text>
          <text class="policy-date">{{item.date}}</text>
        </view>
      </view>
    </view>
  </view>
  
  <view class="section">
    <view class="section-title">
      <text>📌 常用办事</text>
      <text class="more" bindtap="goGuide">更多 ></text>
    </view>
    <view class="guide-grid">
      <view class="guide-item" wx:for="{{hotGuides}}" wx:key="id" bindtap="viewGuide" data-id="{{item.id}}">
        <text class="guide-name">{{item.title}}</text>
      </view>
    </view>
  </view>
</view>
