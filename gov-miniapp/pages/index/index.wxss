.container { padding-bottom: 20rpx; }
.banner { background: linear-gradient(135deg, #1a1a2e, #16213e); padding: 60rpx 30rpx 40rpx; }
.banner-title { font-size: 44rpx; font-weight: 700; color: #ffd700; margin-bottom: 10rpx; }
.banner-sub { font-size: 26rpx; color: #aaa; }
.search-bar { display: flex; align-items: center; margin: -30rpx 30rpx 20rpx; padding: 24rpx; background: #fff; border-radius: 16rpx; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1); }
.search-icon { font-size: 32rpx; margin-right: 16rpx; }
.search-placeholder { font-size: 28rpx; color: #999; }
.quick-entry { display: flex; justify-content: space-around; padding: 30rpx; background: #fff; margin: 0 30rpx 20rpx; border-radius: 16rpx; }
.entry-item { display: flex; flex-direction: column; align-items: center; }
.entry-icon { font-size: 48rpx; margin-bottom: 10rpx; }
.entry-text { font-size: 24rpx; color: #333; }
.section { background: #fff; margin: 0 30rpx 20rpx; padding: 30rpx; border-radius: 16rpx; }
.section-title { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; font-size: 32rpx; font-weight: 600; color: #1a1a2e; }
.more { font-size: 24rpx; color: #999; font-weight: 400; }
.policy-item { padding: 20rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.policy-item:last-child { border-bottom: none; }
.policy-title { font-size: 28rpx; color: #333; margin-bottom: 10rpx; }
.policy-meta { display: flex; justify-content: space-between; font-size: 22rpx; color: #999; }
.policy-category { color: #ffd700; background: #fffbe6; padding: 4rpx 12rpx; border-radius: 8rpx; }
.guide-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.guide-item { padding: 24rpx; background: #f8f9fa; border-radius: 12rpx; text-align: center; font-size: 26rpx; color: #333; }
