<view class="container">
  <view class="category-tabs">
    <view class="tab-item {{currentTab === index ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="*this" bindtap="switchTab" data-index="{{index}}">{{item}}</view>
  </view>
  <view class="guide-list">
    <view class="guide-card" wx:for="{{guides}}" wx:key="id">
      <view class="guide-header">
        <text class="guide-title">{{item.title}}</text>
        <text class="guide-tag">{{item.category}}</text>
      </view>
      <view class="guide-info">
        <view class="info-row"><text class="label">办理条件：</text><text class="value">{{item.conditions}}</text></view>
        <view class="info-row"><text class="label">办理地点：</text><text class="value">{{item.location}}</text></view>
        <view class="info-row"><text class="label">咨询电话：</text><text class="value">{{item.phone}}</text></view>
      </view>
      <view class="guide-actions">
        <button class="action-btn detail" bindtap="viewDetail" data-id="{{item.id}}">查看详情</button>
        <button class="action-btn book" bindtap="bookAppointment" data-id="{{item.id}}">立即预约</button>
      </view>
    </view>
    <view class="empty" wx:if="{{guides.length === 0}}">暂无办事指南</view>
  </view>
</view>
