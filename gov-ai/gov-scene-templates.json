{
  "version": "V4.0",
  "scenes": [
    {
      "id": "GOV-001",
      "name": "公文智能拟稿场景",
      "category": "公文处理",
      "description": "公文自动拟稿、智能校对、合规审查、错漏纠错全流程",
      "components": [
        {
          "type": "data-source",
          "name": "公文数据源接入",
          "config": {
            "source": "政务OA系统",
            "format": "docx/pdf"
          }
        },
        {
          "type": "data-mask",
          "name": "敏感信息脱敏",
          "config": {
            "level": "L2-中度脱敏",
            "fields": [
              "身份证号",
              "手机号",
              "住址"
            ]
          }
        },
        {
          "type": "ai-doc",
          "name": "公文智能解析",
          "config": {
            "model": "doubao-seed-2.0-lite",
            "extract": [
              "标题",
              "主送机关",
              "正文",
              "落款"
            ]
          }
        },
        {
          "type": "ai-review",
          "name": "合规审查",
          "config": {
            "rules": [
              "格式规范",
              "政策依据",
              "敏感词",
              "涉密检查"
            ]
          }
        },
        {
          "type": "flow-approve",
          "name": "人工审批",
          "config": {
            "approver_role": "办公室主任",
            "timeout": 24
          }
        },
        {
          "type": "out-doc",
          "name": "正式文书生成",
          "config": {
            "format": "docx",
            "template": "党政机关公文格式GB/T 9704"
          }
        }
      ],
      "expected_output": "符合规范的正式公文文档",
      "compliance_level": "L2"
    },
    {
      "id": "GOV-002",
      "name": "政策智能解读场景",
      "category": "政策研究",
      "description": "政策智能解读、新旧政策比对、条文差异分析",
      "components": [
        {
          "type": "data-source",
          "name": "政策文件接入",
          "config": {
            "source": "政府公报/政策库"
          }
        },
        {
          "type": "ai-policy",
          "name": "政策智能比对",
          "config": {
            "compare": "新旧版本",
            "dimension": [
              "条文变更",
              "权限调整",
              "流程变化"
            ]
          }
        },
        {
          "type": "ai-law",
          "name": "法条关联检索",
          "config": {
            "source": "法律法规库"
          }
        },
        {
          "type": "ai-qa",
          "name": "政策问答生成",
          "config": {
            "type": "FAQ",
            "count": 10
          }
        },
        {
          "type": "out-report",
          "name": "解读报告生成",
          "config": {
            "format": "pdf",
            "include": [
              "差异对照表",
              "影响分析",
              "实施建议"
            ]
          }
        }
      ],
      "expected_output": "政策解读报告+FAQ问答库",
      "compliance_level": "L1"
    },
    {
      "id": "GOV-003",
      "name": "办事事项预审场景",
      "category": "政务服务",
      "description": "事项智能预审、材料缺件提醒、自查纠错",
      "components": [
        {
          "type": "data-source",
          "name": "申报材料接入",
          "config": {
            "source": "政务服务网"
          }
        },
        {
          "type": "data-clean",
          "name": "材料格式校验",
          "config": {
            "check": [
              "完整性",
              "格式",
              "有效期"
            ]
          }
        },
        {
          "type": "ai-review",
          "name": "材料智能纠错",
          "config": {
            "rules": [
              "必填项",
              "逻辑一致性",
              "格式规范"
            ]
          }
        },
        {
          "type": "sec-fuse",
          "name": "风险熔断",
          "config": {
            "trigger": "材料缺失>3项",
            "action": "退回补正"
          }
        },
        {
          "type": "out-report",
          "name": "预审结论输出",
          "config": {
            "include": [
              "缺件清单",
              "修改建议",
              "通过/不通过"
            ]
          }
        }
      ],
      "expected_output": "预审结论+缺件清单+修改建议",
      "compliance_level": "L2"
    },
    {
      "id": "GOV-004",
      "name": "政务舆情研判场景",
      "category": "舆情监测",
      "description": "舆情智能抓取、风险分级、态势研判、台账生成",
      "components": [
        {
          "type": "data-source",
          "name": "多源舆情接入",
          "config": {
            "sources": [
              "微博",
              "微信",
              "新闻",
              "论坛"
            ]
          }
        },
        {
          "type": "data-filter",
          "name": "舆情筛选",
          "config": {
            "keywords": "政务相关",
            "dedup": true
          }
        },
        {
          "type": "ai-qa",
          "name": "舆情智能研判",
          "config": {
            "dimension": [
              "情感倾向",
              "传播热度",
              "风险等级"
            ]
          }
        },
        {
          "type": "sec-fuse",
          "name": "高风险预警",
          "config": {
            "trigger": "P0级舆情",
            "action": "即时上报"
          }
        },
        {
          "type": "out-screen",
          "name": "舆情大屏展示",
          "config": {
            "charts": [
              "趋势图",
              "热点词云",
              "风险分布"
            ]
          }
        }
      ],
      "expected_output": "舆情研判报告+大屏可视化+预警台账",
      "compliance_level": "L3"
    },
    {
      "id": "GOV-005",
      "name": "知识库智能问答场景",
      "category": "知识服务",
      "description": "政务知识库问答、办事指南生成、政策咨询应答",
      "components": [
        {
          "type": "data-source",
          "name": "知识库接入",
          "config": {
            "source": "VectorDB向量库",
            "type": "RAG"
          }
        },
        {
          "type": "ai-qa",
          "name": "智能问答",
          "config": {
            "model": "doubao-seed-2.0-lite",
            "top_k": 5,
            "threshold": 0.7
          }
        },
        {
          "type": "flow-if",
          "name": "置信度判断",
          "config": {
            "condition": "置信度<0.7",
            "action": "转人工"
          }
        },
        {
          "type": "flow-approve",
          "name": "人工复核",
          "config": {
            "trigger": "低置信度/敏感问题"
          }
        },
        {
          "type": "out-doc",
          "name": "问答记录归档",
          "config": {
            "audit": true,
            "retention": "3年"
          }
        }
      ],
      "expected_output": "智能问答服务+知识沉淀",
      "compliance_level": "L2"
    },
    {
      "id": "GOV-006",
