SCENE_TEMPLATES = [
    {"id": "GOV-001", "name": "公文智能拟稿场景", "desc": "公文自动拟稿、校对、合规审查、错漏纠错"},
    {"id": "GOV-002", "name": "政策智能解读场景", "desc": "政策解读、新旧比对、条文差异分析"},
