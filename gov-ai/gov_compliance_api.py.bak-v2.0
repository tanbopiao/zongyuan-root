    {"id": "GOV-004", "name": "政务舆情研判场景", "desc": "舆情抓取、风险分级、态势研判、台账生成"},
    {"id": "GOV-005", "name": "知识库智能问答场景", "desc": "政务知识库问答、办事指南生成、政策咨询"},
