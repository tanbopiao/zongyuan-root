<!-- 合规审查 -->
<div class="page" id="page-compliance">
  <div class="tool-card">
    <h3>🛡️ 政务合规审查</h3>
    <textarea id="complianceInput" placeholder="请输入需要审查的文本内容...支持敏感词过滤、涉密拦截、违规提问识别、行政用语校验"></textarea>
    <div class="tool-actions">
      <button class="tool-btn primary" onclick="runComplianceCheck()">🔍 开始审查</button>
      <button class="tool-btn secondary" onclick="document.getElementById('complianceInput').value=''">🗑️ 清空</button>
    </div>
    <div id="complianceResult"></div>
  </div>
  <div class="tool-card">
    <h3>📋 审查说明</h3>
    <div style="font-size:13px;color:var(--text2);line-height:1.8">
      <p>• <strong>敏感词过滤</strong>：三级敏感词库（高/中/低）自动检测</p>
      <p>• <strong>涉密拦截</strong>：密级、保密期限、内部资料自动识别拦截</p>
      <p>• <strong>违规提问</strong>：行贿、逃避监管、泄露机密等模式识别</p>
      <p>• <strong>用语规范</strong>：行政用语规范性校验，不规范用语提示替换</p>
    </div>
  </div>
</div>

