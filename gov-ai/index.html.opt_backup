  <div class="modal" id="esignModal">
  <div class="modal-content" style="max-width:500px">
    <div class="modal-header">
      <span>🔖 电子签章</span>
      <span class="modal-close" onclick="document.getElementById('esignModal').classList.remove('active')">&times;</span>
    </div>
    <div class="modal-body">
      <div style="margin-bottom:16px">
        <label style="display:block;font-size:13px;font-weight:600;margin-bottom:8px;color:var(--text2)">选择签章</label>
        <select id="esignSelect" style="width:100%;padding:10px;border:1px solid var(--border);border-radius:6px;background:var(--bg);color:var(--text)">
          <option value="official">政务中台公章</option>
          <option value="contract">合同专用章</option>
        </select>
      </div>
      <div style="margin-bottom:16px">
        <label style="display:block;font-size:13px;font-weight:600;margin-bottom:8px;color:var(--text2)">签章位置</label>
        <select id="esignPosition" style="width:100%;padding:10px;border:1px solid var(--border);border-radius:6px;background:var(--bg);color:var(--text)">
          <option value="bottom-right">右下角</option>
          <option value="bottom-left">左下角</option>
          <option value="top-right">右上角</option>
          <option value="end">文档末尾</option>
        </select>
      </div>
      <div style="margin-bottom:16px;padding:12px;background:rgba(255,215,0,0.08);border:1px solid rgba(255,215,0,0.2);border-radius:6px">
        <div style="font-size:12px;color:var(--text2)">
          <div style="margin-bottom:4px">📋 签章信息</div>
          <div>确权DID: DID-BR-000002</div>
          <div>溯源标识: Ω₀⊂⊙∞⊂Ω</div>
          <div>签章时间: <span id="esignTime"></span></div>
        </div>
      </div>
      <div style="display:flex;gap:12px">
        <button class="tool-btn primary" style="flex:1" onclick="applyEsign()">✅ 确认签章</button>
        <button class="tool-btn secondary" style="flex:1" onclick="document.getElementById('esignModal').classList.remove('active')">取消</button>
      </div>
      <div id="esignResult" style="margin-top:16px;display:none"></div>
    </div>
  </div>
</div>
