    <span class="icon">⚙️</span>管理
  </div>
  <div class="nav-item" onclick="switchPage('profile')"><div class="icon">👤</div><div class="label">我的</div></div>
</div>

<!-- Toast提示 -->
<div class="toast" id="toast"></div>

<script src="js/gov-utils.js"></script>
<script src="js/gov-main-1.js"></script>
<script src="../gov-ai/js/operator_tracker.js"></script>
<div id="data-dashboard-entry" onclick="window.open('/gov-dashboard/','_blank')" style="position:fixed;bottom:80px;right:16px;background:linear-gradient(135deg,#3b82f6,#8b5cf6);color:white;width:48px;height:48px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:20px;box-shadow:0 4px 12px rgba(59,130,246,.4);cursor:pointer;z-index:99" title="数据看板">📊</div>
<script src="js/gov-extra.js"></script>

<!-- 新手操作引导 -->
<div class="guide-overlay" id="guideOverlay">
  <div class="guide-modal">
    <button class="guide-skip" onclick="closeGuide()">×</button>
    <div class="guide-icon" id="guideIcon">🏛️</div>
    <div class="guide-title" id="guideTitle">欢迎使用政务AI服务平台</div>
    <div class="guide-desc" id="guideDesc">您的智能政务助手，提供政策查询、办事指南、智能问答、公文写作等一站式服务。</div>
    <div class="guide-features" id="guideFeatures">
      <div class="guide-feature"><span class="icon">📋</span>政策库<br>190+条最新政策</div>
      <div class="guide-feature"><span class="icon">🧭</span>办事指南<br>110+条办事流程</div>
      <div class="guide-feature"><span class="icon">🤖</span>智能问答<br>8个AI模型可选</div>
      <div class="guide-feature"><span class="icon">✍️</span>公文写作<br>24种公文模板</div>
    </div>
    <div class="guide-progress" id="guideProgress">
      <div class="guide-dot active"></div>
      <div class="guide-dot"></div>
      <div class="guide-dot"></div>
      <div class="guide-dot"></div>
    </div>
    <div class="guide-buttons">
      <button class="guide-btn" onclick="prevGuide()" id="guidePrev" style="display:none">上一步</button>
      <button class="guide-btn primary" onclick="nextGuide()" id="guideNext">开始体验</button>
    </div>
  </div>
</div>
<script>
// 新手操作引导
const GUIDE_STEPS = [
  {
    icon: '🏛️',
    title: '欢迎使用政务AI服务平台',
    desc: '您的智能政务助手，提供政策查询、办事指南、智能问答、公文写作等一站式服务。',
    features: [
      {icon: '📋', title: '政策库', desc: '190+条最新政策'},
      {icon: '🧭', title: '办事指南', desc: '110+条办事流程'},
      {icon: '🤖', title: '智能问答', desc: '8个AI模型可选'},
      {icon: '✍️', title: '公文写作', desc: '24种公文模板'}
    ],
    nextText: '开始体验'
  },
  {
    icon: '🔍',
    title: '智能搜索与问答',
    desc: '在搜索框输入关键词，自动匹配政策、办事指南和常见问题。点击"智能问答"可与AI对话，获取个性化解答。',
    features: [
      {icon: '💡', title: '智能联想', desc: '输入即提示'},
      {icon: '🔥', title: '热门搜索', desc: '高频问题推荐'},
      {icon: '📜', title: '搜索历史', desc: '快速回顾'},
      {icon: '🎯', title: '真值召回', desc: '答案有据可查'}
    ],
    nextText: '下一步'
  },
  {
    icon: '📝',
    title: '公文智能写作',
    desc: '选择公文类型，输入主题，AI自动生成规范公文。支持请示、报告、通知、函等24种公文模板，一键复制使用。',
    features: [
      {icon: '📄', title: '24种模板', desc: '覆盖常用公文'},
      {icon: '✨', title: 'AI润色', desc: '一键优化表达'},
      {icon: '☁️', title: '云端保存', desc: '历史记录可查'},
      {icon: '📋', title: '一键复制', desc: '方便粘贴使用'}
    ],
    nextText: '下一步'
  },
  {
    icon: '🔗',
    title: '可视化工作流编程',
    desc: '拖拽节点搭建自动化工作流，支持政策分析、公文写作、数据处理等场景。4个专业模板一键应用，工作流云端保存。',
    features: [
      {icon: '🎨', title: '可视化编排', desc: '拖拽连线'},
      {icon: '📚', title: '模板库', desc: '4个专业模板'},
      {icon: '☁️', title: '云端持久化', desc: '跨设备同步'},
      {icon: '▶️', title: '一键执行', desc: '自动运行'}
    ],
    nextText: '完成'
  }
];
let currentGuideStep = 0;

function showGuide() {
  document.getElementById('guideOverlay').classList.add('active');
  renderGuideStep(0);
}
function closeGuide() {
  document.getElementById('guideOverlay').classList.remove('active');
  localStorage.setItem('gov_guide_completed', 'true');
}
function renderGuideStep(step) {
  currentGuideStep = step;
  const s = GUIDE_STEPS[step];
  document.getElementById('guideIcon').textContent = s.icon;
  document.getElementById('guideTitle').textContent = s.title;
  document.getElementById('guideDesc').textContent = s.desc;
  document.getElementById('guideNext').textContent = s.nextText;
  document.getElementById('guidePrev').style.display = step > 0 ? 'inline-block' : 'none';
  // 进度点
  const dots = document.querySelectorAll('.guide-dot');
  dots.forEach((d, i) => d.classList.toggle('active', i === step));
  // 功能卡片
  const featuresHtml = s.features.map(f =>
    `<div class="guide-feature"><span class="icon">${f.icon}</span>${f.title}<br>${f.desc}</div>`
  ).join('');
  document.getElementById('guideFeatures').innerHTML = featuresHtml;
}
function nextGuide() {
  if (currentGuideStep < GUIDE_STEPS.length - 1) {
    renderGuideStep(currentGuideStep + 1);
  } else {
    closeGuide();
  }
}
function prevGuide() {
  if (currentGuideStep > 0) {
    renderGuideStep(currentGuideStep - 1);
  }
}
// 首次访问自动显示引导
(function() {
  if (!localStorage.getItem('gov_guide_completed')) {
    if (document.readyState === 'complete') {
      setTimeout(showGuide, 1500);
    } else {
      window.addEventListener('load', () => setTimeout(showGuide, 1500));
    }
  }
})();
// 暴露重新查看引导的函数
window.showGuide = showGuide;
</script>

</body>
</html>
