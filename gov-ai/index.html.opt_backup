<!-- 智能问答 -->
<div class="page" id="page-chat">
  <div class="chat-container">
    <div class="chat-messages" id="chatMessages"><div class="msg ai"><div class="avatar">🤖</div><div class="bubble">您好！我是政务AI助手，可以为您提供政策咨询、办事指南、公文写作等服务。请问有什么可以帮您？</div></div></div>
    <div class="quick-questions">
      <button class="quick-q" onclick="quickAsk('营业执照怎么办理？')">营业执照办理</button>
      <button class="quick-q" onclick="quickAsk('社保转移流程')">社保转移</button>
      <button class="quick-q" onclick="quickAsk('个税专项扣除')">个税扣除</button>
      <button class="quick-q" onclick="quickAsk('帮我写一份会议通知')">写会议通知</button>
    </div>
    <div class="faq-suggestions" id="faqSuggestions">
      <div class="faq-title">💡 常见问题 · 点击快速提问</div>
      <div class="faq-categories">
        <span class="faq-cat active" onclick="filterFaq(this,'all')">全部</span>
        <span class="faq-cat" onclick="filterFaq(this,'social')">社保医保</span>
        <span class="faq-cat" onclick="filterFaq(this,'cert')">证件办理</span>
        <span class="faq-cat" onclick="filterFaq(this,'business')">企业服务</span>
        <span class="faq-cat" onclick="filterFaq(this,'doc')">公文写作</span>
      </div>
      <div class="faq-list" id="faqList">
        <button class="faq-item" data-cat="social" onclick="quickAsk(&quot;社保缴费比例是多少？&quot;)">社保缴费</button>
        <button class="faq-item" data-cat="social" onclick="quickAsk(&quot;医保报销流程？&quot;)">医保报销</button>
        <button class="faq-item" data-cat="social" onclick="quickAsk(&quot;公积金贷款条件？&quot;)">公积金贷款</button>
        <button class="faq-item" data-cat="social" onclick="quickAsk(&quot;养老保险怎么转移？&quot;)">养老转移</button>
        <button class="faq-item" data-cat="cert" onclick="quickAsk(&quot;身份证怎么办理？&quot;)">身份证办理</button>
        <button class="faq-item" data-cat="cert" onclick="quickAsk(&quot;居住证怎么办理？&quot;)">居住证</button>
        <button class="faq-item" data-cat="cert" onclick="quickAsk(&quot;护照办理需要什么材料？&quot;)">护照办理</button>
        <button class="faq-item" data-cat="cert" onclick="quickAsk(&quot;户口本遗失怎么补办？&quot;)">户口本补办</button>
        <button class="faq-item" data-cat="business" onclick="quickAsk(&quot;营业执照如何申请？&quot;)">营业执照</button>
        <button class="faq-item" data-cat="business" onclick="quickAsk(&quot;小微企业有哪些税收优惠？&quot;)">税收优惠</button>
        <button class="faq-item" data-cat="business" onclick="quickAsk(&quot;社保开户流程？&quot;)">社保开户</button>
        <button class="faq-item" data-cat="doc" onclick="quickAsk(&quot;帮我写一份会议通知&quot;)">写会议通知</button>
        <button class="faq-item" data-cat="doc" onclick="quickAsk(&quot;帮我写一份工作总结&quot;)">写工作总结</button>
        <button class="faq-item" data-cat="doc" onclick="quickAsk(&quot;帮我写一份请示报告&quot;)">写请示报告</button>
      </div>
    </div>
    <div class="chat-history-bar">
      <span class="history-btn" onclick="toggleChatHistory()">📜 对话历史</span>
      <span class="history-btn" onclick="clearChatHistory()">🗑️ 清空</span>
    </div>
    <div class="chat-history-panel" id="chatHistoryPanel" style="display:none">
      <div class="history-title">历史对话</div>
      <div id="historyList"></div>
    </div>
    <div class="chat-input"><input type="text" id="chatInput" placeholder="请输入您的问题..." onkeypress="if(event.key==='Enter')sendMessage()"><button onclick="sendMessage()">➤</button></div>
  </div>
</div>

<!-- 公文助手 -->
<div class="page" id="page-doc">
  <div class="tool-card">
    <h3>📝 公文智能写作</h3>
