  </div>
  <div class="skeleton-text">ZONGYUAN-ROOT · 政务中台加载中...</div>
</div>
<script>
// 骨架屏控制
window.hideSkeleton = function() {
  const loader = document.getElementById('skeleton-loader');
  if (loader) {
    loader.classList.add('hidden');
    setTimeout(() => { if(loader.parentNode) loader.parentNode.removeChild(loader); }, 500);
  }
};
// 页面加载完成后隐藏骨架屏
if (document.readyState === 'complete') {
  setTimeout(window.hideSkeleton, 300);
} else {
  window.addEventListener('load', () => setTimeout(window.hideSkeleton, 300));
}
// 最长5秒后强制隐藏（防止卡住）
setTimeout(window.hideSkeleton, 5000);
</script>

<!-- 主题切换 -->
<button class="theme-toggle" id="themeToggle" onclick="toggleTheme()" title="切换主题">🌙</button>
<script>
// 主题切换功能
function getCurrentTheme() {
  return localStorage.getItem('gov_theme') || 'dark';
}
function applyTheme(theme) {
  const body = document.body;
  const btn = document.getElementById('themeToggle');
  if (theme === 'light') {
    body.classList.add('light-theme');
    if (btn) btn.textContent = '☀️';
  } else {
    body.classList.remove('light-theme');
    if (btn) btn.textContent = '🌙';
  }
  localStorage.setItem('gov_theme', theme);
}
function toggleTheme() {
  const current = getCurrentTheme();
  const next = current === 'dark' ? 'light' : 'dark';
  applyTheme(next);
}
// 页面加载时应用保存的主题
(function() {
  const theme = getCurrentTheme();
  if (theme === 'light') {
    // 延迟应用，确保DOM加载完成
    if (document.body) {
      applyTheme('light');
    } else {
      document.addEventListener('DOMContentLoaded', () => applyTheme('light'));
    }
  }
})();
</script>

<!-- 新手操作引导 -->
<div class="guide-overlay" id="guideOverlay">
  <div class="guide-modal">
    <button class="guide-skip" onclick="closeGuide()">×</button>
    <div class="guide-icon" id="guideIcon">🏛️</div>
    <div class="guide-title" id="guideTitle">欢迎使用政务AI服务平台</div>
    <div class="guide-desc" id="guideDesc">您的智能政务助手，提供政策查询、办事指南、智能问答、公文写作等一站式服务。</div>
    <div class="guide-features" id="guideFeatures">
      <div class="guide-feature"><span class="icon">📋</span>政策库<br>190+条最新政策</div>
      <div class="guide-feature"><span class="icon">🧭</span>办事指南<br>110+条办事流程</div>
      <div class="guide-feature"><span class="icon">🤖</span>智能问答<br>8个AI模型可选</div>
      <div class="guide-feature"><span class="icon">✍️</span>公文写作<br>24种公文模板</div>
    </div>
    <div class="guide-progress" id="guideProgress">
      <div class="guide-dot active"></div>
      <div class="guide-dot"></div>
      <div class="guide-dot"></div>
      <div class="guide-dot"></div>
    </div>
    <div class="guide-buttons">
      <button class="guide-btn" onclick="prevGuide()" id="guidePrev" style="display:none">上一步</button>
      <button class="guide-btn primary" onclick="nextGuide()" id="guideNext">开始体验</button>
    </div>
  </div>
</div>
<script>
// 新手操作引导
const GUIDE_STEPS = [
  {
    icon: '🏛️',
    title: '欢迎使用政务AI服务平台',
    desc: '您的智能政务助手，提供政策查询、办事指南、智能问答、公文写作等一站式服务。',
    features: [
      {icon: '📋', title: '政策库', desc: '190+条最新政策'},
