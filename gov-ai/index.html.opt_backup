<style>
.faq-suggestions { padding: 8px 16px; background: #f8fafc; border-bottom: 1px solid #e2e8f0; }
.faq-title { font-size: 11px; color: #64748b; margin-bottom: 6px; }
.faq-list { display: flex; flex-wrap: wrap; gap: 6px; }
.faq-item { background: white; border: 1px solid #e2e8f0; border-radius: 16px; padding: 5px 12px; font-size: 12px; color: #3b82f6; cursor: pointer; transition: all .2s; }
.faq-item:hover { background: #3b82f6; color: white; border-color: #3b82f6; }
.faq-categories{display:flex;gap:8px;margin-bottom:12px;flex-wrap:wrap}
.faq-cat{padding:4px 12px;background:#f0f0f0;border-radius:12px;font-size:12px;cursor:pointer;transition:all .3s}
.faq-cat.active{background:#1a1a2e;color:#ffd700}
.chat-history-bar{display:flex;gap:12px;margin-top:12px;padding-top:12px;border-top:1px solid #eee}
.history-btn{font-size:12px;color:#666;cursor:pointer;padding:4px 8px;border-radius:4px}
.history-btn:hover{background:#f0f0f0;color:#333}
.chat-history-panel{margin-top:8px;padding:12px;background:#f9f9f9;border-radius:8px;max-height:200px;overflow-y:auto}
.history-title{font-size:13px;font-weight:600;margin-bottom:8px;color:#333}
.history-item{padding:8px;background:#fff;border-radius:6px;margin-bottom:6px;font-size:12px;color:#666;cursor:pointer}
.history-item:hover{background:#f0f0f0}
.export-btn { background: linear-gradient(135deg,#10b981,#059669); color: white; border: none; padding: 6px 14px; border-radius: 6px; font-size: 12px; cursor: pointer; margin-left: 8px; }
.export-btn:hover { opacity: .9; }
.appt-actions { display: flex; gap: 8px; margin-top: 8px; }
.appt-btn { padding: 4px 12px; border-radius: 4px; font-size: 12px; cursor: pointer; border: none; }
.appt-btn.confirm { background: #10b981; color: white; }
.appt-btn.cancel { background: #ef4444; color: white; }
.appt-status { font-size: 11px; padding: 2px 8px; border-radius: 10px; display: inline-block; }
.appt-status.pending { background: #fef3c7; color: #92400e; }
.appt-status.confirmed { background: #d1fae5; color: #065f46; }
.appt-status.cancelled { background: #fee2e2; color: #991b1b; }

.rag-references { margin-top: 12px; padding: 12px; background: linear-gradient(135deg, #1a1a2e, #16213e); border-radius: 10px; border-left: 3px solid #ffd700; }
.rag-ref-title { font-size: 13px; font-weight: 600; color: #ffd700; margin-bottom: 8px; }
.rag-ref-list { display: flex; flex-direction: column; gap: 6px; }
.rag-ref-item { display: flex; align-items: center; gap: 8px; padding: 6px 8px; background: rgba(255,255,255,0.05); border-radius: 6px; }
.rag-ref-type { font-size: 11px; padding: 2px 8px; border-radius: 4px; font-weight: 600; flex-shrink: 0; }
.rag-ref-name { font-size: 12px; color: #e0e0e0; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rag-ref-score { font-size: 11px; color: #888; flex-shrink: 0; }

.pd-actions{display:flex;gap:12px;margin:16px 0;flex-wrap:wrap}
.pd-action-btn{flex:1;min-width:120px;padding:12px 16px;border:none;border-radius:10px;font-size:14px;cursor:pointer;background:linear-gradient(135deg,#1a1a2e,#16213e);color:#ffd700;font-weight:600;transition:all .3s}
.pd-action-btn:hover{transform:translateY(-2px);box-shadow:0 4px 12px rgba(0,0,0,.2)}
.pd-action-btn:disabled{opacity:.5;cursor:not-allowed;transform:none}
.pd-action-btn.pd-voice{background:linear-gradient(135deg,#2d5016,#4a7c23)}
.policy-image-loading{text-align:center;padding:20px;color:#666}
.policy-image-result{text-align:center;margin-top:16px}
.policy-image-result img{max-width:100%;border-radius:12px;box-shadow:0 4px 20px rgba(0,0,0,.15)}
.policy-audio-player{margin-top:16px;padding:16px;background:#f8f9fa;border-radius:12px}
.policy-audio-player audio{width:100%}
</style>
