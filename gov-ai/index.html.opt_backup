      <div class="quick-item" onclick="useTemplate('请示')"><div class="q-icon">🙋</div><div class="q-info"><div class="q-title">请示</div><div class="q-desc">请求指示、批准事项</div></div><div class="q-arrow">›</div></div>
      <div class="quick-item" onclick="useTemplate('函')"><div class="q-icon">✉️</div><div class="q-info"><div class="q-title">函</div><div class="q-desc">不相隶属机关商洽工作</div></div><div class="q-arrow">›</div></div>
