<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>产品定价 - 火斗云智AIOS</title>
<meta name="description" content="火斗云智AIOS六大产品线定价方案：火斗智脑GPU大脑API、火斗记忆真值库、火斗轻模自研小模型、昆仑洞天AI短剧、火斗自治运维、AIOS全栈解决方案">
<style>
:root{
  --primary:#1a1a2e;--accent:#e94560;--accent2:#0f3460;--gold:#d4af37;
  --bg:#0a0a14;--card:#12121f;--text:#e8e8f0;--muted:#8888a0;--border:#2a2a3e;
}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif;background:var(--bg);color:var(--text);line-height:1.6}
a{color:var(--accent);text-decoration:none}
a:hover{text-decoration:underline}
.container{max-width:1200px;margin:0 auto;padding:0 20px}

/* Header */
header{background:rgba(10,10,20,.95);backdrop-filter:blur(10px);border-bottom:1px solid var(--border);position:sticky;top:0;z-index:100}
.nav{display:flex;align-items:center;justify-content:space-between;height:64px}
.logo{font-size:1.3rem;font-weight:700;background:linear-gradient(135deg,var(--accent),var(--gold));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.nav-links{display:flex;gap:24px;list-style:none}
.nav-links a{color:var(--muted);font-size:.9rem;transition:color .2s}
.nav-links a:hover{color:var(--text)}
.cta-btn{background:linear-gradient(135deg,var(--accent),#c73e54);color:#fff;padding:8px 20px;border-radius:6px;font-size:.9rem;font-weight:600;border:none;cursor:pointer;transition:transform .2s,box-shadow .2s}
.cta-btn:hover{transform:translateY(-1px);box-shadow:0 4px 20px rgba(233,69,96,.3)}

/* Hero */
.hero{text-align:center;padding:80px 0 60px;background:radial-gradient(ellipse at 50% 0%,rgba(233,69,96,.1),transparent 60%)}
.hero h1{font-size:2.8rem;font-weight:800;margin-bottom:16px;background:linear-gradient(135deg,#fff,var(--muted));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.hero p{font-size:1.15rem;color:var(--muted);max-width:700px;margin:0 auto 32px}
.hero-badges{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
.badge{background:var(--card);border:1px solid var(--border);padding:6px 16px;border-radius:20px;font-size:.8rem;color:var(--muted)}
.badge.highlight{border-color:var(--accent);color:var(--accent)}

/* Section */
.section{padding:60px 0}
.section-title{text-align:center;margin-bottom:48px}
.section-title h2{font-size:2rem;font-weight:700;margin-bottom:12px}
.section-title p{color:var(--muted);font-size:1rem}

/* Product Cards */
.product-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:24px;margin-bottom:48px}
.product-card{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:28px;transition:transform .2s,border-color .2s}
.product-card:hover{transform:translateY(-4px);border-color:var(--accent)}
.product-card.featured{border-color:var(--gold);position:relative}
.product-card.featured::before{content:"旗舰";position:absolute;top:-10px;right:20px;background:linear-gradient(135deg,var(--gold),#b8941f);color:#000;padding:4px 14px;border-radius:12px;font-size:.75rem;font-weight:700}
.product-icon{width:48px;height:48px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.5rem;margin-bottom:16px}
.product-card h3{font-size:1.3rem;font-weight:700;margin-bottom:8px}
.product-card .tagline{color:var(--muted);font-size:.9rem;margin-bottom:16px}
.product-card .price{font-size:2rem;font-weight:800;margin-bottom:4px}
.product-card .price span{font-size:.9rem;font-weight:400;color:var(--muted)}
.product-card .features{list-style:none;margin:20px 0}
.product-card .features li{padding:6px 0;font-size:.88rem;color:var(--muted);display:flex;align-items:center;gap:8px}
.product-card .features li::before{content:"✓";color:var(--accent);font-weight:700}
.product-card .btn{display:block;text-align:center;padding:10px;border-radius:8px;font-weight:600;font-size:.9rem;margin-top:16px;transition:all .2s}
.product-card .btn-primary{background:linear-gradient(135deg,var(--accent),#c73e54);color:#fff}
.product-card .btn-primary:hover{box-shadow:0 4px 20px rgba(233,69,96,.3);text-decoration:none}
.product-card .btn-outline{border:1px solid var(--border);color:var(--text)}
.product-card .btn-outline:hover{border-color:var(--accent);color:var(--accent);text-decoration:none}

/* Pricing Tables */
.pricing-block{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:32px;margin-bottom:32px}
.pricing-block h3{font-size:1.4rem;font-weight:700;margin-bottom:8px;display:flex;align-items:center;gap:12px}
.pricing-block .desc{color:var(--muted);font-size:.9rem;margin-bottom:24px}
.table-wrap{overflow-x:auto}
table{width:100%;border-collapse:collapse;font-size:.88rem}
th{background:var(--accent2);padding:12px 16px;text-align:left;font-weight:600;color:#fff;white-space:nowrap}
td{padding:12px 16px;border-bottom:1px solid var(--border);color:var(--muted)}
tr:hover td{background:rgba(233,69,96,.05)}
td:first-child{color:var(--text);font-weight:500}
.popular{background:rgba(233,69,96,.1)!important}
.popular-tag{display:inline-block;background:var(--accent);color:#fff;font-size:.7rem;padding:2px 8px;border-radius:10px;margin-left:8px}

/* Strategy */
.strategy-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:20px}
.strategy-item{background:var(--card);border:1px solid var(--border);border-radius:10px;padding:24px;text-align:center}
.strategy-item .num{font-size:2rem;font-weight:800;color:var(--accent);margin-bottom:8px}
.strategy-item h4{font-size:1.1rem;font-weight:600;margin-bottom:8px}
.strategy-item p{font-size:.85rem;color:var(--muted)}

/* Timeline */
.timeline{position:relative;padding-left:40px}
.timeline::before{content:"";position:absolute;left:12px;top:0;bottom:0;width:2px;background:var(--border)}
.timeline-item{position:relative;margin-bottom:32px}
.timeline-item::before{content:"";position:absolute;left:-34px;top:4px;width:16px;height:16px;border-radius:50%;background:var(--accent);border:3px solid var(--bg)}
.timeline-item h4{font-size:1.1rem;font-weight:600;margin-bottom:4px}
.timeline-item .time{color:var(--gold);font-size:.85rem;margin-bottom:8px}
.timeline-item p{color:var(--muted);font-size:.9rem}
.timeline-item .metrics{display:flex;gap:16px;margin-top:8px;flex-wrap:wrap}
.timeline-item .metric{background:var(--card);padding:4px 12px;border-radius:6px;font-size:.8rem;color:var(--muted)}

/* FAQ */
.faq-item{background:var(--card);border:1px solid var(--border);border-radius:10px;margin-bottom:12px;overflow:hidden}
.faq-q{padding:20px 24px;cursor:pointer;font-weight:600;display:flex;justify-content:space-between;align-items:center}
.faq-q::after{content:"+";font-size:1.5rem;color:var(--accent);transition:transform .2s}
.faq-item.open .faq-q::after{transform:rotate(45deg)}
.faq-a{padding:0 24px;max-height:0;overflow:hidden;transition:max-height .3s,padding .3s;color:var(--muted);font-size:.9rem}
.faq-item.open .faq-a{padding:0 24px 20px;max-height:300px}

/* CTA */
.cta-section{text-align:center;padding:80px 0;background:radial-gradient(ellipse at 50% 50%,rgba(233,69,96,.1),transparent 60%)}
.cta-section h2{font-size:2rem;font-weight:700;margin-bottom:16px}
.cta-section p{color:var(--muted);margin-bottom:32px;max-width:600px;margin-left:auto;margin-right:auto}
.cta-buttons{display:flex;gap:16px;justify-content:center;flex-wrap:wrap}
.btn-large{padding:14px 36px;border-radius:8px;font-weight:600;font-size:1rem;transition:all .2s}
.btn-large.primary{background:linear-gradient(135deg,var(--accent),#c73e54);color:#fff}
.btn-large.primary:hover{box-shadow:0 6px 30px rgba(233,69,96,.4);transform:translateY(-2px)}
.btn-large.secondary{border:1px solid var(--border);color:var(--text)}
.btn-large.secondary:hover{border-color:var(--accent);color:var(--accent)}

/* Footer */
footer{border-top:1px solid var(--border);padding:40px 0;text-align:center;color:var(--muted);font-size:.85rem}
footer .links{display:flex;gap:24px;justify-content:center;margin-bottom:16px;flex-wrap:wrap}
footer a{color:var(--muted)}
footer a:hover{color:var(--text)}

/* Responsive */
@media(max-width:768px){
  .hero h1{font-size:2rem}
  .nav-links{display:none}
  .product-grid{grid-template-columns:1fr}
  .section{padding:40px 0}
}
</style>
</head>
<body>

<header>
<div class="container nav">
  <div class="logo">火斗云智 AIOS</div>
  <ul class="nav-links">
    <li><a href="/">首页</a></li>
    <li><a href="/products.html">产品</a></li>
    <li><a href="/pricing.html">定价</a></li>
    <li><a href="/architecture.html">架构</a></li>
    <li><a href="/cases.html">案例</a></li>
    <li><a href="/docs/">文档</a></li>
  </ul>
  <button class="cta-btn" onclick="location.href='/aios/'">立即开始</button>
</div>
</header>

<section class="hero">
<div class="container">
  <h1>简单透明的定价</h1>
  <p>六大产品线，从免费试用到企业级部署，按需选择，零成本优先调度，让AI能力触手可及</p>
  <div class="hero-badges">
    <span class="badge highlight">✓ 免费额度 generous</span>
    <span class="badge">✓ 按需付费 无隐藏费用</span>
    <span class="badge">✓ 年付享8折</span>
    <span class="badge">✓ 随时取消</span>
  </div>
</div>
</section>

<!-- 产品总览卡片 -->
<section class="section">
<div class="container">
  <div class="section-title">
    <h2>六大产品线</h2>
    <p>从模型推理到自治运维，全栈AI能力一站式覆盖</p>
  </div>
  <div class="product-grid">

    <div class="product-card">
      <div class="product-icon" style="background:rgba(233,69,96,.15)">🧠</div>
      <h3>火斗智脑</h3>
      <p class="tagline">GPU大脑API · 7B决策+0.5B自研双引擎</p>
      <div class="price">¥0 <span>/月起</span></div>
      <ul class="features">
        <li>7B决策大脑 + 0.5B自研轻量模型</li>
        <li>智能路由，自动选择最优模型</li>
        <li>RAG增强，接入记忆网关真值库</li>
        <li>OpenAI兼容API，无缝迁移</li>
        <li>免费版10万token/月</li>
      </ul>
      <a href="#brain" class="btn btn-outline">查看详情</a>
    </div>

    <div class="product-card">
      <div class="product-icon" style="background:rgba(212,175,55,.15)">💾</div>
      <h3>火斗记忆</h3>
      <p class="tagline">记忆网关真值库 · 45000+持续进化真值</p>
      <div class="price">¥0 <span>/月起</span></div>
      <ul class="features">
        <li>结构化真值存储，九大元类归类</li>
        <li>语义检索，<100ms响应</li>
