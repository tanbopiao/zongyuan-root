    // 渲染公理卡片
    function renderAxiomCards(filter = 'all') {
      const grid = document.getElementById('axiomGrid');
      const filtered = filter === 'all' ? AXIOMS : AXIOMS.filter(a => a.level === filter);
      
      grid.innerHTML = filtered.map(axiom => `
        <div class="axiom-card ${axiom.level}" onclick="openModal('${axiom.id}')">
          <div class="axiom-card-header">
            <span class="axiom-card-id">${axiom.id}</span>
            <span class="axiom-card-level">${getLevelName(axiom.level)}</span>
          </div>
          <h3 class="axiom-card-name">${axiom.name}</h3>
          <p class="axiom-card-statement">${axiom.statement}</p>
          <div class="axiom-card-footer">
            <span class="axiom-card-hash">#${axiom.id.split('-').pop()}</span>
            <span class="axiom-card-view">查看详情 →</span>
          </div>
        </div>
      `).join('');
    }

    function getLevelName(level) {
      const names = {meta: '元公理', core: '核心公理', derived: '派生公理', local: '局部公理'};
      return names[level] || level;
    }

    // 渲染校验规则表格
    function renderRulesTable() {
      const tbody = document.getElementById('rulesTableBody');
      tbody.innerHTML = VALIDATION_RULES.map((rule, index) => `
        <tr>
          <td>${index + 1}</td>
          <td class="rule-id">${rule.id}</td>
          <td><span class="rule-category ${rule.category}">${rule.categoryName}</span></td>
          <td>${rule.desc}</td>
          <td class="rule-id">${rule.axiom}</td>
        </tr>
      `).join('');
    }

    // 弹窗
    function openModal(axiomId) {
      const axiom = AXIOMS.find(a => a.id === axiomId);
      if (!axiom) return;

      const levelColors = {
        meta: 'background: rgba(212, 175, 55, 0.15); color: #d4af37;',
        core: 'background: rgba(139, 92, 246, 0.15); color: #a78bfa;',
        derived: 'background: rgba(59, 130, 246, 0.15); color: #60a5fa;',
        local: 'background: rgba(107, 114, 128, 0.15); color: #9ca3af;'
      };

      document.getElementById('modalHeader').innerHTML = `
        <span class="modal-level-badge" style="${levelColors[axiom.level]}">${getLevelName(axiom.level)}</span>
        <h2 class="modal-title">${axiom.name}</h2>
        <p class="modal-id">${axiom.id} · AXIOM-ENGINE-V1.0</p>
      `;

      document.getElementById('modalBody').innerHTML = `
        <div class="modal-section">
          <div class="modal-section-title">公理陈述</div>
          <div class="modal-section-content">${axiom.statement}</div>
        </div>
        <div class="modal-section">
          <div class="modal-section-title">详细描述</div>
          <div class="modal-section-content">${axiom.description}</div>
        </div>
        <div class="modal-section">
          <div class="modal-section-title">数学表达</div>
          <div class="modal-math">${axiom.math}</div>
        </div>
        ${axiom.derivedFrom && axiom.derivedFrom.length > 0 ? `
        <div class="modal-section">
          <div class="modal-section-title">推导来源</div>
          <div class="modal-derived-from">
            ${axiom.derivedFrom.map(id => `<span class="derived-tag">${id}</span>`).join('')}
          </div>
        </div>
        ` : ''}
        <div class="modal-section">
          <div class="modal-section-title">核心推论</div>
          <ul class="modal-corollaries">
            ${axiom.corollaries.map(c => `<li>${c}</li>`).join('')}
          </ul>
        </div>
      `;

      document.getElementById('axiomModal').classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      document.getElementById('axiomModal').classList.remove('active');
      document.body.style.overflow = '';
    }

    // 点击弹窗外部关闭
    document.getElementById('axiomModal').addEventListener('click', function(e) {
      if (e.target === this) closeModal();
    });

    // 筛选按钮
    document.querySelectorAll('.filter-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
        this.classList.add('active');
        renderAxiomCards(this.dataset.filter);
      });
    });

