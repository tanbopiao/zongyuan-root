<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>元极恒一公理体系 | Axiom System Visualization</title>
  <meta name="description" content="元极恒一自治体系公理驱动引擎可视化 - 29条公理、15条校验规则、四层驱动架构">
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⚖️</text></svg>">
  <link href="https://miaoda.feishu.cn/fonts/css2?family=Noto+Serif+SC:wght@400;600;700;900&family=Noto+Sans+SC:wght@300;400;500;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/echarts@5.4.3/dist/echarts.min.js"></script>
  <style>
    :root {
      --bg-primary: #0a0a0f;
      --bg-secondary: #12121a;
      --bg-card: #1a1a25;
      --bg-card-hover: #22222f;
      --border: #2a2a3a;
      --border-light: #3a3a4a;
      --text-primary: #e8e8f0;
      --text-secondary: #a0a0b8;
      --text-muted: #6a6a80;
      --gold: #d4af37;
      --gold-light: #f0d060;
      --gold-dark: #a08020;
      --purple: #8b5cf6;
      --purple-light: #a78bfa;
      --blue: #3b82f6;
      --blue-light: #60a5fa;
      --cyan: #06b6d4;
      --green: #10b981;
      --red: #ef4444;
      --orange: #f59e0b;
      --meta-color: #d4af37;
      --core-color: #8b5cf6;
      --derived-color: #3b82f6;
      --local-color: #6b7280;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Noto Sans SC', sans-serif;
      background: var(--bg-primary);
      color: var(--text-primary);
      line-height: 1.6;
      overflow-x: hidden;
    }

    /* 背景粒子效果 */
    .bg-particles {
      position: fixed;
      top: 0; left: 0;
      width: 100%; height: 100%;
      pointer-events: none;
      z-index: 0;
      opacity: 0.3;
    }

    /* 顶部导航 */
    .navbar {
      position: fixed;
      top: 0; left: 0; right: 0;
      background: rgba(10, 10, 15, 0.9);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border);
      z-index: 1000;
      padding: 0 2rem;
    }

    .navbar-container {
      max-width: 1600px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 64px;
    }

    .navbar-logo {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      text-decoration: none;
    }

    .navbar-logo-icon {
      width: 40px; height: 40px;
      background: linear-gradient(135deg, var(--gold), var(--gold-dark));
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
      font-weight: 900;
      color: var(--bg-primary);
      font-family: 'Noto Serif SC', serif;
    }

    .navbar-logo-text {
      font-family: 'Noto Serif SC', serif;
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--text-primary);
    }

    .navbar-logo-sub {
      font-size: 0.7rem;
      color: var(--text-muted);
      font-weight: 400;
    }

    .navbar-links {
      display: flex;
      gap: 0.5rem;
      list-style: none;
    }

    .navbar-link {
      padding: 0.5rem 1rem;
      color: var(--text-secondary);
      text-decoration: none;
      font-size: 0.9rem;
      border-radius: 8px;
      transition: all 0.3s;
      cursor: pointer;
    }

    .navbar-link:hover, .navbar-link.active {
      color: var(--gold);
      background: rgba(212, 175, 55, 0.1);
    }

    /* 主内容区 */
    .main-content {
      position: relative;
      z-index: 1;
      padding-top: 64px;
    }

    /* Hero区域 */
    .hero {
      padding: 4rem 2rem 3rem;
      text-align: center;
      background: radial-gradient(ellipse at center, rgba(212, 175, 55, 0.08) 0%, transparent 70%);
      position: relative;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 1.25rem;
      background: rgba(212, 175, 55, 0.1);
      border: 1px solid rgba(212, 175, 55, 0.3);
      border-radius: 50px;
      font-size: 0.85rem;
      color: var(--gold);
      margin-bottom: 1.5rem;
    }

    .hero-badge-dot {
      width: 8px; height: 8px;
      background: var(--green);
      border-radius: 50%;
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.5; transform: scale(1.2); }
    }

    .hero-title {
      font-family: 'Noto Serif SC', serif;
      font-size: 3rem;
      font-weight: 900;
      margin-bottom: 1rem;
      background: linear-gradient(135deg, var(--gold-light), var(--gold), var(--gold-dark));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      line-height: 1.2;
    }

    .hero-subtitle {
      font-size: 1.25rem;
      color: var(--text-secondary);
      margin-bottom: 2rem;
      max-width: 800px;
      margin-left: auto;
      margin-right: auto;
    }

    .hero-stats {
      display: flex;
      justify-content: center;
      gap: 3rem;
      flex-wrap: wrap;
    }

    .hero-stat {
      text-align: center;
    }

    .hero-stat-number {
      font-size: 2.5rem;
      font-weight: 900;
      font-family: 'JetBrains Mono', monospace;
      color: var(--gold);
    }

    .hero-stat-label {
      font-size: 0.9rem;
      color: var(--text-muted);
      margin-top: 0.25rem;
    }

    /* 通用区块 */
    .section {
      padding: 3rem 2rem;
      max-width: 1600px;
      margin: 0 auto;
    }

    .section-header {
      text-align: center;
      margin-bottom: 2.5rem;
    }

    .section-label {
      font-size: 0.8rem;
      color: var(--gold);
      letter-spacing: 0.2em;
      text-transform: uppercase;
      margin-bottom: 0.75rem;
      font-weight: 500;
    }

    .section-title {
      font-family: 'Noto Serif SC', serif;
      font-size: 2rem;
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: 0.75rem;
    }

    .section-subtitle {
      font-size: 1rem;
      color: var(--text-secondary);
      max-width: 700px;
      margin: 0 auto;
    }

    /* 四层驱动架构 */
    .architecture-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
      margin-bottom: 2rem;
    }

    .arch-layer {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 1.5rem;
      position: relative;
      overflow: hidden;
      transition: all 0.3s;
    }

    .arch-layer:hover {
      transform: translateY(-4px);
      border-color: var(--border-light);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    }

    .arch-layer::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 4px;
    }

    .arch-layer.level-0::before { background: linear-gradient(90deg, var(--gold), var(--gold-dark)); }
    .arch-layer.level-1::before { background: linear-gradient(90deg, var(--purple), var(--purple-light)); }
    .arch-layer.level-2::before { background: linear-gradient(90deg, var(--blue), var(--blue-light)); }
    .arch-layer.level-3::before { background: linear-gradient(90deg, var(--cyan), var(--green)); }

    .arch-layer-badge {
      display: inline-block;
      padding: 0.25rem 0.75rem;
      border-radius: 50px;
      font-size: 0.7rem;
      font-weight: 700;
      margin-bottom: 1rem;
      font-family: 'JetBrains Mono', monospace;
    }

    .level-0 .arch-layer-badge { background: rgba(212, 175, 55, 0.15); color: var(--gold); }
    .level-1 .arch-layer-badge { background: rgba(139, 92, 246, 0.15); color: var(--purple-light); }
    .level-2 .arch-layer-badge { background: rgba(59, 130, 246, 0.15); color: var(--blue-light); }
    .level-3 .arch-layer-badge { background: rgba(6, 182, 212, 0.15); color: var(--cyan); }

    .arch-layer-title {
      font-size: 1.25rem;
      font-weight: 700;
      margin-bottom: 0.5rem;
      color: var(--text-primary);
    }

    .arch-layer-desc {
      font-size: 0.85rem;
      color: var(--text-secondary);
      margin-bottom: 1rem;
      line-height: 1.6;
    }

    .arch-layer-features {
      list-style: none;
    }

    .arch-layer-features li {
      font-size: 0.8rem;
      color: var(--text-muted);
      padding: 0.25rem 0;
      padding-left: 1.25rem;
      position: relative;
    }

    .arch-layer-features li::before {
      content: '▸';
      position: absolute;
      left: 0;
      color: var(--gold);
    }

    /* 图表容器 */
    .chart-container {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 1.5rem;
      margin-bottom: 2rem;
    }

    .chart-title {
      font-size: 1.1rem;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .chart-title-icon {
      width: 24px; height: 24px;
      background: linear-gradient(135deg, var(--gold), var(--gold-dark));
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.75rem;
    }

    .chart-canvas {
      width: 100%;
      height: 500px;
    }

    .chart-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }

    /* 公理卡片网格 */
    .axiom-filters {
      display: flex;
      justify-content: center;
      gap: 0.75rem;
      margin-bottom: 2rem;
      flex-wrap: wrap;
    }

    .filter-btn {
      padding: 0.5rem 1.25rem;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 50px;
      color: var(--text-secondary);
      font-size: 0.85rem;
      cursor: pointer;
      transition: all 0.3s;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .filter-btn:hover {
      border-color: var(--border-light);
      color: var(--text-primary);
    }

    .filter-btn.active {
      background: rgba(212, 175, 55, 0.1);
      border-color: var(--gold);
      color: var(--gold);
    }

    .filter-btn-count {
      background: rgba(255, 255, 255, 0.1);
      padding: 0.1rem 0.5rem;
      border-radius: 50px;
      font-size: 0.75rem;
      font-family: 'JetBrains Mono', monospace;
    }

    .axiom-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
      gap: 1.25rem;
    }

    .axiom-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 1.25rem;
      cursor: pointer;
      transition: all 0.3s;
      position: relative;
      overflow: hidden;
    }

    .axiom-card:hover {
      transform: translateY(-2px);
      border-color: var(--border-light);
      box-shadow: 0 12px 24px rgba(0, 0, 0, 0.25);
    }

    .axiom-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0;
      width: 4px;
      height: 100%;
    }

    .axiom-card.meta::before { background: var(--meta-color); }
    .axiom-card.core::before { background: var(--core-color); }
    .axiom-card.derived::before { background: var(--derived-color); }
    .axiom-card.local::before { background: var(--local-color); }

    .axiom-card-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      margin-bottom: 0.75rem;
    }

    .axiom-card-id {
      font-size: 0.7rem;
      font-family: 'JetBrains Mono', monospace;
      color: var(--text-muted);
      background: rgba(255, 255, 255, 0.05);
      padding: 0.2rem 0.5rem;
      border-radius: 4px;
    }

    .axiom-card-level {
      font-size: 0.65rem;
      font-weight: 700;
      padding: 0.2rem 0.6rem;
      border-radius: 50px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .axiom-card.meta .axiom-card-level { background: rgba(212, 175, 55, 0.15); color: var(--meta-color); }
    .axiom-card.core .axiom-card-level { background: rgba(139, 92, 246, 0.15); color: var(--core-color); }
    .axiom-card.derived .axiom-card-level { background: rgba(59, 130, 246, 0.15); color: var(--derived-color); }
    .axiom-card.local .axiom-card-level { background: rgba(107, 114, 128, 0.15); color: var(--local-color); }

    .axiom-card-name {
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: 0.5rem;
      font-family: 'Noto Serif SC', serif;
    }

    .axiom-card-statement {
      font-size: 0.82rem;
      color: var(--text-secondary);
      line-height: 1.6;
      margin-bottom: 0.75rem;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .axiom-card-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: 0.75rem;
      border-top: 1px solid var(--border);
    }

    .axiom-card-hash {
      font-size: 0.65rem;
      font-family: 'JetBrains Mono', monospace;
      color: var(--text-muted);
    }

    .axiom-card-view {
      font-size: 0.75rem;
      color: var(--gold);
      display: flex;
      align-items: center;
      gap: 0.25rem;
    }

    /* 校验规则表格 */
    .rules-table {
      width: 100%;
      border-collapse: collapse;
      background: var(--bg-card);
      border-radius: 14px;
      overflow: hidden;
      border: 1px solid var(--border);
    }

    .rules-table th {
      background: var(--bg-secondary);
      padding: 1rem;
      text-align: left;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text-primary);
      border-bottom: 1px solid var(--border);
    }

    .rules-table td {
      padding: 0.875rem 1rem;
      font-size: 0.82rem;
      color: var(--text-secondary);
      border-bottom: 1px solid var(--border);
    }

    .rules-table tr:last-child td {
      border-bottom: none;
    }

    .rules-table tr:hover {
      background: var(--bg-card-hover);
    }

    .rule-id {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.75rem;
      color: var(--gold);
    }

    .rule-category {
      display: inline-block;
      padding: 0.2rem 0.6rem;
      border-radius: 50px;
      font-size: 0.7rem;
      font-weight: 600;
    }

    .rule-category.truth { background: rgba(212, 175, 55, 0.15); color: var(--gold); }
    .rule-category.compute { background: rgba(59, 130, 246, 0.15); color: var(--blue-light); }
    .rule-category.security { background: rgba(239, 68, 68, 0.15); color: var(--red); }
    .rule-category.evolution { background: rgba(16, 185, 129, 0.15); color: var(--green); }
    .rule-category.isolation { background: rgba(139, 92, 246, 0.15); color: var(--purple-light); }
    .rule-category.audit { background: rgba(245, 158, 11, 0.15); color: var(--orange); }
    .rule-category.fault { background: rgba(6, 182, 212, 0.15); color: var(--cyan); }
    .rule-category.standard { background: rgba(107, 114, 128, 0.15); color: var(--text-secondary); }

    /* 弹窗 */
    .modal-overlay {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0, 0, 0, 0.8);
      backdrop-filter: blur(8px);
      z-index: 2000;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 2rem;
    }

    .modal-overlay.active {
      display: flex;
    }

    .modal {
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: 20px;
      max-width: 700px;
      width: 100%;
      max-height: 85vh;
      overflow-y: auto;
      position: relative;
    }

    .modal-close {
      position: absolute;
      top: 1rem; right: 1rem;
      width: 36px; height: 36px;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 50%;
      color: var(--text-secondary);
      font-size: 1.25rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.3s;
      z-index: 10;
    }

    .modal-close:hover {
      background: var(--red);
      color: white;
      border-color: var(--red);
    }

    .modal-header {
      padding: 2rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--border);
    }

    .modal-level-badge {
      display: inline-block;
      padding: 0.3rem 0.8rem;
      border-radius: 50px;
      font-size: 0.75rem;
      font-weight: 700;
      margin-bottom: 1rem;
    }

    .modal-title {
      font-family: 'Noto Serif SC', serif;
      font-size: 1.75rem;
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: 0.5rem;
    }

    .modal-id {
      font-size: 0.8rem;
      font-family: 'JetBrains Mono', monospace;
      color: var(--text-muted);
    }

    .modal-body {
      padding: 2rem;
    }

    .modal-section {
      margin-bottom: 1.5rem;
    }

    .modal-section:last-child {
      margin-bottom: 0;
    }

    .modal-section-title {
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--gold);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 0.75rem;
    }

    .modal-section-content {
      font-size: 0.9rem;
      color: var(--text-secondary);
      line-height: 1.7;
    }

    .modal-math {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1rem;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.8rem;
      color: var(--cyan);
      overflow-x: auto;
    }

    .modal-corollaries {
      list-style: none;
    }

    .modal-corollaries li {
      padding: 0.5rem 0;
      padding-left: 1.5rem;
      position: relative;
      font-size: 0.85rem;
      color: var(--text-secondary);
      border-bottom: 1px solid var(--border);
    }

    .modal-corollaries li:last-child {
      border-bottom: none;
    }

    .modal-corollaries li::before {
      content: '◆';
      position: absolute;
      left: 0;
      color: var(--gold);
      font-size: 0.6rem;
      top: 0.65rem;
    }

    .modal-derived-from {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .derived-tag {
      padding: 0.3rem 0.75rem;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 6px;
      font-size: 0.75rem;
      font-family: 'JetBrains Mono', monospace;
      color: var(--text-muted);
    }

    /* 页脚 */
    .footer {
      background: var(--bg-secondary);
      border-top: 1px solid var(--border);
      padding: 2rem;
      text-align: center;
      margin-top: 3rem;
    }

    .footer-text {
      font-size: 0.8rem;
      color: var(--text-muted);
      margin-bottom: 0.5rem;
    }

    .footer-identity {
      font-size: 0.75rem;
      font-family: 'JetBrains Mono', monospace;
      color: var(--gold);
    }

    /* 响应式 */
    @media (max-width: 1200px) {
      .architecture-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .chart-row {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 768px) {
      .navbar-links {
        display: none;
      }
      .hero-title {
        font-size: 2rem;
      }
      .hero-stats {
        gap: 1.5rem;
      }
      .hero-stat-number {
        font-size: 1.75rem;
      }
      .architecture-grid {
        grid-template-columns: 1fr;
      }
      .axiom-grid {
        grid-template-columns: 1fr;
      }
      .section {
        padding: 2rem 1rem;
      }
      .chart-canvas {
        height: 400px;
      }
    }

    /* 滚动动画 */
    .reveal {
      opacity: 0;
      transform: translateY(30px);
      transition: all 0.6s ease;
    }

    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }
  </style>
</head>
<body>
  <!-- 背景粒子 -->
  <canvas class="bg-particles" id="particles"></canvas>

  <!-- 导航栏 -->
  <nav class="navbar">
    <div class="navbar-container">
      <a href="#" class="navbar-logo">
        <div class="navbar-logo-icon">元</div>
        <div>
          <div class="navbar-logo-text">元极恒一公理体系</div>
          <div class="navbar-logo-sub">Axiom-Driven Engine V1.0</div>
        </div>
      </a>
      <ul class="navbar-links">
        <li><a class="navbar-link active" href="#architecture">四层架构</a></li>
