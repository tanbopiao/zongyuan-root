  "alert_rules": [
    {
      "condition": "service_down",
      "level": "critical",
      "action": "auto_restart+notify"
    },
    {
      "condition": "cpu>90%",
      "level": "warning",
      "action": "notify+analyze"
    },
    {
      "condition": "memory>85%",
      "level": "warning",
      "action": "notify+analyze"
    },
    {
      "condition": "disk>85%",
      "level": "warning",
      "action": "notify+cleanup"
    },
    {
      "condition": "error_rate>5%",
      "level": "critical",
      "action": "auto_rollback+notify"
    },
    {
      "condition": "latency>3s",
      "level": "warning",
      "action": "notify+optimize"
    }
  ],
  "auto_healing": {
    "enabled": true,
    "max_retries": 3,
    "retry_interval": 10,
    "actions": [
      "restart_service",
      "clear_cache",
      "rollback",
      "scale_up"
    ]
  },
