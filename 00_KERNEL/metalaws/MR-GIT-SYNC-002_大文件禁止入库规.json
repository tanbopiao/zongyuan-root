{
  "rule_id": "MR-GIT-SYNC-002",
  "rule_name": "大文件禁止入库规则",
  "meta_class": "M9",
  "lock_level": 9,
  "description": "所有超过10MB的二进制文件（视频/模型/压缩包/音频）禁止直接入库。必须使用云盘存储或Git LFS，Git仓库只记录索引链接或LFS指针。当前已跟踪的113个MP4/17个BIN/15个压缩包需用git filter-repo从历史中清理。",
  "implementation": {
    "size_threshold": "10MB",
    "forbidden_types": [
      "*.mp4",
      "*.mov",
      "*.avi",
      "*.bin",
      "*.pt",
      "*.pth",
      "*.zip",
      "*.tar.gz",
      "*.gguf",
      "*.onnx"
    ],
    "alternative_storage": "云盘归档库 / Git LFS / 模型仓库",
    "cleanup_command": "git filter-repo --path-glob *.mp4 --path-glob *.bin --invert-paths"
  },
