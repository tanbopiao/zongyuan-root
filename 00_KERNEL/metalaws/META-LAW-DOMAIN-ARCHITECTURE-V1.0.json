{
  "law_id": "META-LAW-DOMAIN-ARCHITECTURE-V1.0",
  "law_name": "官网域名架构与子域体系",
  "version": "1.0",
  "timestamp": "2026-09-14T04:00:00Z",
  "did": "DID-BR-000002",
  "trace": "Ω₀⊂⊙∞⊂Ω",
  "brand": "火斗云智AIOS",
  "domain": "huodouai.com",

  "core_principle": "一律使用官网域名+子域名，禁止使用IP地址对外展示。所有架构体系、智能体、模块通过子域名统一入口，集成到官网主页导航，形成全自动化访问体系。",

  "domain_architecture": {
    "primary": {
      "domain": "www.huodouai.com",
      "purpose": "官网主页，统一导航入口",
      "features": ["导航菜单", "模块卡片", "架构概览", "系统状态"]
    },
    "subdomains": [
      {
        "domain": "architecture.huodouai.com",
        "purpose": "架构体系展示",
        "subpaths": ["/philosophy", "/evolution"]
      },
      {
        "domain": "agent.huodouai.com",
        "purpose": "智能体实体（网页即智能体）",
        "backend": "127.0.0.1:8080"
      },
      {
        "domain": "drama.huodouai.com",
        "purpose": "短剧流水线门户（昆仑洞天）"
      },
      {
        "domain": "gateway.huodouai.com",
        "purpose": "记忆网关（反向代理9120）",
        "backend": "127.0.0.1:9120"
      },
      {
        "domain": "ops.huodouai.com",
        "purpose": "运维监控面板"
      }
    ]
  },

  "navigation_integration": {
    "main_nav": ["首页", "架构体系", "智能体", "短剧流水线", "记忆网关", "哲学体系"],
    "auto_sync": true,
    "live_status": true
  },

  "full_automation": {
    "deploy_script": "deploy_website.sh",
    "nginx_config": "nginx_subdomains.conf",
    "auto_reload": true,
    "health_check": true
  },

  "prohibitions": [
    "禁止使用IP地址对外展示",
    "禁止直接暴露端口号给用户",
    "禁止子域之间权限越界"
  ],

  "enforcement": {
    "all_external_urls_must_use_domain": true,
    "all_modules_must_have_subdomain": true,
    "all_pages_must_link_back_to_main": true
  }
}
