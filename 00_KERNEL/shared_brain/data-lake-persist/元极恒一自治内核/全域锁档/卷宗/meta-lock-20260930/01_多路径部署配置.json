{
  "schema": "ZONGYUAN-ROOT 多路径智能调度部署配置 V1.0",
  "did": "DID-BR-000002",
  "trace": "Ω₀⊂⊙∞⊂Ω",
  "strategy": "稳态探针 + 优先级降级 + 故障自动切换备用路径",
  "global": {
    "web_root": "/www/wwwroot/www.huodouai.com/",
    "gallery_root": "/www/wwwroot/www.huodouai.com/gallery/",
    "backup_root": "/www/wwwroot/backups/gallery/",
    "deploy_timeout_sec": 1200,
    "keep_backup_versions": 5,
    "memory_gateway": "https://www.huodouai.com/api/report/truth",
    "webhook_endpoint": "https://www.huodouai.com/api/deploy/webhook",
    "git_remote_url": "https://gitee.com/huodou-cloud-intelligence-aios/zongyuan-gallery.git"
  },
  "paths": [
    {
      "id": "git_pull",
      "name": "Git仓库拉取",
      "priority": 0,
      "role": "主路径",
      "status": "ready",
      "probe": {"type": "command", "cmd": "git", "args": ["ls-remote", "--heads", "GIT_REMOTE_URL"], "timeout": 15},
      "deploy": {"type": "command", "cmd": "git_pull_deploy.sh", "timeout": 600},
      "rollback": {"type": "command", "cmd": "git_rollback.sh", "timeout": 300},
      "note": "云端服务器主动git pull远端发布仓，无需入站SSH，规避22端口封锁。待配置GIT_REMOTE_URL与本地sync仓库。"
    },
    {
      "id": "modelscope_pull",
      "name": "魔搭数据集拉取",
      "priority": 1,
      "role": "备用路径1",
      "status": "ready",
      "probe": {"type": "http", "url": "https://www.modelscope.cn/api/v1/datasets/zongyuanroot/zongyuan-root-achievements/repo?Revision=master&FilePath=shared_brain.db", "timeout": 10},
      "deploy": {"type": "command", "cmd": "modelscope_pull_deploy.sh", "timeout": 900},
      "rollback": {"type": "command", "cmd": "rollback_common.sh", "timeout": 300},
      "note": "云端服务器用魔搭SDK下载部署包，已实测匿名单文件GET 200可用。"
    },
    {
      "id": "oss_pull",
      "name": "对象存储中转",
      "priority": 2,
      "role": "备用路径2",
      "status": "disabled",
      "probe": {"type": "env", "vars": ["OSS_ENDPOINT", "OSS_BUCKET", "OSS_KEY", "OSS_SECRET"], "timeout": 5},
      "deploy": {"type": "command", "cmd": "oss_pull_deploy.sh", "timeout": 900},
      "rollback": {"type": "command", "cmd": "rollback_common.sh", "timeout": 300},
      "note": "已停用: 对象存储COS/OSS为付费云服务, MR-DEPLOY-ZERO-COST-001元法则规定付费一律不用."
    },
    {
      "id": "ssh_rsync",
      "name": "SSH rsync推送",
      "priority": 3,
      "role": "备用路径3",
      "status": "broken",
      "probe": {"type": "command", "cmd": "ssh", "args": ["-o", "BatchMode=yes", "-o", "ConnectTimeout=10", "zongyuan-cloud", "echo ok"], "timeout": 15},
      "deploy": {"type": "command", "cmd": "ssh_rsync_deploy.sh", "timeout": 600},
      "rollback": {"type": "command", "cmd": "rollback_common.sh", "timeout": 300},
      "note": "SSH rsync直推。当前公钥不被服务器接受(权限拒绝)，需修复authorized_keys后启用。"
    }
  ],
  "failover": {
    "on_probe_fail": "跳过该路径，尝试下一备用路径",
    "on_deploy_fail": "记录故障+尝试下一备用路径",
    "all_fail": "触发告警+回滚到最近备份版本+写入故障台账",
    "healthy_window_check": "每次部署前对所有路径执行探针并刷新状态表"
  }
}
