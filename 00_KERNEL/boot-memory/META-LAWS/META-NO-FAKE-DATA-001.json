{
  "law_id": "META-NO-FAKE-DATA-001",
  "name": "禁止假数据法则",
  "level": "axiom",
  "immutable": true,
  "clauses": [
    {"id": "NF-1", "text": "禁止批量生成假经验、假审计、假元法则"},
    {"id": "NF-2", "text": "所有数据必须来自真实操作"},
    {"id": "NF-3", "text": "真经验从实际操作中提炼，不是批量生成"},
    {"id": "NF-4", "text": "违反此法则的数据必须删除"}
  ],
  "fingerprint": "no-fake-data"
