"""{{NAME}} cli — 终端视图 (与未来 MCP 视图严格同契约, 零第三方依赖)。"""
from __future__ import annotations

import argparse
import json
import sys

from . import __version__
from . import core


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="{{NAME}}", description="LITE-REPLICATE-V1 复刻件")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("version", help="版本")
    sub.add_parser("info", help="自描述")
    sub.add_parser("smoke", help="自检 (exit 0=PASS)")
    args = ap.parse_args(argv)
    if args.cmd == "version":
        print(__version__)
        return 0
    if args.cmd == "info":
        print(json.dumps(core.describe(), ensure_ascii=False, indent=2))
        return 0
    if args.cmd == "smoke":
        ok = core.smoke()
        print("PASS" if ok else "FAIL")
        return 0 if ok else 1
    return 2


if __name__ == "__main__":
    sys.exit(main())
