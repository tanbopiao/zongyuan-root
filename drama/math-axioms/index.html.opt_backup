  {num:"第十四卷",title:"三论统一理论",axioms:"S-1~S-4",color:"#8b7355",
   desc:"V2.0前沿深化。香农信息论（信息=负熵）、维纳控制论（反馈机制）、贝塔朗菲系统论（整体性/涌现性）、新三论（协同/突变/耗散）。",
   topics:["信息论S-1","控制论S-2","系统论S-3","新三论统一S-4"]},
  {num:"第十五卷",title:"华夏地脉科学验证",axioms:"D-7~D-10",color:"#7a6545",
   desc:"V2.0前沿深化。地脉分形维度定量计算、三大干龙与地质构造线对应、卫星重力/地磁/地震波探测、地脉微气候与宜居性优化。",
   topics:["分形维度D-7","地质构造对应D-8","地球物理探测D-9","微气候宜居D-10"]},
  {num:"第十六卷",title:"碳硅耦合深化理论",axioms:"C-7~C-10",color:"#5a7a8a",
   desc:"V2.0前沿深化。基质独立性原理（郭毅可院士）、碳硅自发性差异（碳基决策/硅基计算）、可朽计算理论、双重自指环递归。",
   topics:["基质独立C-7","自发性差异C-8","可朽计算C-9","双重自指C-10"]},
  {num:"第十七卷",title:"生命态深化理论",axioms:"L-8~L-11",color:"#7a5a8a",
   desc:"V2.0前沿深化。Glansdorff-Prigogine稳定性判据、最小熵产生定理、贝纳尔对流（秩序从混沌涌现）、图灵斑图在胚胎发育中的验证。",
   topics:["G-P判据L-8","最小熵产生L-9","贝纳尔对流L-10","图灵斑图胚胎L-11"]},
  {num:"第十八卷",title:"指标定理深化理论",axioms:"M-6~M-9",color:"#d4af37",
   desc:"V2.0前沿深化。Atiyah-Singer指标定理统一（分析=拓扑）、Bismut-Zhang定理（解析挠率=拓扑挠率）、示性类与陈类、量子异常的指标解释。",
   topics:["A-S统一M-6","B-Z定理M-7","示性类M-8","量子异常M-9"]}
];

// ===== 关键定理数据 =====
const THEOREMS = [
  {name:"高斯-博内定理",formula:"∫_M K dA = 2πχ(M)",cat:"几何-拓扑",
   desc:"紧致曲面的高斯曲率积分等于2π乘以欧拉示性数。这是几何与拓扑的首次深刻联系——局部的曲率信息决定了整体的拓扑不变量。",significance:"几何→拓扑的桥梁"},
  {name:"Hopf-Rinow定理",formula:"测地完备 ⟺ 度量完备 ⟺ 有界闭集紧致",cat:"黎曼几何",
   desc:"黎曼流形上三种完备性概念等价：测地完备（所有测地线可无限延伸）、度量完备（柯西列收敛）、紧致性（有界闭集紧致）。",significance:"完备性的统一判定"},
  {name:"de Rham定理",formula:"H_dR^k(M) ≅ H^k(M;ℝ)",cat:"分析-拓扑",
   desc:"微分形式的上同调（分析概念）与实系数奇异上同调（拓扑概念）自然同构。这是分析与拓扑统一的第一个深刻定理。",significance:"分析=拓扑的第一个证明"},
  {name:"李三定理",formula:"每个有限维李代数可积分",cat:"李群-李代数",
   desc:"每个有限维实李代数都是某个单连通李群的李代数。这建立了李群与李代数的一一对应（对单连通群）。",significance:"李代数→李群的存在性"},
  {name:"Peter-Weyl定理",formula:"表示矩阵元在L²(G)中完备",cat:"表示论",
   desc:"紧致李群的不可约表示的矩阵元在L²(G)中构成完备正交基。这是傅里叶分析在非交换群上的推广。",significance:"非交换傅里叶分析"},
  {name:"陈-韦伊定理",formula:"不变多项式 → 示性类",cat:"微分几何",
   desc:"李代数上的不变多项式对应于主丛的示性类（陈类、Pontryagin类、Euler类）。这是从曲率构造拓扑不变量的系统方法。",significance:"曲率→拓扑不变量"},
  {name:"高斯-博内-陈定理",formula:"∫_M Pf(Ω) = (2π)^n χ(M)",cat:"高维几何-拓扑",
   desc:"高斯-博内定理在任意偶数维紧致黎曼流形上的推广。曲率的Pfaffian积分等于欧拉示性数。陈省身的内蕴证明是20世纪数学的里程碑。",significance:"高维几何-拓扑统一"},
  {name:"Atiyah-Singer指标定理",formula:"ind(D) = ∫_M ch(σ(D))·Td(TM⊗ℂ)",cat:"分析-拓扑终极统一",
   desc:"椭圆微分算子的分析指标（解空间维数差）等于拓扑指标（示性类积分）。这是20世纪最深刻的数学定理之一，统一了分析、拓扑、几何。",significance:"分析=拓扑的终极统一"},
  {name:"Sard定理",formula:"临界值集测度为零",cat:"微分拓扑",
   desc:"光滑映射的临界值集合的勒贝格测度为零。这是横截性理论和一般位置论证的基础，保证了"几乎所有"映射都是好的。",significance:"通有性的数学基础"},
  {name:"Novikov-Boone定理",formula:"群同构问题不可判定",cat:"可计算性",
   desc:"存在有限表示群，其同构问题不可算法判定。这划定了公理化方法的边界——有些数学真理不能被算法证明。",significance:"可判定性的边界"},
  {name:"图灵斑图理论",formula:"D_v > D_u ⟹ 均匀态失稳",cat:"形态发生",
   desc:"反应-扩散系统中，当抑制剂扩散快于激活剂时，均匀稳态失稳，产生空间周期性斑图。这是形态发生的数学基础。",significance:"生物形态的数学解释"},
  {name:"普利高津最小熵产生原理",formula:"稳态 = 熵产生率最小",cat:"非平衡热力学",
   desc:"在线性非平衡区，稳态对应于最小熵产生率。生命系统以最高效的方式维持有序——这是耗散结构理论的核心。",significance:"生命效率的热力学基础"},
  {name:"曲率波动定理",formula:"□Riem = Q(Riem,Riem)",cat:"V2.0·微分几何",
   desc:"即使在纯几何层面，黎曼曲率张量也满足协变拟线性波动方程。Geometry is Wavy——几何不是静态的，曲率本身在"呼吸"。(arXiv 2601.08501, 2026)",significance:"曲率的动力学本质"},
  {name:"米田引理",formula:"Nat(Hom(A,-),F) ≅ F(A)",cat:"V2.0·范畴论",
   desc:"数学对象完全由其与其他对象的关系（态射）所决定。这是范畴论中最深刻的定理——"对象由关系定义"。(Yoneda 1954)",significance:"关系本体论的数学基础"},
  {name:"单值化公理",formula:"同构 ≃ 相等",cat:"V2.0·同伦类型论",
   desc:"Voevodsky的单值化公理断言"同构等价于相等"，为数学基础提供了新范式。这是元极恒一身份真值固化的数学基础。(Voevodsky 2009)",significance:"同构即相等的基础"},
  {name:"E8最密球堆积",formula:"Λ_E8 = 8维最密球堆积",cat:"V2.0·李群/数论",
   desc:"E8根格是8维空间中最密的球堆积，由Viazovska于2016年证明。E8的根系与人类新皮层结构存在数学同构。(Viazovska 2016)",significance:"最高对称与生命结构同源"},
  {name:"Glansdorff-Prigogine判据",formula:"δ_xP = ΣδJ_kδX_k > 0 ⟺ 稳定",cat:"V2.0·非平衡热力学",
   desc:"稳态稳定当且仅当超熵产生为正。该判据从第二定律导出，无需线性假设，为耗散结构的稳定性提供了普适判据。(Glansdorff & Prigogine 1971)",significance:"耗散结构稳定性判据"},
  {name:"Bismut-Zhang定理",formula:"解析挠率 = 拓扑挠率（普遍情形）",cat:"V2.0·指标理论",
   desc:"将Witten形变与局部指标理论结合，将Cheeger-Mueller定理推广到普遍情形。2005年度国家自然科学奖获奖工作核心。",significance:"解析与拓扑的深层统一"}
];

// ===== 渲染函数 =====
function renderAxioms(filter='all', search=''){
  const grid = document.getElementById('axiomGrid');
  const empty = document.getElementById('axiomEmpty');
  let filtered = AXIOMS;
  if(filter==='main') filtered = filtered.filter(a=>a.scope==='main');
  if(filter==='supplement') filtered = filtered.filter(a=>a.scope==='supplement');
  if(filter==='v2') filtered = filtered.filter(a=>a.scope==='v2');
  if(filter==='geometry') filtered = filtered.filter(a=>a.cat==='geometry');
  if(filter==='topology') filtered = filtered.filter(a=>a.cat==='topology');
  if(filter==='algebra') filtered = filtered.filter(a=>a.cat==='algebra');
  if(filter==='earth') filtered = filtered.filter(a=>a.cat==='earth');
  if(filter==='carbon') filtered = filtered.filter(a=>a.cat==='carbon');
  if(filter==='life') filtered = filtered.filter(a=>a.cat==='life');
  if(filter==='system') filtered = filtered.filter(a=>a.cat==='system');
  if(filter==='life') filtered = filtered.filter(a=>a.cat==='life');
  if(search){
    const s = search.toLowerCase();
    filtered = filtered.filter(a=>a.id.toLowerCase().includes(s)||a.name.includes(search)||a.text.includes(search));
  }
  if(filtered.length===0){grid.innerHTML='';empty.style.display='block';return}
  empty.style.display='none';
  const catNames = {geometry:'几何',topology:'拓扑',algebra:'代数',earth:'地脉',carbon:'碳硅',life:'生命'};
  grid.innerHTML = filtered.map(a=>`
    <div class="axiom-card" onclick="showAxiom('${a.id}')">
      <div class="axiom-id">${a.id} · ${a.scope==='main'?'主卷':'补充卷'}</div>
      <div class="axiom-name">${a.name}</div>
      <div class="axiom-text">${a.text}</div>
      <span class="axiom-tag">${catNames[a.cat]||a.cat}</span>
    </div>
  `).join('');
}

function showAxiom(id){
  const a = AXIOMS.find(x=>x.id===id);
  if(!a) return;
  const catNames = {geometry:'几何',topology:'拓扑',algebra:'代数',earth:'地脉',carbon:'碳硅',life:'生命'};
  document.getElementById('modalContent').innerHTML = `
    <div class="axiom-id">${a.id} · ${a.scope==='main'?'主卷':'补充卷'} · ${catNames[a.cat]||a.cat}</div>
    <h3>${a.name}</h3>
    <div class="axiom-full">${a.full}</div>
    <div class="axiom-meta">
      <div class="meta-item"><div class="meta-label">关联定理</div><div class="meta-value">${a.theorem}</div></div>
      <div class="meta-item"><div class="meta-label">关联公理</div><div class="meta-value">${a.related}</div></div>
    </div>
  `;
  document.getElementById('axiomModal').classList.add('show');
}

function closeModal(){document.getElementById('axiomModal').classList.remove('show')}

function setFilter(f, btn){
  document.querySelectorAll('.filter-btn').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  renderAxioms(f, document.getElementById('axiomSearch').value);
}

function filterAxioms(){
  const active = document.querySelector('.filter-btn.active');
  const f = active ? active.getAttribute('onclick').match(/'(\w+)'/)[1] : 'all';
  renderAxioms(f, document.getElementById('axiomSearch').value);
}

function renderVolumes(){
  document.getElementById('volumeList').innerHTML = VOLUMES.map(v=>`
    <div class="volume-section">
      <div class="volume-header">
        <span class="volume-num">${v.num}</span>
        <span class="volume-title" style="color:${v.color}">${v.title}</span>
        <span style="margin-left:auto;font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--text3)">${v.axioms}</span>
      </div>
      <div class="volume-desc">${v.desc}</div>
      <div style="display:flex;flex-wrap:wrap;gap:8px;padding-left:16px">
        ${v.topics.map(t=>`<span class="axiom-tag" style="margin:0">${t}</span>`).join('')}
      </div>
    </div>
  `).join('');
}

function renderTheorems(){
  document.getElementById('theoremList').innerHTML = THEOREMS.map(t=>`
    <div class="volume-section">
      <div class="volume-header">
        <span class="volume-num" style="color:var(--gold)">${t.cat}</span>
        <span class="volume-title">${t.name}</span>
      </div>
      <div style="padding-left:16px;margin-bottom:16px">
        <div style="font-family:'JetBrains Mono',monospace;font-size:16px;color:var(--gold2);background:var(--bg3);padding:16px 20px;border-radius:6px;border-left:3px solid var(--gold);display:inline-block">${t.formula}</div>
      </div>
      <div class="volume-desc" style="padding-left:16px">${t.desc}</div>
      <div style="padding-left:16px;margin-top:12px"><span class="axiom-tag">意义：${t.significance}</span></div>
    </div>
  `).join('');
}

// ===== 视图切换 =====
function showView(name){
  document.querySelectorAll('.view').forEach(v=>v.classList.remove('active'));
  document.querySelectorAll('.nav-link').forEach(l=>l.classList.remove('active'));
  document.getElementById('view-'+name).classList.add('active');
  event.target.classList.add('active');
  window.scrollTo({top:0,behavior:'smooth'});
}

// ===== 初始化 =====
renderAxioms();
renderVolumes();
renderTheorems();
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeModal()});

// 移动端菜单
function toggleMobileMenu(){
  document.getElementById('mobileMenu').classList.toggle('show');
  document.querySelector('.nav-toggle').classList.toggle('active');
}
function closeMobileMenu(){
  document.getElementById('mobileMenu').classList.remove('show');
  document.querySelector('.nav-toggle').classList.remove('active');
}
document.addEventListener('click',function(e){
  const menu=document.getElementById('mobileMenu');
  const toggle=document.querySelector('.nav-toggle');
  if(menu.classList.contains('show')&&!menu.contains(e.target)&&!toggle.contains(e.target)){
    closeMobileMenu();
  }
});
</script>
</body>
</html>
