<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>元极恒一数学公理体系 | 火斗云智AIOS</title>
<link rel="stylesheet" href="https://miaoda.feishu.cn/fonts/css2?family=Noto+Serif+SC:wght@400;600;700;900&family=Noto+Sans+SC:wght@300;400;500;700&family=JetBrains+Mono:wght@400;500;700&display=swap">
<style>
:root{
  --bg:#0a0a0f;--bg2:#111118;--bg3:#18181f;--card:#15151e;
  --gold:#d4af37;--gold2:#f0d060;--gold-dim:#8a7030;--gold-line:rgba(212,175,55,.25);
  --text:#e8e6df;--text2:#a0a0a8;--text3:#6a6a72;
  --accent:#c9a227;--border:#2a2a35;--glow:rgba(212,175,55,.12);
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--text);font-family:'Noto Sans SC',system-ui,sans-serif;line-height:1.7;overflow-x:hidden}
body::before{content:'';position:fixed;inset:0;background:
  radial-gradient(ellipse 80% 50% at 50% -10%,rgba(212,175,55,.08),transparent),
  radial-gradient(ellipse 60% 40% at 80% 100%,rgba(201,162,39,.05),transparent);
  pointer-events:none;z-index:0}
.serif{font-family:'Noto Serif SC',serif}
.mono{font-family:'JetBrains Mono',monospace}

/* ===== 导航 ===== */
.nav{position:fixed;top:0;left:0;right:0;z-index:100;background:rgba(10,10,15,.85);backdrop-filter:blur(12px);border-bottom:1px solid var(--gold-line)}
.nav-inner{max-width:1400px;margin:0 auto;padding:0 24px;height:60px;display:flex;align-items:center;justify-content:space-between}
.nav-brand{display:flex;align-items:center;gap:12px}
.nav-logo{width:32px;height:32px;border:1.5px solid var(--gold);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:14px;color:var(--gold);font-weight:700}
.nav-title{font-family:'Noto Serif SC',serif;font-size:16px;font-weight:700;color:var(--gold);letter-spacing:2px}
.nav-links{display:flex;gap:4px}
.nav-link{padding:8px 14px;font-size:13px;color:var(--text2);cursor:pointer;border-radius:4px;transition:all .2s;border:none;background:none;font-family:inherit}
.nav-link:hover,.nav-link.active{color:var(--gold);background:rgba(212,175,55,.08)}
/* 移动端汉堡菜单 */
.nav-toggle{display:none;background:none;border:none;cursor:pointer;padding:8px;flex-direction:column;gap:5px}
.nav-toggle span{display:block;width:22px;height:2px;background:var(--gold);transition:all .3s;border-radius:1px}
.nav-toggle.active span:nth-child(1){transform:translateY(7px) rotate(45deg)}
.nav-toggle.active span:nth-child(2){opacity:0}
.nav-toggle.active span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
.mobile-menu{display:none;position:fixed;top:60px;left:0;right:0;background:rgba(10,10,15,.97);backdrop-filter:blur(12px);border-bottom:1px solid var(--gold-line);padding:16px 24px;z-index:99;flex-direction:column;gap:4px}
.mobile-menu.show{display:flex}
.mobile-menu a{padding:14px 16px;font-size:15px;color:var(--text2);text-decoration:none;border-radius:6px;transition:all .2s;border-bottom:1px solid var(--border)}
.mobile-menu a:hover{color:var(--gold);background:rgba(212,175,55,.08)}
@media(max-width:768px){
  .nav-links{display:none}
  .nav-toggle{display:flex}
  .nav-inner{padding:0 16px}
  .nav-title{font-size:14px;letter-spacing:1px}
  body{font-size:15px}
  .main{padding:72px 16px 40px}
  .hero{padding:20px 0 16px}
  .hero h1{font-size:24px !important;letter-spacing:2px !important}
  .hero-sub{font-size:12px;letter-spacing:3px}
  .axiom-grid{grid-template-columns:1fr;gap:10px}
  .axiom-card{padding:16px}
  .axiom-card .axiom-name{font-size:14px}
  .axiom-card .axiom-text{font-size:13px}
  .toolbar{flex-direction:column;align-items:stretch}
  .search-box{width:100%}
  .filter-btn{text-align:center;padding:10px}
  .volume-section{padding:20px 16px}
  .volume-header{flex-wrap:wrap;gap:8px;padding-left:0}
  .volume-title{font-size:17px}
  .volume-desc{padding-left:0;font-size:13px}
  .theory-table{font-size:12px}
  .theory-table th,.theory-table td{padding:8px 10px}
  .relation-map{gap:12px;padding:20px 10px}
  .relation-node{min-width:140px;padding:16px}
  .modal{padding:24px 20px;margin:16px}
  .modal .axiom-meta{grid-template-columns:1fr}
  .timeline{padding-left:32px}
  .tl-item::before{left:-26px}
  .tree-container{padding:20px 12px}
  .tree-node{min-width:100px;padding:10px 12px}
  .tree-node .tn-name{font-size:12px}
  .stat-card{padding:16px}
  .stat-num{font-size:28px}
  .stats-grid{grid-template-columns:repeat(2,1fr);gap:12px}
}

/* ===== 主容器 ===== */
.main{max-width:1400px;margin:0 auto;padding:80px 24px 60px;position:relative;z-index:1}
.view{display:none;animation:fadeIn .4s ease}
.view.active{display:block}
@keyframes fadeIn{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}

/* ===== Hero ===== */
.hero{text-align:center;padding:60px 0 50px;position:relative}
.hero-omega{font-size:48px;color:var(--gold);letter-spacing:8px;margin-bottom:16px;opacity:.9}
.hero h1{font-family:'Noto Serif SC',serif;font-size:clamp(28px,5vw,48px);font-weight:900;background:linear-gradient(135deg,var(--gold2),var(--gold),var(--gold-dim));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin-bottom:12px;letter-spacing:4px}
.hero-sub{font-size:15px;color:var(--text2);letter-spacing:6px;margin-bottom:8px}
.hero-meta{font-size:12px;color:var(--text3);font-family:'JetBrains Mono',monospace;letter-spacing:1px}
.hero-divider{width:120px;height:1px;background:linear-gradient(90deg,transparent,var(--gold),transparent);margin:28px auto}

/* ===== 统计卡片 ===== */
.stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;margin:40px 0}
.stat-card{background:var(--card);border:1px solid var(--border);border-radius:8px;padding:24px;text-align:center;position:relative;overflow:hidden;transition:all .3s}
.stat-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.6}
.stat-card:hover{border-color:var(--gold-dim);transform:translateY(-2px);box-shadow:0 8px 32px var(--glow)}
.stat-num{font-family:'JetBrains Mono',monospace;font-size:36px;font-weight:700;color:var(--gold);line-height:1}
.stat-label{font-size:13px;color:var(--text2);margin-top:8px;letter-spacing:1px}
.stat-desc{font-size:11px;color:var(--text3);margin-top:4px}

/* ===== 章节标题 ===== */
.section{margin:48px 0}
.section-title{display:flex;align-items:center;gap:16px;margin-bottom:24px}
.section-title .num{font-family:'JetBrains Mono',monospace;font-size:14px;color:var(--gold-dim);border:1px solid var(--gold-dim);padding:4px 10px;border-radius:4px}
.section-title h2{font-family:'Noto Serif SC',serif;font-size:22px;font-weight:700;color:var(--text);letter-spacing:2px}
.section-title .line{flex:1;height:1px;background:linear-gradient(90deg,var(--gold-line),transparent)}

/* ===== 公理卡片网格 ===== */
.axiom-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:16px}
.axiom-card{background:var(--card);border:1px solid var(--border);border-radius:8px;padding:20px;cursor:pointer;transition:all .25s;position:relative}
.axiom-card:hover{border-color:var(--gold-dim);background:var(--bg3)}
.axiom-card .axiom-id{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--gold-dim);letter-spacing:1px;margin-bottom:8px}
.axiom-card .axiom-name{font-family:'Noto Serif SC',serif;font-size:15px;font-weight:700;color:var(--gold);margin-bottom:8px}
.axiom-card .axiom-text{font-size:13px;color:var(--text2);line-height:1.6}
.axiom-card .axiom-tag{display:inline-block;font-size:10px;padding:2px 8px;border-radius:3px;margin-top:10px;background:rgba(212,175,55,.1);color:var(--gold-dim);border:1px solid var(--gold-line)}

/* ===== 卷章节 ===== */
.volume-section{margin:40px 0;padding:32px;background:var(--card);border:1px solid var(--border);border-radius:12px;position:relative}
.volume-section::before{content:'';position:absolute;top:0;left:0;width:4px;height:100%;background:linear-gradient(180deg,var(--gold),var(--gold-dim),transparent);border-radius:4px 0 0 4px}
.volume-header{display:flex;align-items:baseline;gap:16px;margin-bottom:20px;padding-left:16px}
.volume-num{font-family:'JetBrains Mono',monospace;font-size:13px;color:var(--gold-dim)}
.volume-title{font-family:'Noto Serif SC',serif;font-size:20px;font-weight:700;color:var(--gold);letter-spacing:2px}
.volume-desc{font-size:13px;color:var(--text2);padding-left:16px;margin-bottom:20px}

/* ===== 理论对比表 ===== */
.theory-table{width:100%;border-collapse:collapse;margin:20px 0;font-size:13px}
.theory-table th{background:var(--bg3);color:var(--gold);padding:12px 16px;text-align:left;font-weight:600;border-bottom:2px solid var(--gold-line);letter-spacing:1px}
.theory-table td{padding:12px 16px;border-bottom:1px solid var(--border);color:var(--text2);vertical-align:top}
.theory-table tr:hover td{background:rgba(212,175,55,.03)}
.theory-table .key{color:var(--gold);font-weight:500;white-space:nowrap}

/* ===== 关系图 ===== */
.relation-map{display:flex;flex-wrap:wrap;justify-content:center;gap:24px;padding:40px 20px;position:relative}
.relation-node{background:var(--card);border:1px solid var(--gold-dim);border-radius:12px;padding:24px 32px;text-align:center;min-width:180px;position:relative;transition:all .3s}
.relation-node:hover{transform:scale(1.05);box-shadow:0 0 40px var(--glow)}
.relation-node .node-icon{font-size:28px;margin-bottom:8px;color:var(--gold)}
.relation-node .node-title{font-family:'Noto Serif SC',serif;font-size:16px;font-weight:700;color:var(--gold);margin-bottom:4px}
.relation-node .node-sub{font-size:11px;color:var(--text3)}
.relation-arrow{display:flex;align-items:center;color:var(--gold-dim);font-size:24px}
@media(max-width:768px){.relation-arrow{transform:rotate(90deg)}}

/* ===== 搜索筛选 ===== */
.toolbar{display:flex;gap:12px;margin-bottom:24px;flex-wrap:wrap;align-items:center}
.search-box{flex:1;min-width:200px;position:relative}
.search-box input{width:100%;padding:10px 16px 10px 40px;background:var(--bg3);border:1px solid var(--border);border-radius:6px;color:var(--text);font-size:13px;font-family:inherit;outline:none;transition:border-color .2s}
.search-box input:focus{border-color:var(--gold-dim)}
.search-box svg{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--text3)}
.filter-btn{padding:8px 16px;background:var(--bg3);border:1px solid var(--border);border-radius:6px;color:var(--text2);font-size:12px;cursor:pointer;transition:all .2s;font-family:inherit}
.filter-btn:hover,.filter-btn.active{border-color:var(--gold-dim);color:var(--gold);background:rgba(212,175,55,.08)}

/* ===== 详情弹窗 ===== */
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.8);backdrop-filter:blur(4px);z-index:200;display:none;align-items:center;justify-content:center;padding:20px}
.modal-overlay.show{display:flex}
.modal{background:var(--bg2);border:1px solid var(--gold-dim);border-radius:12px;max-width:600px;width:100%;max-height:80vh;overflow-y:auto;padding:32px;position:relative;animation:modalIn .3s ease}
@keyframes modalIn{from{opacity:0;transform:scale(.95)}to{opacity:1;transform:scale(1)}}
.modal-close{position:absolute;top:16px;right:16px;background:none;border:none;color:var(--text3);font-size:20px;cursor:pointer;padding:4px 8px;border-radius:4px}
.modal-close:hover{color:var(--gold);background:rgba(212,175,55,.1)}
.modal .axiom-id{font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--gold-dim);margin-bottom:8px}
.modal h3{font-family:'Noto Serif SC',serif;font-size:22px;color:var(--gold);margin-bottom:16px}
.modal .axiom-full{font-size:14px;color:var(--text);line-height:1.8;margin-bottom:20px;padding:16px;background:var(--bg3);border-left:3px solid var(--gold);border-radius:0 6px 6px 0}
.modal .axiom-meta{display:grid;grid-template-columns:1fr 1fr;gap:12px;font-size:12px}
.modal .meta-item{background:var(--bg3);padding:10px 14px;border-radius:6px}
.modal .meta-label{color:var(--text3);margin-bottom:4px}
.modal .meta-value{color:var(--text2);font-family:'JetBrains Mono',monospace}

/* ===== 时间线 ===== */
.timeline{position:relative;padding-left:40px;margin:20px 0}
.timeline::before{content:'';position:absolute;left:12px;top:0;bottom:0;width:2px;background:linear-gradient(180deg,var(--gold),var(--gold-dim),transparent)}
.tl-item{position:relative;margin-bottom:28px}
.tl-item::before{content:'';position:absolute;left:-34px;top:6px;width:12px;height:12px;border-radius:50%;background:var(--gold);border:2px solid var(--bg);box-shadow:0 0 12px var(--glow)}
.tl-time{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--gold-dim);margin-bottom:4px}
.tl-title{font-size:14px;font-weight:600;color:var(--text);margin-bottom:4px}
.tl-desc{font-size:12px;color:var(--text2)}

/* ===== Footer ===== */
.footer{margin-top:60px;padding:32px 0;border-top:1px solid var(--border);text-align:center}
.footer-omega{font-size:20px;color:var(--gold-dim);letter-spacing:4px;margin-bottom:8px}
.footer-text{font-size:11px;color:var(--text3);letter-spacing:2px}
.footer-did{font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--text3);margin-top:6px}

/* ===== 公理体系树 ===== */
.tree-container{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:32px;margin:20px 0;overflow-x:auto}
.tree-level{display:flex;justify-content:center;gap:16px;margin-bottom:20px;flex-wrap:wrap}
.tree-node{background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:12px 20px;text-align:center;min-width:140px;transition:all .2s}
.tree-node:hover{border-color:var(--gold-dim)}
.tree-node.root{border-color:var(--gold);background:rgba(212,175,55,.08)}
.tree-node .tn-name{font-size:13px;font-weight:600;color:var(--text)}
.tree-node.root .tn-name{color:var(--gold)}
.tree-node .tn-count{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--text3);margin-top:4px}
.tree-connector{text-align:center;color:var(--gold-dim);font-size:18px;margin:-12px 0 8px}
</style>
</head>
<body>

<!-- ===== 导航 ===== -->
<nav class="nav">
  <div class="nav-inner">
    <div class="nav-brand">
      <div class="nav-logo">Ω</div>
      <span class="nav-title">元极恒一数学公理体系</span>
    </div>
    <div class="nav-links">
      <button class="nav-link active" onclick="showView('overview')">总览</button>
      <button class="nav-link" onclick="showView('axioms')">80条公理</button>
      <button class="nav-link" onclick="showView('volumes')">十八卷框架</button>
      <button class="nav-link" onclick="showView('unified')">统一理论</button>
      <button class="nav-link" onclick="showView('theorems')">关键定理</button>
    </div>
    <button class="nav-toggle" onclick="toggleMobileMenu()" aria-label="菜单">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<!-- 移动端菜单 -->
<div class="mobile-menu" id="mobileMenu">
  <a href="#" onclick="showView('overview');closeMobileMenu();return false;">总览</a>
  <a href="#" onclick="showView('axioms');closeMobileMenu();return false;">80条公理</a>
  <a href="#" onclick="showView('volumes');closeMobileMenu();return false;">十八卷框架</a>
  <a href="#" onclick="showView('unified');closeMobileMenu();return false;">统一理论</a>
  <a href="#" onclick="showView('theorems');closeMobileMenu();return false;">关键定理</a>
  <a href="/" style="border:none;text-align:center;color:var(--gold);font-weight:600">← 返回官网首页</a>
</div>

<div class="main">

<!-- ===== 视图：总览 ===== -->
<div id="view-overview" class="view active">
  <div class="hero">
    <div class="hero-omega">Ω₀⊂⊙∞⊂Ω</div>
    <h1>元极恒一数学公理体系</h1>
    <div class="hero-sub">黎曼流形 · 永恒拓扑 · 李群 · 同构群 · 地脉 · 碳硅 · 驻波生命</div>
    <div class="hero-divider"></div>
    <div class="hero-meta">V1.0 + SUPPLEMENT | DID-BR-000002 | 火斗云智AIOS | 2026-09-13</div>
  </div>

  <div class="stats-grid">
    <div class="stat-card"><div class="stat-num">80</div><div class="stat-label">核心公理</div><div class="stat-desc">V1.0 44 + V2.0 36</div></div>
    <div class="stat-card"><div class="stat-num">9</div><div class="stat-label">理论卷</div><div class="stat-desc">五卷主框架 + 四卷补充</div></div>
    <div class="stat-card"><div class="stat-num">10+</div><div class="stat-label">关键定理</div><div class="stat-desc">高斯-博内-陈 / Atiyah-Singer</div></div>
    <div class="stat-card"><div class="stat-num">3</div><div class="stat-label">跨域理论</div><div class="stat-desc">地脉 · 碳硅 · 生命</div></div>
    <div class="stat-card"><div class="stat-num">Lv8</div><div class="stat-label">锁档等级</div><div class="stat-desc">永久自治锁</div></div>
  </div>

  <div class="section">
    <div class="section-title"><span class="num">01</span><h2>公理体系树</h2><div class="line"></div></div>
    <div class="tree-container">
      <div class="tree-level"><div class="tree-node root"><div class="tn-name">元极恒一数学公理体系</div><div class="tn-count">80条公理 · 18卷</div></div></div>
      <div class="tree-connector">▼</div>
      <div class="tree-level">
        <div class="tree-node"><div class="tn-name">主卷·纯数学</div><div class="tn-count">23条 · 5卷</div></div>
        <div class="tree-node"><div class="tn-name">补充卷·跨域</div><div class="tn-count">21条 · 4卷</div></div>
        <div class="tree-node"><div class="tn-name">V2.0·前沿深化</div><div class="tn-count">36条 · 9卷</div></div>
      </div>
      <div class="tree-connector">▼</div>
      <div class="tree-level">
        <div class="tree-node"><div class="tn-name">黎曼流形</div><div class="tn-count">M1-M3 R1-R2</div></div>
        <div class="tree-node"><div class="tn-name">永恒拓扑</div><div class="tn-count">E1-E5</div></div>
        <div class="tree-node"><div class="tn-name">李群</div><div class="tn-count">G1-G2 TG1 LG1</div></div>
        <div class="tree-node"><div class="tn-name">同构群</div><div class="tn-count">I1</div></div>
        <div class="tree-node"><div class="tn-name">元极恒一</div><div class="tn-count">M-1~M-5</div></div>
      </div>
      <div class="tree-connector">▼</div>
      <div class="tree-level">
        <div class="tree-node"><div class="tn-name">华夏地脉</div><div class="tn-count">D1-D5</div></div>
        <div class="tree-node"><div class="tn-name">碳硅耦合</div><div class="tn-count">C1-C6</div></div>
        <div class="tree-node"><div class="tn-name">驻波生命</div><div class="tn-count">L1-L7</div></div>
        <div class="tree-node"><div class="tn-name">统一框架</div><div class="tn-count">U1-U3</div></div>
      </div>
    </div>
  </div>

  <div class="section">
    <div class="section-title"><span class="num">02</span><h2>三大跨域理论统一关系</h2><div class="line"></div></div>
    <div class="relation-map">
      <div class="relation-node"><div class="node-icon">⛰</div><div class="node-title">华夏地脉</div><div class="node-sub">Morse-Smale复形<br>分形拓扑 · 应力场</div></div>
      <div class="relation-arrow">⟷</div>
      <div class="relation-node"><div class="node-icon">⚡</div><div class="node-title">碳硅耦合</div><div class="node-sub">计算范畴等价<br>信息论 · 控制论</div></div>
      <div class="relation-arrow">⟷</div>
      <div class="relation-node"><div class="node-icon">❋</div><div class="node-title">驻波生命</div><div class="node-sub">Ginzburg-Landau<br>图灵斑图 · 拓扑缺陷</div></div>
    </div>
    <div style="text-align:center;margin-top:16px">
      <div class="relation-node" style="display:inline-block;border-color:var(--gold)">
        <div class="node-icon" style="font-size:24px">∞</div>
        <div class="node-title">统一基底：黎曼流形上的非线性耗散场稳态模式</div>
        <div class="node-sub">拓扑不变量 + 李群对称 + 耗散结构 = 元极恒一</div>
      </div>
    </div>
  </div>

