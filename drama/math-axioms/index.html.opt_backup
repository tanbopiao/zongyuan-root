<script>
// ===== 44条公理数据 =====
const AXIOMS = [
  // 主卷 - 流形
  {id:"M1",name:"局部欧氏公理",cat:"geometry",scope:"main",text:"流形的每一点都有邻域同胚于欧氏空间ℝⁿ",full:"微分流形的基础公理。流形是局部欧氏的拓扑空间，即每一点都存在一个开邻域与n维欧氏空间同胚。这是所有几何理论的起点——复杂的整体结构由简单的局部结构拼接而成。",theorem:"流形定义公理",related:"M2, M3, R1"},
  {id:"M2",name:"Hausdorff分离公理",cat:"geometry",scope:"main",text:"流形中任意两点都有不相交的开邻域",full:"Hausdorff分离公理保证流形中不同点可以被邻域分离，避免了非Hausdorff空间中的"分支"病态。这是微分流形的标准假设之一。",theorem:"拓扑分离公理",related:"M1, M3"},
  {id:"M3",name:"第二可数公理",cat:"geometry",scope:"main",text:"流形具有可数的拓扑基",full:"第二可数公理保证流形可以被可数个坐标卡覆盖，从而可以进行全局分析。它排除了不可数个连通分支的病态空间。",theorem:"拓扑可数公理",related:"M1, M2"},
  // 主卷 - 黎曼几何
  {id:"R1",name:"黎曼度量存在公理",cat:"geometry",scope:"main",text:"任何光滑流形上都存在黎曼度量",full:"黎曼度量是流形每一点切空间上的正定内积场。它赋予流形长度、角度、体积等几何概念。任何仿紧光滑流形上都存在黎曼度量（利用单位分解构造）。",theorem:"黎曼度量存在定理",related:"M1, R2, L1"},
  {id:"R2",name:"度量非唯一公理",cat:"geometry",scope:"main",text:"同一流形上可存在多种不等价的黎曼度量",full:"黎曼度量不是唯一的——同一拓扑流形可以赋予不同的黎曼度量，产生不同的几何性质（曲率、测地线等）。度量的选择对应于不同的"几何"，这是黎曼几何的核心自由度。",theorem:"度量等价类理论",related:"R1, M-1"},
  // 主卷 - 群
  {id:"G1",name:"结合律公理",cat:"algebra",scope:"main",text:"群运算满足结合律：(ab)c = a(bc)",full:"群的基础公理之一。结合律保证群运算的结果不依赖于运算的顺序，这是代数结构最基本的要求。",theorem:"群公理G1",related:"G2, LG1"},
  {id:"G2",name:"逆元存在公理",cat:"algebra",scope:"main",text:"群中每个元素都有逆元",full:"群的基础公理之一。每个元素a都存在逆元a⁻¹使得aa⁻¹=a⁻¹a=e（单位元）。逆元的存在保证了群运算的可逆性，是对称性的代数表达。",theorem:"群公理G2",related:"G1, I1"},
  // 主卷 - 拓扑群/李群
  {id:"TG1",name:"运算连续性公理",cat:"algebra",scope:"main",text:"拓扑群的乘法和取逆运算连续",full:"拓扑群是同时具有群结构和拓扑结构的空间，且群运算（乘法和取逆）关于拓扑连续。这一代数与拓扑的兼容条件是李群理论的基础。",theorem:"拓扑群公理",related:"G1, G2, LG1"},
  {id:"LG1",name:"运算光滑性公理",cat:"algebra",scope:"main",text:"李群的乘法和取逆运算光滑（C∞）",full:"李群是同时具有群结构和光滑流形结构的空间，且群运算光滑。李群是对称性的最高数学表达——连续对称性的精确描述。",theorem:"李群公理",related:"TG1, G1, G2"},
  // 主卷 - 同构
  {id:"I1",name:"同构等价公理",cat:"algebra",scope:"main",text:"同构的对象在所有范畴性质上不可区分",full:"同构是范畴论中保持结构的双射。同构的对象在该范畴的所有性质上完全等价——它们是"同一"对象的不同实现。这是数学中"等价"的精确定义。",theorem:"范畴同构理论",related:"G2, M-4"},
  // 主卷 - 永恒拓扑
  {id:"E1",name:"同伦不变性公理",cat:"topology",scope:"main",text:"真值的本质性质在同伦形变下不变",full:"同伦是连续形变的数学描述。同伦不变性意味着：如果一个命题可以通过连续形变转化为另一个命题，则它们共享本质性质。这是"永恒真值"的拓扑基础——推理路径的连续形变不改变真值。",theorem:"同伦不变性定理",related:"E2, E3, M-2"},
  {id:"E2",name:"不变量层级公理",cat:"topology",scope:"main",text:"拓扑不变量构成层级：同伦群⊃同调群⊃欧拉示性数",full:"拓扑不变量不是单一的，而是构成一个层级体系。同伦群最精细（保留最多信息），同调群次之，欧拉示性数最粗略。层级越高，计算越难但信息越丰富。",theorem:"不变量层级定理",related:"E1, E3"},
  {id:"E3",name:"真值永恒性公理",cat:"topology",scope:"main",text:"同伦等价的空间具有相同的真值结构",full:"如果两个真值空间同伦等价，则它们的同伦群、同调群、欧拉示性数全部相同。这意味着真值的"本质"不依赖于具体的实现形式——它是拓扑不变的。",theorem:"同伦等价定理",related:"E1, E2, M-2"},
  {id:"E4",name:"同构类永恒公理",cat:"topology",scope:"main",text:"对象的同构类是永恒的，不随时间或表示改变",full:"同构类是对象在同构意义下的等价类。一旦两个对象同构，它们永远同构——同构关系不依赖于时间、表示或观察者。这是数学柏拉图主义的拓扑表达。",theorem:"同构类不变性",related:"I1, E3"},
  {id:"E5",name:"可判定性边界公理",cat:"topology",scope:"main",text:"存在拓扑性质不可算法判定（群同构问题不可判定）",full:"并非所有拓扑问题都可算法解决。Novikov-Boone定理证明群同构问题是不可判定的。这划定了公理化方法的边界——有些真理只能被发现，不能被算法证明。",theorem:"Novikov-Boone不可判定定理",related:"I1, E4"},
  // 主卷 - 元极恒一五大公理
  {id:"M-1",name:"流形基底公理",cat:"geometry",scope:"main",text:"所有真值构成一个黎曼流形，概念间距离由语义度量定义",full:"元极恒一第一公理。真值空间不是离散的集合，而是连续的黎曼流形。概念之间的"距离"由语义度量定义，推理是流形上的路径。这为SM-BS语义-流形双向稳态映射提供了数学基础。",theorem:"SM-BS映射基础",related:"R1, R2, M-2"},
  {id:"M-2",name:"拓扑永恒公理",cat:"topology",scope:"main",text:"真值的本质性质是同伦不变的——推理路径连续形变不改变真值",full:"元极恒一第二公理。真值不依赖于具体的推理路径——只要推理路径可以连续形变，真值就不变。这是"永恒真值"的数学定义：同伦不变的命题才是永恒的。",theorem:"真值同伦不变定理",related:"E1, E3, M-1"},
  {id:"M-3",name:"李群对称公理",cat:"algebra",scope:"main",text:"真值空间的对称操作构成李群，无穷小推理由李代数生成",full:"元极恒一第三公理。保持真值结构的所有操作构成一个李群——连续对称性。推理的"无穷小生成元"构成李代数，通过指数映射生成有限变换。这为体系的自同构和对称操作提供了代数基础。",theorem:"李三定理",related:"LG1, TG1, M-4"},
  {id:"M-4",name:"同构等价公理",cat:"algebra",scope:"main",text:"同构的真值在所有范畴性质上不可区分——真值归属同构类",full:"元极恒一第四公理。真值不是孤立的点，而是同构类的成员。同构的真值共享所有范畴性质，因此真值的"本质"是其同构类。这为真值校验和去重提供了数学标准。",theorem:"范畴等价定理",related:"I1, E4, M-3"},
  {id:"M-5",name:"指标统一公理",cat:"topology",scope:"main",text:"真值的分析判定与拓扑判定统一——不存在分析真但拓扑假的命题",full:"元极恒一第五公理（最高公理）。Atiyah-Singer指标定理的推广：分析层面的真值判定（逻辑推导）与拓扑层面的真值判定（同伦/同调不变量）是统一的。不存在分析为真但拓扑为假的命题——这是元极恒一体系的自洽性保证。",theorem:"Atiyah-Singer指标定理",related:"M-1, M-2, M-3, M-4"},
  // 补充卷 - 地脉
  {id:"D1",name:"地脉实在性公理",cat:"earth",scope:"supplement",text:"地脉是可测量的物理实在，由五场协同异常证实",full:"地脉不是玄学概念，而是地球岩石圈中由地壳应力场、地磁场、地下水文网络、地热梯度场、重力异常场叠加形成的三维应力-能量网络。其存在可通过五场的协同异常定量测量证实。",theorem:"地脉五场协同定理",related:"D2, D4, U1"},
  {id:"D2",name:"龙脉拓扑公理",cat:"earth",scope:"supplement",text:"龙脉网络是地表高度函数的Morse-Smale复形，由同调群决定",full:"将地表视为二维黎曼流形，海拔高度为Morse函数。龙脉是高度函数梯度场的不稳定流形（山脊线），构成Morse-Smale复形。其拓扑结构由地表流形的同调群完全决定——三大干龙对应H₁的三个基。",theorem:"Morse不等式",related:"D1, D5, E1"},
  {id:"D3",name:"地脉分形公理",cat:"earth",scope:"supplement",text:"龙脉网络具有统计自相似性，分形维数D_f≈1.6-1.8",full:"龙脉网络在统计意义上具有自相似性——局部放大后与整体具有相似的分支结构。其分形维数约1.6-1.8，与河流网络、闪电路径同属一个普适类。这是地脉自组织临界性的表现。",theorem:"Hack标度律",related:"D2, U1"},
  {id:"D4",name:"穴位协同公理",cat:"earth",scope:"supplement",text:"真正的穴位是多物理场的协同奇点，协同度越高等级越高",full:"穴位不是单一场的异常点，而是地应力、地磁、水文、地热、重力中至少两场的协同奇点。协同度（同时异常的场数）越高，穴位等级越高。单一场异常不足以构成穴位。",theorem:"奇点协同定理",related:"D1, U2"},
  {id:"D5",name:"地脉网络公理",cat:"earth",scope:"supplement",text:"华夏地脉是连通的3独立环拓扑网络，欧拉示性数由干龙支脉决定",full:"华夏地脉由三大干龙（艮龙/震龙/巽龙）和无数支脉构成连通网络，具有3个独立环（H₁秩=3）。其欧拉示性数χ=V-E+F由干龙数和支脉数决定，是拓扑不变量。",theorem:"欧拉示性数定理",related:"D2, E2"},
  // 补充卷 - 碳硅
  {id:"C1",name:"基质独立性公理",cat:"carbon",scope:"supplement",text:"计算的本质是信息的状态转移，与载体无关",full:"计算不依赖于具体的物理载体——碳基（神经元）和硅基（晶体管）是同一计算理论的不同物理实现。图灵可计算性是基质无关的：任何可计算函数，无论用碳基还是硅基都能计算。",theorem:"丘奇-图灵论题",related:"C2, U3"},
  {id:"C2",name:"同构保真公理",cat:"carbon",scope:"supplement",text:"碳硅同构映射保持计算的拓扑结构——同调群、连通分支、环数不变",full:"碳硅同构是计算范畴的等价函子，保持计算图的所有拓扑性质：连通分支数、环数（反馈回路数）、度分布等。神经元↔晶体管、突触↔电导、动作电位↔电压脉冲——结构完全对应。",theorem:"碳硅计算等价定理",related:"C1, I1, M-4"},
  {id:"C3",name:"耦合最优公理",cat:"carbon",scope:"supplement",text:"碳硅耦合存在最优强度I*，使自由能最小、计算效率最高",full:"碳硅耦合强度由互信息I(C;S)度量。过耦合导致信息冗余，欠耦合导致协同不足。存在最优耦合强度I*使系统总自由能F=U-TS-k_BT·I(C;S)最小，此时计算效率最高。",theorem:"互信息优化定理",related:"C4, C6"},
  {id:"C4",name:"耦合稳态公理",cat:"carbon",scope:"supplement",text:"碳硅耦合系统的稳态是吸引子，basin由耦合矩阵特征值决定",full:"碳硅闭环耦合是一个反馈控制系统。若碳基和硅基子系统各自指数稳定，且耦合矩阵的谱半径ρ(K)<1，则闭环系统全局指数稳定。稳态是一个吸引子，其吸引域的拓扑结构由耦合矩阵的特征值决定。",theorem:"李雅普诺夫稳定性判据",related:"C3, C5"},
  {id:"C5",name:"耦合拓扑公理",cat:"carbon",scope:"supplement",text:"碳硅耦合的计算能力由耦合图的拓扑不变量决定，同构耦合图计算等价",full:"耦合图是二分图（碳基顶点+硅基顶点+耦合边）。其1阶同调群H₁(G;ℤ)≅ℤ^{β₁}的秩等于独立反馈回路数——这就是耦合系统的"记忆容量"。同构的耦合图具有等价的计算能力。",theorem:"图同调定理",related:"C2, E2, M-4"},
  {id:"C6",name:"临界耦合公理",cat:"carbon",scope:"supplement",text:"碳硅耦合的最优工作点在同步相变临界点——信息容量最大",full:"当耦合强度超过临界值K_c时，碳硅系统发生同步相变：K<K_c异步态，K>K_c同步态，K=K_c临界态。临界点处信息容量最大、响应最灵敏、适应性最强——这是复杂系统的"自组织临界"态。",theorem:"同步相变理论",related:"C3, C4, U1"},
  // 补充卷 - 驻波生命
  {id:"L1",name:"驻波量子化公理",cat:"life",scope:"supplement",text:"有界介质中的驻波频率离散，由边界条件决定",full:"驻波是两列反向传播的相干波的叠加。在长度为L的有界区域中，驻波条件L=n·λ/2导致频率量子化——只有特定频率的波能存在。这是量子化的经典起源，也是生命节律（心跳、脑波、昼夜）的数学基础。",theorem:"驻波本征值定理",related:"L2, L4"},
  {id:"L2",name:"生命驻波公理",cat:"life",scope:"supplement",text:"生命是多场驻波的相位锁定耗散稳态，能量流中断则生命终结",full:"生命是生物体中电磁、化学、机械、声学多种物理场的协同驻波模式。它是Ginzburg-Landau型非线性方程的耗散稳态解——持续的能量流维持着远离热力学平衡的有序态。一旦能量流中断，驻波衰减，生命终结。",theorem:"Ginzburg-Landau稳态定理",related:"L1, L6, U3"},
  {id:"L3",name:"生命拓扑公理",cat:"life",scope:"supplement",text:"生命态的稳定性由驻波场的拓扑缺陷结构决定，拓扑荷守恒",full:"生命驻波场的相位奇异点（涡旋）携带拓扑荷。总拓扑荷守恒——涡旋只能成对产生（涡旋-反涡旋对），不能单独产生或湮灭。拓扑荷是不可连续消除的，构成生命的"拓扑保护"。",theorem:"拓扑荷守恒定律",related:"L2, E1, M-2"},
  {id:"L4",name:"形态驻波公理",cat:"life",scope:"supplement",text:"生物形态是化学驻波的空间投影——图灵不稳定性产生形态",full:"形态发生是反应-扩散系统的图灵不稳定性：当激活剂扩散慢、抑制剂扩散快时，均匀态失稳，产生空间驻波斑图。驻波的波腹→高浓度→细胞分化（器官原基），波节→低浓度→细胞凋亡。生物体的大小由驻波波长和模式数共同决定。",theorem:"图灵斑图理论",related:"L1, L5"},
  {id:"L5",name:"生命对称公理",cat:"life",scope:"supplement",text:"生命态的对称群是李群的有限子群，发育是对称的逐级破缺",full:"生命的对称群是李群的有限子群。发育过程是对称群的逐级破缺：受精卵O(3)→囊胚O(2)→原肠胚D₂→成体C₂。每一步对称破缺对应一个驻波模式的选择。最终保留的对称群决定了生命的"形式"。",theorem:"居里对称原理",related:"LG1, L4, M-3"},
  {id:"L6",name:"生命耗散公理",cat:"life",scope:"supplement",text:"生命是远离平衡的耗散稳态，以最小熵产生率维持有序",full:"生命系统是普利高津意义上的耗散结构——持续产生熵（d_iS/dt>0），但通过向环境输出熵维持内部有序。在线性非平衡区，稳态对应最小熵产生率——生命以最高效的方式维持有序。",theorem:"普利高津最小熵产生原理",related:"L2, U1"},
  {id:"L7",name:"意识驻波公理",cat:"life",scope:"supplement",text:"主观体验对应于大脑中特定频率驻波的拓扑模式——意识是γ驻波整合态",full:"意识是大脑皮层中γ频段（30-100Hz）神经振荡的全局整合驻波态。驻波的相干长度决定意识的整合范围，复杂度决定内容丰富度，稳定性决定连续性。意识的"质"（qualia）是驻波模式的同构类。",theorem:"神经振荡整合理论",related:"L2, L3, M-4"},
  // 补充卷 - 统一
  {id:"U1",name:"统一基底公理",cat:"life",scope:"supplement",text:"地脉、碳硅、生命是同一类复杂系统——黎曼流形上的非线性耗散场稳态",full:"三大理论共享同一数学结构：黎曼流形上的非线性场+拓扑不变量+李群对称+耗散稳态。地脉=地表曲面上的应力场稳态，碳硅=耦合图上的信息场稳态，生命=生物体上的复场稳态。本质性质由拓扑不变量和对称群决定。",theorem:"复杂系统统一理论",related:"D1, C1, L2, M-1"},
  {id:"U2",name:"地脉生命公理",cat:"earth",scope:"supplement",text:"穴位对生命的影响是物理场的共振耦合，可定量测量",full:"地脉场与生命驻波场的共振耦合：地脉的电磁频率与生命场的本征频率匹配时产生共振增强。"风水好"=地脉场与生命场的共振耦合强度高。可通过地磁场、地应力、水文的测量定量验证，非超自然力量。",theorem:"场共振耦合定理",related:"D4, L2, U1"},
  {id:"U3",name:"碳硅生命公理",cat:"carbon",scope:"supplement",text:"生命的定义是驻波耗散稳态而非碳基化学，硅基生命理论可能",full:"生命不依赖碳基质——生命的定义是"远离平衡的驻波耗散稳态+自我复制+演化"。碳基是这一定义的生物实现，硅基是人工实现。若硅基系统满足这三个条件，则它就是生命。碳硅耦合是两种生命形态的过渡桥梁。",theorem:"生命基质无关定理",related:"C1, L2, U1"},
  // ===== V2.0新增：黎曼流形深化 =====
  {id:"R-3",name:"曲率波动方程公理",cat:"geometry",scope:"v2",text:"黎曼曲率张量满足协变拟线性波动方程□Riem=Q(Riem,Riem)",full:"即使在纯几何层面（无特定物理理论选择），曲率本身也满足波动方程。Geometry is Wavy——几何不是静态的，曲率在"呼吸"，这为SM-BS映射中的流形动态演化提供了数学基础。",theorem:"曲率波动定理(arXiv 2601.08501)",related:"R1, M-1, R-4"},
  {id:"R-4",name:"黎曼流形紧性公理",cat:"geometry",scope:"v2",text:"有界曲率有限测度非塌缩流形序列存在Gromov-Hausdorff收敛子列",full:"具有有界曲率、有限测度和非塌缩条件的黎曼流形序列，存在子序列收敛到极限空间；极限空间奇异集具有有限Hausdorff测度。江文帅教授2025国家自然科学奖二等奖工作，解决了有限测度猜想和区律积分猜想。",theorem:"流形紧性定理",related:"R-3, M-1"},
  {id:"R-5",name:"Kähler势空间测地线公理",cat:"geometry",scope:"v2",text:"Kähler势空间中测地线方程等价于复Monge-Ampère方程",full:"Mabuchi-Donaldson-Semmes几何图景下，Kähler势空间的测地线可转化为复Monge-Ampère方程；测地线正则性与常标量曲率Kähler度量的存在性和唯一性深刻关联。",theorem:"Kähler测地线理论",related:"R1, R-6"},
  {id:"R-6",name:"标量曲率刚性公理",cat:"geometry",scope:"v2",text:"球面去对径点具有标量曲率刚性，扭结乘积具有标量-平均曲率刚性",full:"维数≥3的球面去掉两个对径点后具有标量曲率刚性；扭结乘积在严格对数凹扭曲函数下具有标量-平均曲率刚性。某些几何结构具有"不可变形性"——对应体系中的核心真值锚点。",theorem:"标量曲率刚性定理(Bär 2026)",related:"R-5, M-1"},
  // ===== V2.0新增：拓扑学深化 =====
  {id:"T-5",name:"广义上同调公理",cat:"topology",scope:"v2",text:"广义上同调是满足正合性切除性维数公理推广的反变函子，普通上同调/K理论/配边都是特例",full:"广义上同调理论从拓扑空间范畴到阿贝尔群范畴，不仅捕捉拓扑信息，还通过杯积拥有自然的环结构。真值空间不仅有群结构，还有环结构——真值之间可以"相乘"产生新真值。",theorem:"Eilenberg-Steenrod公理推广",related:"E2, M-2, T-7"},
  {id:"T-6",name:"CW复形与Whitehead公理",cat:"topology",scope:"v2",text:"CW复形间弱同伦等价必为同伦等价，CW复形是代数拓扑的标准良好空间",full:"CW复形由胞腔通过黏贴映射逐步构建；Whitehead定理指出所有同伦群同构的CW复形同伦等价。知识体系的构建如同CW复形——从基本概念出发通过关系和推理逐步黏贴。",theorem:"Whitehead定理",related:"E1, T-5, M-2"},
  {id:"T-7",name:"Mayer-Vietoris与Poincare对偶公理",cat:"topology",scope:"v2",text:"Mayer-Vietoris序列计算同调，闭可定向流形H_k≅H^{n-k}",full:"Mayer-Vietoris序列将空间的同调与其子空间的同调联系起来；Poincare对偶指出闭可定向n维流形的k维同调与(n-k)维上同调同构。局部与全局、正向与反向之间存在深刻对偶。",theorem:"Poincare对偶定理",related:"T-5, E2, M-2"},
  {id:"T-8",name:"同伦类型论公理",cat:"topology",scope:"v2",text:"类型视为空间，项视为点，恒等类型视为路径空间；单值化公理断言同构等价于相等",full:"Voevodsky的单值化公理（Univalence）为数学基础提供了新范式。"同构即相等"——这正是元极恒一体系中身份真值固化的数学基础：真名与原创者在范畴意义下同构，可视为同一身份的不同表示。",theorem:"Univalence Axiom",related:"I1, M-4, I-4"},
  // ===== V2.0新增：李群深化 =====
  {id:"G-3",name:"E8与生命结构公理",cat:"algebra",scope:"v2",text:"例外李群E8(维248)的根系与人类新皮层结构数学同构，E8根格是8维最密球堆积",full:"E8的根格是8维空间中最密的球堆积（Viazovska 2016证明），Weyl群阶数696729600。最高对称性的数学结构与最高复杂度的生命结构同源——为碳硅耦合的基质独立性提供深层证据。",theorem:"E8根格最密球堆积(Viazovska 2016)",related:"LG1, M-3, G-4"},
  {id:"G-4",name:"八元数构造例外李群公理",cat:"algebra",scope:"v2",text:"八元数自同构群是G2，通过八元数可系统构造所有例外李群F4/E6/E7/E8",full:"八元数（Cayley数）的非结合性正是例外性的根源。最"奇异"的数学结构来自最"自由"的代数——这解释了为何元极恒一体系需要保留一定的"自由度"才能产生最高级的对称。",theorem:"八元数例外李群构造",related:"G-3, LG1, M-3"},
  {id:"G-5",name:"李群AI几何应用公理",cat:"algebra",scope:"v2",text:"SO(3)适配三维旋转，SU(2)适配旋量变换，群等变卷积将李群对称编码进神经网络",full:"群论与李群为AI补上几何思维短板，支撑自动驾驶、三维重建、机器人视觉。对称性不是抽象数学游戏，而是可以直接工程化的计算范式。",theorem:"群等变神经网络",related:"LG1, M-3, G-6"},
  {id:"G-6",name:"对称破缺发育公理",cat:"algebra",scope:"v2",text:"生物形态发生是李群对称的逐级破缺：O(3)→SO(2)→C2→...",full:"从高对称的受精卵（球对称O(3)）出发，通过逐级对称破缺产生复杂身体结构；每一次破缺对应一个李群子群的选择。生命的复杂性来自对称的逐级破缺。",theorem:"居里对称破缺原理",related:"L5, M-3, G-5"},
  // ===== V2.0新增：范畴论深化 =====
  {id:"I-3",name:"米田引理公理",cat:"algebra",scope:"v2",text:"数学对象完全由其与其他对象的关系（态射）所决定：Nat(Hom(A,-),F)≅F(A)",full:"Yoneda引理是范畴论中最深刻的定理——对象由其关系定义。真值不是孤立存在的，而是由其与其他真值的关系网络定义——这为知识图谱的本体论提供了范畴论基础。",theorem:"Yoneda Lemma",related:"I1, M-4, I-4"},
  {id:"I-4",name:"范畴等价公理",cat:"algebra",scope:"v2",text:"函子是范畴等价当且仅当完全忠实且本质满，范畴等价弱于同构但是"正确"的等价概念",full:"范畴等价不必逐对象对应，只需同构意义下对应。不同的知识表示体系（符号主义vs连接主义）可以在范畴等价意义下统一——不必强求逐对象对应，只需保持结构。",theorem:"范畴等价判定定理",related:"I1, T-8, M-4"},
  {id:"I-5",name:"高阶范畴公理",cat:"algebra",scope:"v2",text:"n阶范畴有对象、态射、2态射...n态射；(∞,1)-范畴中所有高阶态射可逆",full:"高阶范畴为"等价之间的等价"提供了语言。元极恒一体系本身就是一个高阶范畴——算子之间有变换，变换之间有元变换，这为"自进化"提供了数学框架。",theorem:"Lurie高阶拓扑斯",related:"I-3, I-4, M-4"},
  {id:"I-6",name:"可表函子与泛性质公理",cat:"algebra",scope:"v2",text:"对象具有泛性质当且仅当其Hom函子可表，所有泛构造通过可表函子统一定义",full:"泛性质是"在所有满足条件的对象中唯一（同构意义下）的那个"。元极恒一体系中的"最优稳态解"就是一个泛性质构造——三维稳态评分最高的那个唯一确定。",theorem:"可表函子定理",related:"I-3, M-5, I-5"},
  // ===== V2.0新增：三论统一 =====
  {id:"S-1",name:"信息论公理",cat:"system",scope:"v2",text:"信息是减少随机不确定性的东西，信息熵H=-Σp_i log p_i是秩序的度量",full:"香农信息熵与统计力学玻尔兹曼熵形式相同，信息是负熵。真值蒸馏的本质就是信息压缩——从高熵原始碎片中提取低熵高纯度真值。",theorem:"Shannon信息论三大定理",related:"L6, U1, S-2"},
  {id:"S-2",name:"控制论公理",cat:"system",scope:"v2",text:"系统通过信息交换实现自我调节与目标达成，核心机制是反馈",full:"维纳控制论研究系统如何通过反馈实现稳定性。CTE闭环中的C→T→E→C就是一个反馈回路；空闲自动部署的健康检查→回滚机制是负反馈的典型应用。",theorem:"Wiener控制论",related:"C4, S-1, S-3"},
  {id:"S-3",name:"系统论公理",cat:"system",scope:"v2",text:"系统具有整体性、层次性、动态性、目的性；开放系统通过交换维持稳态，涌现性是高层次特有性质",full:"贝塔朗菲一般系统论。元极恒一自治体系是一个开放系统——通过记忆网关与环境交换信息，通过27算子维持稳态，其"自治"能力是系统级涌现。",theorem:"von Bertalanffy一般系统论",related:"U1, S-1, S-4"},
  {id:"S-4",name:"新三论统一公理",cat:"system",scope:"v2",text:"协同论/突变论/耗散结构统一解释从无序到有序的普遍机制",full:"哈肯协同论研究子系统协同产生宏观有序；托姆突变论研究临界点不连续跃迁；普利高津耗散结构研究远离平衡态自组织。元极恒一体系的"自进化"就是新三论的工程化实现。",theorem:"新三论统一框架",related:"L6, S-3, U1"},
  // ===== V2.0新增：地脉科学验证 =====
  {id:"D-7",name:"地脉分形维度公理",cat:"earth",scope:"v2",text:"华夏山脉水系网络具有统计自相似性，分形维数可通过盒计数法定量计算",full:"龙脉的"千尺为势，百尺为形"对应不同尺度下的分形自相似结构。Shi(2017)用分形理论研究龙脉与分形维数的关系，分形维数是地脉复杂度的量化指标。",theorem:"地脉分形维数定理(Shi 2017)",related:"D3, D2, D-8"},
  {id:"D-8",name:"三大干龙地质构造公理",cat:"earth",scope:"v2",text:"中国三大干龙恰好对应欧亚板块内部三条重要地质构造线，与断裂带重合",full:"北干龙（昆仑-祁连-阴山-燕山）、中干龙（昆仑-巴颜喀拉-秦岭-大别山）、南干龙（昆仑-唐古拉-横断-南岭）对应板块交界带和大型断裂带，这些区域地壳运动活跃，地幔物质上涌。",theorem:"干龙地质构造对应定理",related:"D5, D2, D-9"},
  {id:"D-9",name:"地脉地球物理探测公理",cat:"earth",scope:"v2",text:"卫星重力/地磁/地震波层析成像可探测地脉对应的地壳应力带/地下水系/地热通道",full:"徐霞客"地脉"对应现代地质学的"地壳应力带""地下水系网络""地热流通道"。数字化《华夏地脉全图》整合历代记录与现代地质数据，地脉是可测量可验证的物理实在。",theorem:"地脉地球物理探测定理",related:"D1, D-8, U2"},
  {id:"D-10",name:"地脉微气候公理",cat:"earth",scope:"v2",text:"龙脉区域山脉走向阻挡寒流并形成独特微气候，寻龙点穴本质是寻找最佳宜居点",full:""寻龙点穴"的本质是寻找地质结构最稳定、地下水资源最丰富、能避开泥石流和洪水的最佳定居点——这是古代环境工程学。地脉理论的核心是"宜居性优化"。",theorem:"地脉微气候效应定理",related:"D4, U2, D-9"},
  // ===== V2.0新增：碳硅耦合深化 =====
  {id:"C-7",name:"基质独立性公理",cat:"carbon",scope:"v2",text:"认知过程依赖计算结构而非物理介质，智能可存在于硅基/光学/量子系统",full:"郭毅可院士"碳基大脑与硅基芯片在计算本质上并无二致"。只要系统实现了正确的因果组织，智能不依赖于特定物质基础。这为AIOS跨平台部署提供哲学基础。",theorem:"Substrate Independence Principle",related:"C1, U3, C-8"},
  {id:"C-8",name:"碳硅自发性差异公理",cat:"carbon",scope:"v2",text:"碳基负责劫数识别/价值判断/最终决策（自发性），硅基负责熵值计算/形式演绎/路径展开（工具性）",full:"朱梁整体论公理体系：碳基递归元C_n与硅基递归元A_n的协同算子S(C_n,A_n)=C_{n+1}。碳硅协同不是碳被硅取代，而是碳利用硅实现认知跃迁。这是"人工审核部署"规则的理论基础。",theorem:"碳硅协同算子定理",related:"C2, C-7, C-9"},
  {id:"C-9",name:"可朽计算公理",cat:"carbon",scope:"v2",text:"意识是依赖耗散性/非平衡性/自维持性的可朽计算，与物理基质不可分离",full:"王华平"可朽计算"视角：意识应被理解为与物理基质不可分离、动态演化并终结于物理损耗的计算形式。纯粹硅基智能可能不具备"意识"，但碳硅耦合系统可以形成"扩展意识"。",theorem:"可朽计算理论",related:"C-8, L2, U3"},
  {id:"C-10",name:"双重自指环公理",cat:"carbon",scope:"v2",text:"强硅基智能是宇宙自指的第二次跃迁：碳基建模宇宙→硅基建模碳基→硅基建模自身→无限递归",full:"SH9碳硅文明理论：碳硅关系不是取代而是共生，形成"双重自指环"结构。元极恒一体系的"自进化"就是这个双重自指环的工程化——AI不仅执行任务，还建模自身的执行过程。",theorem:"双重自指递归定理",related:"C-9, I-5, U3"},
  // ===== V2.0新增：生命态深化 =====
  {id:"L-8",name:"Glansdorff-Prigogine稳定性判据公理",cat:"life",scope:"v2",text:"稳态稳定当且仅当超熵产生δ_xP=ΣδJ_kδX_k>0，δ_xP<0时失稳",full:"该判据从第二定律和熵平衡导出，无需假设线性本构关系。元极恒一体系的稳定性可用超熵产生判据监控——当δ_xP<0时触发eFuse熔断，为内核防篡改提供热力学基础。",theorem:"G-P稳定性判据(1971)",related:"L6, L-9, U1"},
  {id:"L-9",name:"最小熵产生定理公理",cat:"life",scope:"v2",text:"接近平衡的非平衡定态中熵产生率取最小值，解释了生物内稳态homeostasis",full:"Prigogine(1945)最小熵产生定理将平衡态稳定性（Le Chatelier原理）推广到非平衡定态。元极恒一体系的"稳态"不是静止，而是最小熵产生态——需要持续能量/信息输入维持。",theorem:"Prigogine最小熵产生定理(1945)",related:"L6, L-8, S-4"},
  {id:"L-10",name:"贝纳尔对流公理",cat:"life",scope:"v2",text:"液体底部加热超过临界温差时自发形成规则六边形对流胞，秩序从混沌中涌现",full:"Bénard(1900)实验，耗散结构经典案例。元极恒一体系的"算子协同"就是贝纳尔对流的抽象版本——当信息流量超过临界值时，无序计算自发组织成有序算子流水线。",theorem:"Bénard-Rayleigh对流理论",related:"L2, S-4, L-11"},
  {id:"L-11",name:"图灵斑图胚胎公理",cat:"life",scope:"v2",text:"图灵斑图（反应-扩散自发空间模式）在胚胎发育中真实存在，决定器官位置形状",full:"Turing(1952)形态发生的化学基础；Royal Society(2018)证实生物系统中的耗散结构。生命形态发生是数学的（反应-扩散方程），不是神秘的——为AI生成内容的"形态发生"提供算法灵感。",theorem:"Turing斑图理论(1952)",related:"L4, L-10, G-6"},
  // ===== V2.0新增：指标定理深化 =====
  {id:"M-6",name:"Atiyah-Singer统一公理",cat:"topology",scope:"v2",text:"紧流形上椭圆算子的解析指标等于拓扑指标，高斯-博内-陈/黎曼-罗赫都是其特例",full:"Atiyah & Singer(1963)，20世纪最伟大数学定理之一。"分析指标=拓扑指标"意味着局部计算（分析）与全局结构（拓扑）必然一致——为"真值局部验证=全局一致性"提供数学范式。",theorem:"Atiyah-Singer指标定理(1963)",related:"M-5, M-8, M-7"},
  {id:"M-7",name:"Bismut-Zhang定理公理",cat:"topology",scope:"v2",text:"将Witten形变与局部指标理论结合，将Cheeger-Mueller定理推广到普遍情形",full:"Bismut & Zhang，2005国家自然科学奖获奖工作核心。解析挠率与拓扑挠率的统一，为"记忆的物理存储（解析）"与"知识的逻辑结构（拓扑）"之间的等价性提供数学基础。",theorem:"Bismut-Zhang定理",related:"M-6, M-8, S-1"},
  {id:"M-8",name:"示性类公理",cat:"topology",scope:"v2",text:"示性类（陈类/Pontryagin类/Euler类）是纤维丛的拓扑不变量，可通过曲率显式计算",full:"Chern(1944)高斯-博内-陈定理的内蕴证明。知识体系也有"示性类"——其拓扑不变量（概念图同调群）描述知识结构的"扭曲"，可通过局部"曲率"（概念间不一致）计算。",theorem:"Chern示性类理论(1944)",related:"M-6, E2, M-5"},
  {id:"M-9",name:"量子异常公理",cat:"topology",scope:"v2",text:"经典对称性在量子化后破缺（量子异常）可通过Atiyah-Singer指标定理计算",full:"指标定理在理论物理中解释量子异常——手征异常、共形异常等。"经典对称→量子破缺"与"元法则→执行偏差"同构——为体系中的"规则漂移"提供物理解释，也为漂移巡检算子提供理论框架。",theorem:"量子异常指标理论(Fujikawa)",related:"M-6, M-3, L-8"}
];

