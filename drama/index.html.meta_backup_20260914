<style>
:root{
  --bg:#0a0a0f;--bg2:#111118;--bg3:#18181f;--card:#15151e;
  --gold:#d4af37;--gold2:#f0d060;--gold-dim:#8a7030;--gold-line:rgba(212,175,55,.25);
  --text:#e8e6df;--text2:#a0a0a8;--text3:#6a6a72;
  --border:#2a2a35;--glow:rgba(212,175,55,.12);
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--text);font-family:'Noto Sans SC',system-ui,sans-serif;line-height:1.7;overflow-x:hidden}
body::before{content:'';position:fixed;inset:0;background:
  radial-gradient(ellipse 80% 50% at 50% -10%,rgba(212,175,55,.1),transparent),
  radial-gradient(ellipse 60% 40% at 80% 100%,rgba(201,162,39,.06),transparent);
  pointer-events:none;z-index:0}
.serif{font-family:'Noto Serif SC',serif}
.mono{font-family:'JetBrains Mono',monospace}

/* 导航 */
.nav{position:fixed;top:0;left:0;right:0;z-index:100;background:rgba(10,10,15,.85);backdrop-filter:blur(12px);border-bottom:1px solid var(--gold-line)}
.nav-inner{max-width:1400px;margin:0 auto;padding:0 24px;height:64px;display:flex;align-items:center;justify-content:space-between}
.nav-brand{display:flex;align-items:center;gap:14px;text-decoration:none}
.nav-logo{width:36px;height:36px;border:1.5px solid var(--gold);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:16px;color:var(--gold);font-weight:700}
.nav-title{font-family:'Noto Serif SC',serif;font-size:17px;font-weight:700;color:var(--gold);letter-spacing:2px}
.nav-sub{font-size:10px;color:var(--text3);letter-spacing:1px;margin-top:2px}
.nav-links{display:flex;gap:6px;align-items:center}
.nav-link{padding:8px 16px;font-size:13px;color:var(--text2);cursor:pointer;border-radius:4px;transition:all .2s;border:none;background:none;font-family:inherit;text-decoration:none}
.nav-link:hover{color:var(--gold);background:rgba(212,175,55,.08)}
.nav-link.cta{background:linear-gradient(135deg,var(--gold),var(--gold-dim));color:#0a0a0f;font-weight:600}
.nav-link.cta:hover{opacity:.9}
/* 移动端汉堡菜单 */
.nav-toggle{display:none;background:none;border:none;cursor:pointer;padding:8px;flex-direction:column;gap:5px}
.nav-toggle span{display:block;width:22px;height:2px;background:var(--gold);transition:all .3s;border-radius:1px}
.nav-toggle.active span:nth-child(1){transform:translateY(7px) rotate(45deg)}
.nav-toggle.active span:nth-child(2){opacity:0}
.nav-toggle.active span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
.mobile-menu{display:none;position:fixed;top:64px;left:0;right:0;background:rgba(10,10,15,.97);backdrop-filter:blur(12px);border-bottom:1px solid var(--gold-line);padding:16px 24px;z-index:99;flex-direction:column;gap:4px}
.mobile-menu.show{display:flex}
.mobile-menu a{padding:14px 16px;font-size:15px;color:var(--text2);text-decoration:none;border-radius:6px;transition:all .2s;border-bottom:1px solid var(--border)}
.mobile-menu a:hover{color:var(--gold);background:rgba(212,175,55,.08)}
.mobile-menu a.cta{background:linear-gradient(135deg,var(--gold),var(--gold-dim));color:#0a0a0f;font-weight:600;text-align:center;margin-top:8px;border:none}
@media(max-width:768px){
  .nav-links{display:none}
  .nav-toggle{display:flex}
  .nav-inner{padding:0 16px}
  .nav-title{font-size:15px}
  .nav-sub{font-size:9px}
}

/* 主容器 */
.main{position:relative;z-index:1}

/* Hero */
.hero{min-height:100vh;display:flex;align-items:center;justify-content:center;text-align:center;padding:100px 24px 60px;position:relative}
.hero-omega{font-size:56px;color:var(--gold);letter-spacing:10px;margin-bottom:20px;opacity:.9}
.hero h1{font-family:'Noto Serif SC',serif;font-size:clamp(32px,6vw,64px);font-weight:900;background:linear-gradient(135deg,var(--gold2),var(--gold),var(--gold-dim));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin-bottom:16px;letter-spacing:6px}
.hero-sub{font-size:clamp(14px,2vw,18px);color:var(--text2);letter-spacing:8px;margin-bottom:12px}
.hero-desc{font-size:14px;color:var(--text3);max-width:600px;margin:0 auto 32px;line-height:1.8}
.hero-divider{width:160px;height:1px;background:linear-gradient(90deg,transparent,var(--gold),transparent);margin:28px auto}
.hero-buttons{display:flex;gap:16px;justify-content:center;flex-wrap:wrap}
.btn{padding:14px 32px;border-radius:6px;font-size:14px;font-weight:600;cursor:pointer;transition:all .25s;text-decoration:none;display:inline-block;border:none;font-family:inherit;letter-spacing:1px}
.btn-primary{background:linear-gradient(135deg,var(--gold),var(--gold-dim));color:#0a0a0f}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 8px 32px var(--glow)}
.btn-outline{border:1px solid var(--gold-dim);color:var(--gold);background:transparent}
.btn-outline:hover{background:rgba(212,175,55,.08)}
.hero-stats{display:flex;gap:48px;justify-content:center;margin-top:60px;flex-wrap:wrap}
.hero-stat .num{font-family:'JetBrains Mono',monospace;font-size:32px;font-weight:700;color:var(--gold)}
.hero-stat .label{font-size:12px;color:var(--text3);letter-spacing:1px;margin-top:4px}

/* 通用section */
.section{max-width:1400px;margin:0 auto;padding:80px 24px}
.section-header{text-align:center;margin-bottom:48px}
.section-tag{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--gold-dim);letter-spacing:3px;margin-bottom:12px}
.section-title{font-family:'Noto Serif SC',serif;font-size:clamp(24px,4vw,36px);font-weight:700;color:var(--text);letter-spacing:3px;margin-bottom:12px}
.section-desc{font-size:14px;color:var(--text2);max-width:600px;margin:0 auto}

/* 模块卡片 */
.modules-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px}
.module-card{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:28px;cursor:pointer;transition:all .3s;position:relative;overflow:hidden;text-decoration:none;display:block}
.module-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:0;transition:opacity .3s}
.module-card:hover{border-color:var(--gold-dim);transform:translateY(-4px);box-shadow:0 12px 40px var(--glow)}
.module-card:hover::before{opacity:1}
.module-icon{width:48px;height:48px;border-radius:10px;background:rgba(212,175,55,.1);border:1px solid var(--gold-line);display:flex;align-items:center;justify-content:center;font-size:22px;margin-bottom:16px}
.module-name{font-family:'Noto Serif SC',serif;font-size:18px;font-weight:700;color:var(--gold);margin-bottom:8px}
.module-desc{font-size:13px;color:var(--text2);line-height:1.7;margin-bottom:16px}
.module-meta{display:flex;gap:12px;font-size:11px;color:var(--text3);font-family:'JetBrains Mono',monospace}
.module-meta span{padding:3px 8px;background:var(--bg3);border-radius:3px}

/* 架构图 */
.arch-container{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:40px;margin:20px 0}
.arch-layer{display:flex;align-items:center;gap:16px;margin-bottom:16px}
.arch-layer:last-child{margin-bottom:0}
.arch-label{width:100px;font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--gold-dim);text-align:right;flex-shrink:0}
.arch-nodes{flex:1;display:flex;gap:10px;flex-wrap:wrap}
.arch-node{background:var(--bg3);border:1px solid var(--border);border-radius:6px;padding:10px 16px;font-size:12px;color:var(--text2);text-align:center;flex:1;min-width:100px;transition:all .2s}
.arch-node:hover{border-color:var(--gold-dim);color:var(--gold)}
.arch-node.core{border-color:var(--gold-dim);background:rgba(212,175,55,.06);color:var(--gold)}
.arch-connector{text-align:center;color:var(--gold-dim);font-size:14px;margin:4px 0 4px 100px}

/* 移动端全局适配 */
@media(max-width:768px){
  body{font-size:15px;line-height:1.8}
  .section{padding:48px 16px}
  .section-title{font-size:20px}
  .hero{min-height:auto;padding:80px 16px 40px}
  .hero-omega{font-size:36px;letter-spacing:6px}
  .hero h1{letter-spacing:3px}
  .hero-sub{letter-spacing:4px;font-size:13px}
  .hero-desc{font-size:13px}
  .hero-stats{gap:24px}
  .hero-stat .num{font-size:24px}
  .hero-buttons{flex-direction:column;align-items:center}
  .btn{width:100%;max-width:280px;text-align:center}
  .stats-grid{grid-template-columns:repeat(2,1fr);gap:12px}
  .stat-card{padding:16px}
  .stat-num{font-size:28px}
  .modules-grid{grid-template-columns:1fr;gap:12px}
  .module-card{padding:20px}
  /* 架构图移动端：标签在上，节点在下 */
  .arch-container{padding:20px 16px}
  .arch-layer{flex-direction:column;align-items:stretch;gap:8px}
  .arch-label{width:auto;text-align:left;font-size:12px;padding:6px 10px;background:rgba(212,175,55,.08);border-radius:4px;border-left:3px solid var(--gold)}
  .arch-nodes{flex-direction:column;gap:6px}
  .arch-node{min-width:auto;font-size:13px;padding:10px 12px}
  .arch-connector{margin:4px 0}
  .axiom-preview{padding:20px 16px}
  .axiom-mini-grid{grid-template-columns:repeat(2,1fr);gap:8px}
  .footer-grid{grid-template-columns:repeat(2,1fr);gap:20px}
  .footer{padding:32px 16px 24px}
  .trace-mark{font-size:8px;bottom:8px;right:8px}
}

/* 公理预览 */
.axiom-preview{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:40px;margin:20px 0}
.axiom-preview-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;flex-wrap:wrap;gap:12px}
.axiom-preview-title{font-family:'Noto Serif SC',serif;font-size:20px;font-weight:700;color:var(--gold)}
.axiom-mini-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:10px}
.axiom-mini{background:var(--bg3);border:1px solid var(--border);border-radius:6px;padding:12px;transition:all .2s}
.axiom-mini:hover{border-color:var(--gold-dim)}
.axiom-mini .id{font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--gold-dim)}
.axiom-mini .name{font-size:12px;color:var(--text);margin-top:4px;font-weight:500}

/* Footer */
.footer{border-top:1px solid var(--border);padding:48px 24px 32px;margin-top:60px}
.footer-inner{max-width:1400px;margin:0 auto}
.footer-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:32px;margin-bottom:32px}
.footer-col h4{font-family:'Noto Serif SC',serif;font-size:14px;color:var(--gold);margin-bottom:16px;letter-spacing:1px}
.footer-col a{display:block;font-size:12px;color:var(--text3);text-decoration:none;margin-bottom:8px;transition:color .2s}
.footer-col a:hover{color:var(--gold)}
.footer-bottom{text-align:center;padding-top:24px;border-top:1px solid var(--border)}
.footer-omega{font-size:18px;color:var(--gold-dim);letter-spacing:4px;margin-bottom:8px}
.footer-text{font-size:11px;color:var(--text3);letter-spacing:2px}
.footer-did{font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--text3);margin-top:6px}

/* 浮动溯源标识 */
.trace-mark{position:fixed;bottom:16px;right:16px;z-index:99;font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--gold-dim);opacity:.6;letter-spacing:1px;pointer-events:none}
</style>
